using Standard;

namespace Refusal;

public class Globals
{
    public static int Counter;
}

public class Box
{
    public int N;
}

public class Wrapped
{
    public int V;

    public static explicit operator Wrapped(Box b)
    {
        Globals.Counter = Globals.Counter + 1;
        var w = new Wrapped();
        w.V = b.N;
        return w;
    }
}

public class Probe
{
    public static readonly int M(Box b)
    {
        // REFUSE: MIST_PA_READONLY_CONTEXT_CALLS_MUTABLE
        var w = (Wrapped)b;
        return w.V;
    }

    public static void Main()
    {
        var b = new Box();
        Console.WriteLine(M(b));
        Console.WriteLine("unreachable");
    }
}
