using Standard;

namespace Refusal;

public class Log
{
    public static int Opened;
}

public class Seq : IEnumerable<int>
{
    public struct Enumerator : IEnumerator<int>
    {
        private int current;
        public Enumerator(int start) { current = start; }
        public bool MoveNext() { current = current + 1; return current < 2; }
        public int Current => current;
    }

    public Enumerator GetEnumerator()
    {
        Log.Opened = Log.Opened + 1;
        return new Enumerator(-1);
    }
}

public class Summer
{
    public readonly int Sum()
    {
        var s = new Seq();
        var t = 0;
        // REFUSE: MIST_PA_READONLY_CONTEXT_CALLS_MUTABLE
        foreach (var x in s)
        {
            t = t + x;
        }
        return t;
    }
}

public class Probe
{
    public static void Main()
    {
        var summer = new Summer();
        var r = summer.Sum();
        Console.WriteLine("unreachable");
    }
}
