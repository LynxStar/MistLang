using Standard;

// ReadOnlySpan<T> provides read-only access to stack memory.
// Target-typing into ReadOnlySpan makes the span immutable.
ReadOnlySpan<int> ro = stackalloc int[3];
Console.WriteLine($"ro.Length={ro.Length}");
Console.WriteLine($"ro[0]={ro[0]}");

// A stampable struct can be used as the element type.
// Only value types whose fields are all primitive are stampable.
Span<Point> points = stackalloc Point[2];
points[0] = new Point(1, 2);
points[1] = new Point(3, 4);
Console.WriteLine($"points[0].x={points[0].x}");
Console.WriteLine($"points[1].y={points[1].y}");

public struct Point
{
    public int x;
    public int y;

    public Point(int a, int b)
    {
        this.x = a;
        this.y = b;
    }
}

