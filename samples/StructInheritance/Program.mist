// StructInheritance — Demonstrates struct inheritance (value-type composition).
//
// This sample exercises:
//   1. Single-level inheritance (Point3D : Point) — field flattening
//   2. Multi-level inheritance (ColorPoint3D : Point3D : Point) — all ancestor fields
//   3. Base constructor chaining (: base(x, y)) through every level
//   4. Derived-to-base implicit conversion (assignment, parameter passing, return)
//   5. Field access on derived instances (inherited + own)
//   6. Method access on each struct level (inherited + own)
//   7. Generic struct inheritance (ExtendedContainer<T> : Container<T>)

using Standard;

namespace StructInheritance;

// --- Base struct: 2D point ---
public struct Point {
    public int X;
    public int Y;

    public Point(int x, int y)
    {
        X = x;
        Y = y;
    }

    public string Describe()
    {
        return $"Point({X}, {Y})";
    }
}

// --- Single-level inheritance: 3D point extends 2D point ---
public struct Point3D : Point {
    public int Z;

    public Point3D(int x, int y, int z) : base(x, y)
    {
        Z = z;
    }

    public string Describe3D()
    {
        return $"Point3D({X}, {Y}, {Z})";
    }
}

// --- Multi-level inheritance: colored 3D point extends 3D point ---
// The constructor re-assigns X and Y after chaining to base(x, y, z). Those assignments
// are redundant — the chain already sets them through Point3D — and are kept because
// assigning a grandparent's field from a derived constructor is worth exercising.
public struct ColorPoint3D : Point3D {
    public int Color;

    public ColorPoint3D(int x, int y, int z, int color) : base(x, y, z)
    {
        X = x;
        Y = y;
        Color = color;
    }

    public string DescribeColored()
    {
        return $"ColorPoint3D({X}, {Y}, {Z}, color={Color})";
    }
}

// --- Generic struct inheritance ---
public struct Container<T> {
    public T Value;

    public Container(T value)
    {
        Value = value;
    }

    public string DescribeContainer()
    {
        return $"Container({Value})";
    }
}

public struct ExtendedContainer<T> : Container<T> {
    public int Extra;

    public ExtendedContainer(T value, int extra) : base(value)
    {
        Extra = extra;
    }

    public string DescribeExtended()
    {
        return $"ExtendedContainer(extra={Extra})";
    }
}

public class Program
{
    // --- Function accepting base type Point (proves derived-to-base conversion) ---
    private static string AcceptPoint(Point p)
    {
        return $"AcceptPoint received: ({p.X}, {p.Y})";
    }

    // --- Function accepting Point3D (proves multi-level derived-to-base) ---
    private static string AcceptPoint3D(Point3D p)
    {
        return $"AcceptPoint3D received: ({p.X}, {p.Y}, {p.Z})";
    }

    // --- Function returning base type from derived value ---
    private static Point MakePointFromDerived()
    {
        var p3d = new Point3D(100, 200, 300);
        return p3d;
    }

    public static void RunDemo()
    {
        Console.WriteLine("=== Struct Inheritance ===");

        // --- 1. Single-level inheritance: field access ---
        // Point3D inherits X, Y from Point and adds Z.
        // If struct inheritance were broken, X and Y would not exist on Point3D.
        Console.WriteLine("--- Single-level inheritance ---");
        var p3d = new Point3D(1, 2, 3);
        Console.WriteLine($"  p3d.X = {p3d.X}");
        Console.WriteLine($"  p3d.Y = {p3d.Y}");
        Console.WriteLine($"  p3d.Z = {p3d.Z}");
        Console.WriteLine($"  p3d.Describe3D() = {p3d.Describe3D()}");

        // Describe() is declared on Point, and reads X and Y off the derived value.
        Console.WriteLine($"  p3d.Describe() = {p3d.Describe()}");

        // --- 2. Multi-level inheritance: field access ---
        // ColorPoint3D inherits X, Y from Point (through Point3D), Z from Point3D, adds Color.
        Console.WriteLine("--- Multi-level inheritance ---");
        var cp = new ColorPoint3D(4, 5, 6, 255);
        Console.WriteLine($"  cp.X = {cp.X}");
        Console.WriteLine($"  cp.Y = {cp.Y}");
        Console.WriteLine($"  cp.Z = {cp.Z}");
        Console.WriteLine($"  cp.Color = {cp.Color}");
        Console.WriteLine($"  cp.DescribeColored() = {cp.DescribeColored()}");

        // Inherited two levels up and one level up respectively, and each reads fields it did
        // not declare, so a member reached through the wrong level prints the wrong number.
        Console.WriteLine($"  cp.Describe() = {cp.Describe()}");
        Console.WriteLine($"  cp.Describe3D() = {cp.Describe3D()}");

        // --- 3. Base constructor chaining ---
        // Point3D(x, y, z) : base(x, y) must run Point's initialization.
        // If base chaining were broken, X and Y would be 0.
        Console.WriteLine("--- Base constructor chaining ---");
        var chained = new Point3D(10, 20, 30);
        Console.WriteLine($"  chained.X = {chained.X}");
        Console.WriteLine($"  chained.Y = {chained.Y}");
        Console.WriteLine($"  chained.Z = {chained.Z}");

        // --- 4. Derived-to-base implicit conversion: assignment ---
        // Point3D is implicitly convertible to Point (copies X, Y fields).
        // If the implicit operator were missing, this would not compile.
        Console.WriteLine("--- Implicit conversion: assignment ---");
        Point basePoint = p3d;
        Console.WriteLine($"  basePoint.X = {basePoint.X}");
        Console.WriteLine($"  basePoint.Y = {basePoint.Y}");

        // --- 5. Derived-to-base implicit conversion: parameter passing ---
        // Passing Point3D where Point is expected uses the implicit operator.
        Console.WriteLine("--- Implicit conversion: parameter passing ---");
        Console.WriteLine($"  {AcceptPoint(p3d)}");

        // Multi-level: ColorPoint3D → Point (skips intermediate Point3D)
        Console.WriteLine($"  {AcceptPoint(cp)}");

        // Multi-level: ColorPoint3D → Point3D
        Console.WriteLine($"  {AcceptPoint3D(cp)}");

        // --- 6. Derived-to-base implicit conversion: return ---
        // A function returning Point can return a Point3D value.
        Console.WriteLine("--- Implicit conversion: return ---");
        Point returned = Program.MakePointFromDerived();
        Console.WriteLine($"  returned.X = {returned.X}");
        Console.WriteLine($"  returned.Y = {returned.Y}");

        // --- 7. Generic struct inheritance ---
        // ExtendedContainer<T> : Container<T> adds Extra field.
        Console.WriteLine("--- Generic struct inheritance ---");
        var ext = new ExtendedContainer<int>(42, 7);
        Console.WriteLine($"  ext.Extra = {ext.Extra}");
        Console.WriteLine($"  ext.DescribeExtended() = {ext.DescribeExtended()}");

        // Value is declared as T on Container<T> and is an int here, assigned by : base(value).
        // 42 rather than 0 is what distinguishes the inherited generic field being initialized
        // from its name merely resolving.
        Console.WriteLine($"  ext.Value = {ext.Value}");
        Console.WriteLine($"  ext.DescribeContainer() = {ext.DescribeContainer()}");

        // --- 8. Verify field values are preserved through conversion ---
        // This proves the implicit operator copies the correct values.
        Console.WriteLine("--- Value preservation through conversion ---");
        var origin = new Point3D(77, 88, 99);
        Point converted = origin;
        Console.WriteLine($"  origin.X={origin.X}, converted.X={converted.X}");
        Console.WriteLine($"  origin.Y={origin.Y}, converted.Y={converted.Y}");

        Console.WriteLine("Done!");
    }

    public static void Main(string[] args)
    {
        RunDemo();
    }
}
