public class Program
{
    public static void Main(string[] args)
    {
        var coord = (0, 5);
        var quadrant = coord switch
        {
            (0, 0) => "origin",
            (> 0, > 0) => "quadrant I",
            (< 0, > 0) => "quadrant II",
            (< 0, < 0) => "quadrant III",
            (> 0, < 0) => "quadrant IV",
            (0, _) => "on y-axis",
            (_, 0) => "on x-axis",
            (var _, var _) => "unknown",
        };
        Console.WriteLine($"({coord.Item1}, {coord.Item2}) => {quadrant}");
    }
}
