using Standard;

public class Widget
{
    public int Value;

    default {
        Value = 7
    }
}

public class Box<T>
{
    public T Value;
}

public class Program
{
    public static void Main(string[] args)
    {
        var constructed = new Box<Widget>();
        var defaulted = default(Box<Widget>);
        Console.WriteLine($"new={constructed.Value.Value} default={defaulted.Value.Value}");
        constructed.Value.Value = 9;
        Console.WriteLine($"independent={defaulted.Value.Value}");
    }
}
