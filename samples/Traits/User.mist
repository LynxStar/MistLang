using Standard;

namespace Traits;

// User structurally satisfies the Printable trait because
// it has public properties `Name` (string) and `Id` (int)
// that match the trait's member signatures exactly.
// No explicit declaration like `: Printable` is needed.
public class User
{
    public string Name { get; set; }
    public int Id { get; set; }

    public User(string name, int id)
    {
        this.Name = name;
        this.Id = id;
    }
}
