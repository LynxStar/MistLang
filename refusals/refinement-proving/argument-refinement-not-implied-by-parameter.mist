using Standard;

namespace Refusal;

type AdultAge = int >= 18;
type DrinkingAge = int >= 21;

public class Probe
{
    public static string Serve(DrinkingAge d)
    {
        return "served";
    }

    public static string Relay(AdultAge adult)
    {
        // REFUSE: MIST_PA_REFINEMENT_NOT_IMPLIED
        return Serve(adult);
    }

    public static void Main()
    {
        Console.WriteLine(Relay(19));
        Console.WriteLine("unreachable");
    }
}
