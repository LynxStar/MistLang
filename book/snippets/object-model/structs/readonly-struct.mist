using Standard;

public readonly struct Vector2
{
    public int X;
    public int Y;

    public Vector2(int x, int y)
    {
        this.X = x;
        this.Y = y;
    }

    public int MagnitudeSquared()
    {
        return X * X + Y * Y;
    }

    public string Describe()
    {
        return $"Vector2(X={X}, Y={Y})";
    }
}
