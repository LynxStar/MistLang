abstract IGreeting
{
    string Name();

    string Greet()
    {
        return $"Hello, I am {this.Name()}";
    }
}

public class Robot : IGreeting
{
    private string model;

    public Robot(string model)
    {
        this.model = model;
    }

    public string Name()
    {
        return this.model;
    }

    // Overrides the default Greet() with a custom implementation
    public string Greet()
    {
        return $"Beep boop, I am {this.model}";
    }
}

