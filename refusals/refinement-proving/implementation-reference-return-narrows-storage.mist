using Standard;

namespace Refusal;

type Positive = int > 0;
type Strong = int >= 2;
public abstract IFactory { ref Positive Make(); }
public class Factory : IFactory
{
    private Strong held = 2;
    // REFUSE: MIST_PA_REFINEMENT_RETURN_UNPROVEN
    public ref Strong Make() { return ref held; }
}

public class Probe { public static void Main() { } }
