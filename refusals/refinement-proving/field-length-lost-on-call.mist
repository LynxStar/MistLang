using Standard;

namespace Refusal;

public struct Buffer
{
    public int[] cells;

    public int First()
    {
        if(cells.Length > 0)
        {
            Shrink();
            // REFUSE: MIST_PA_INDEX_UNPROVEN
            return cells[0];
        }

        return 0;
    }

    void Shrink()
    {
        cells = new int[0];
    }
}

public class Probe
{
    public static void Main()
    {
        var buffer = new Buffer();
        buffer.cells = [4, 5];
        Console.WriteLine(buffer.First());
    }
}
