using Standard;

namespace Refusal;

public class Dog
{
    public string Name;

    public Dog(string name)
    {
        Name = name;
    }
}

public struct Slot
{
    public Dog held;

    public Slot(Dog d)
    {
        // REFUSE: MIST_PA_FIELD_READ_BEFORE_ASSIGNMENT
        Console.WriteLine(this.held.Name);
        held = d;
    }
}

public class Probe
{
    public static void Main()
    {
        var slot = new Slot(new Dog("a"));
        Console.WriteLine("unreachable");
    }
}
