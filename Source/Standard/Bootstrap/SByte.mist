namespace Standard;

intrinsic public readonly owned struct SByte
{
    // Binary arithmetic operators — Requirement 3.1
    intrinsic public static SByte operator +(SByte a, SByte b);
    intrinsic public static SByte operator -(SByte a, SByte b);
    intrinsic public static SByte operator *(SByte a, SByte b);
    intrinsic public static SByte operator /(SByte a, SByte b);
    intrinsic public static SByte operator %(SByte a, SByte b);

    // Comparison operators — Requirement 3.2
    intrinsic public static Boolean operator <(SByte a, SByte b);
    intrinsic public static Boolean operator >(SByte a, SByte b);
    intrinsic public static Boolean operator <=(SByte a, SByte b);
    intrinsic public static Boolean operator >=(SByte a, SByte b);
    intrinsic public static Boolean operator ==(SByte a, SByte b);
    intrinsic public static Boolean operator !=(SByte a, SByte b);

    // Unary negation — Requirement 3.3
    intrinsic public static SByte operator -(SByte a);

    // Implicit widening conversions
    intrinsic public static implicit operator Int16(SByte value);
    intrinsic public static implicit operator Int32(SByte value);
    intrinsic public static implicit operator Int64(SByte value);
    intrinsic public static implicit operator Single(SByte value);
    intrinsic public static implicit operator Double(SByte value);
    intrinsic public static implicit operator Decimal(SByte value);
}
