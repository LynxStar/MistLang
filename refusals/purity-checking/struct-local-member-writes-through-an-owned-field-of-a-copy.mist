using Standard;

namespace Refusal;

public class Box
{
    public int N;

    public pure Box() { }
}

public struct Cell
{
    public owned Box Inner;

    public pure Cell(owned Box inner)
    {
        Inner = inner;
    }

    public local void Bump()
    {
        // REFUSE: MIST_PA_PURE_SCOPE_WRITES
        Inner.N = 42;
    }
}

public class Probe
{
    public static void Main()
    {
        owned var b = new Box();
        var c = new Cell(b);
        c.Bump();
        Console.WriteLine("unreachable");
    }
}
