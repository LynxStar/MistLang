using Standard;

namespace Refusal;

public struct Point
{
    public int x;
    public int y;
}

public class Probe
{
    public static void Main()
    {
        Point p;
        p.x = 1;
        int Read() { return p.y; }
        int Forward() { return Read(); }
        // REFUSE: MIST_PA_LOCAL_FUNCTION_READS_UNASSIGNED
        Console.WriteLine(Forward());
        p.y = 2;
    }
}
