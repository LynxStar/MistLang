using Standard;

namespace Refusal;

public struct Point
{
    public int x;
    public int y;
}

public class Probe
{
    public static void Main()
    {
        Point p;
        p.x = 1;
        // REFUSE: MIST_PA_LOCAL_READ_BEFORE_ASSIGNMENT
        func<int, int> read = value => value + p.y;
        p.y = 2;
        Console.WriteLine(read(0));
    }
}
