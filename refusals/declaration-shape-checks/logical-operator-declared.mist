using Standard;

namespace Refusal;

public struct Flag
{
    public bool Value;

    public Flag(bool value)
    {
        Value = value;
    }

    // REFUSE: MIST_PA_LOGICAL_OPERATOR_DECLARED
    public static bool operator &&(Flag a, Flag b)
    {
        return a.Value;
    }
}

public class Probe
{
    public static void Main()
    {
        var f = new Flag(true);
        Console.WriteLine("unreachable");
    }
}
