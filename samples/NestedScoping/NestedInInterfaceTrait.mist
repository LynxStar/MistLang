// NestedInInterfaceTrait — Demonstrates class nested inside interface and trait.
//
// These declarations are in a separate file because having top-level
// interfaces/traits with nested types in the same file as the Program class
// triggers the entry point detection bug (MIST_TC_0017). In a separate file,
// they compile and emit correctly, proving the parser and C# emitter handle
// these patterns.
//
// Patterns demonstrated:
//   7. Class in interface
//   8. Class in trait

namespace NestedScoping;

// ─── 7. Class nested inside an interface ─────────────────────────────────────

public abstract IFactory
{
    public class DefaultProduct
    {
        public static string Label() { return "IFactory.DefaultProduct (class in interface)"; }
    }
}

// ─── 8. Class nested inside a trait ──────────────────────────────────────────

public abstract SerializableTrait
{
    public class Config
    {
        public static string Format() { return "SerializableTrait.Config (class in trait)"; }
    }
}
