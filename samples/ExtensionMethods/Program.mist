// Extension Methods — Sample demonstrating extension block features in Mist.
//
// This sample showcases:
//   1. Instance extension methods on a concrete type (Requirement 2.1)
//   2. Universal extension via extension(unknown self) (Requirement 9.1)
//   3. Namespace-scoped extensions with `using` (Requirement 27.1)
using System;
using Standard;
using StringUtils;  // Import namespace-scoped extensions

namespace ExtensionMethods;

public class Program
{
    public static void RunDemo()
    {

        Console.WriteLine("Extension Methods Demo");

        // ─── 1. Instance extension methods on a concrete type ────────────────
        var greeting = new Greeting("Hello beautiful world");
        var wc = greeting.WordCount();
        var upper = greeting.Uppercase();
        var repeated = greeting.Repeat(2);

        // ─── 2. Universal extension via extension(unknown self) ──────────────
        var desc = greeting.Describe();
        var notNull = greeting.IsNotNull();

        // ─── 3. Namespace-scoped extensions (requires `using StringUtils`) ───
        var text = "hello";
        var isNullOrEmpty = text.IsNullOrEmpty();
        var reversed = text.Reverse();
        var capitalized = text.Capitalize();

        var empty = "";
        var emptyCheck = empty.IsNullOrEmpty();

        Console.WriteLine(empty.GetType());

    }
}
