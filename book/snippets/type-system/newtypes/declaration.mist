using Standard;

public struct Point
{
    public int X;
    public int Y;

    public Point(int x, int y)
    {
        this.X = x;
        this.Y = y;
    }

    public Point Moved(int dx)
    {
        return new Point(X + dx, Y);
    }
}

public type UserId = new int;
public type Position = new Point;
