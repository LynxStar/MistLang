namespace GenericTraits;

// Class satisfying Comparable<int> — CompareTo(int) matches CompareTo(T) with T=int
public class IntComparer : Comparable<int>
{
    private int value;

    public IntComparer(int v)
    {
        value = v;
    }

    public int CompareTo(int other)
    {
        return value - other;
    }
}
