using Standard;

public class Program
{
    public static async string FetchData()
    {
        return "data";
    }

    public static async void SendNotification()
    {
        Console.WriteLine("Notification sent");
    }

    // This is an async context — tasks are not auto-awaited
    public static async void ProcessAll()
    {
        FetchData();          // discarded task — awaited at scope exit
        SendNotification();   // discarded task — awaited at scope exit

        Console.WriteLine("Processing...");
        // Both tasks are implicitly awaited here when the scope exits
    }

    public static void Main(string[] args)
    {
        ProcessAll();
    }
}
