// CallableInference -- a lambda or a method group passed to a generic call that learns its own type
// arguments from it, and to an overloaded call whose candidates would type it differently. The ordinary
// arguments are read first, the callable is typed by the parameters they fixed, and its result teaches
// the rest; an inferred line prints what the line stating its type arguments prints, and an overload
// names itself, so the choice the context made is on the page.
//
// V2-ONLY. Classic refuses this program (measured 2026-09-25): every method group argument is
// MIST_TC_0084, and an overloaded call's lambda is typed by one candidate whatever the other arguments
// say (MIST_UNDEFINED_MEMBER on `s.Length`).

using Standard;

namespace CallableInference;

public class Api
{
    public static R Apply<T, R>(T value, func<T, R> callback)
    {
        return callback(value);
    }

    public static R Run<T, R>(func<T, R> callback, T value)
    {
        return callback(value);
    }

    public static C Pipe<A, B, C>(A start, func<A, B> first, func<B, C> second)
    {
        return second(first(start));
    }

    public static A Fold<T, A>(T[] items, A seed, func<A, T, A> step)
    {
        var acc = seed;

        foreach(T item in items)
        {
            acc = step(acc, item);
        }

        return acc;
    }

    public static T Twice<T>(T value, func<T, T> step)
    {
        return step(step(value));
    }

    public static T Same<T>(T value)
    {
        return value;
    }

    public static int Next(int x)
    {
        return x + 1;
    }

    public static string Show(int x)
    {
        return $"Show(int) {x}";
    }

    public static string Show(string x)
    {
        return $"Show(string) {x}";
    }

    public static string Transform(int value, func<int, int> f)
    {
        return $"Transform(int) {f(value)}";
    }

    public static string Transform(string value, func<string, string> f)
    {
        return $"Transform(string) {f(value)}";
    }

    public static string Measure(func<int, int> f)
    {
        return $"Measure(int) {f(3)}";
    }

    public static string Measure(func<string, int> f)
    {
        return $"Measure(string) {f("four")}";
    }

    public static string Widen(func<int, int> f)
    {
        return $"Widen(int) {f(1)}";
    }

    public static string Widen(func<int, long> f)
    {
        return $"Widen(long) {f(1)}";
    }
}

public class Box<T>
{
    public T Value;

    public Box(T value)
    {
        this.Value = value;
    }

    public Box<R> Map<R>(func<T, R> f)
    {
        return new Box<R>(f(this.Value));
    }
}

public class Labeled
{
    public string Text;

    public Labeled(func<int, int> f)
    {
        this.Text = $"Labeled(int) {f(5)}";
    }

    public Labeled(func<string, int> f)
    {
        this.Text = $"Labeled(string) {f("five")}";
    }
}

public class Program
{
    public static void RunDemo()
    {
        Console.WriteLine("=== CallableInference Sample ===");

        var added = Api.Apply(1, x => x + 1);
        var addedStated = Api.Apply<int, int>(1, x => x + 1);
        Console.WriteLine($"lambda: {added} | stated: {addedStated}");

        var sized = Api.Apply(2, x =>
        {
            if(x > 1)
            {
                return "big";
            }

            return "small";
        });
        Console.WriteLine($"block body: {sized}");

        var measured = Api.Run((string s) => s.Length, "mist");
        Console.WriteLine($"stated parameter: {measured}");

        var piped = Api.Pipe(20, x => x + 1, y => $"<{y}>");
        Console.WriteLine($"chained: {piped}");

        int[] numbers = [1, 2, 3, 4];
        var total = Api.Fold(numbers, 0, (acc, n) => acc + n);
        var joined = Api.Fold(numbers, "", (acc, n) => $"{acc}{n}");
        Console.WriteLine($"fold: {total} {joined}");

        var next = Api.Apply(4, Api.Next);
        var nextStated = Api.Apply<int, int>(4, Api.Next);
        Console.WriteLine($"group: {next} | stated: {nextStated}");

        var shownInt = Api.Apply(4, Api.Show);
        var shownString = Api.Apply("w", Api.Show);
        Console.WriteLine($"overloaded group: {shownInt} | {shownString}");

        var doubled = Api.Twice(3, Api.Same);
        Console.WriteLine($"generic group: {doubled}");

        var box = new Box<int>(42);
        var mapped = box.Map(x => $"[{x}]").Map(s => s.Length);
        Console.WriteLine($"receiver: {mapped.Value}");

        Console.WriteLine(Api.Transform(3, v => v * 2));
        Console.WriteLine(Api.Transform("ab", v => v + "!"));
        Console.WriteLine(Api.Measure(x => x + 1));
        Console.WriteLine(Api.Measure(s => s.Length));
        Console.WriteLine(Api.Widen(x => x + 1));
        Console.WriteLine(Api.Widen(x => x + 1L));

        var labeled = new Labeled(s => s.Length);
        Console.WriteLine(labeled.Text);

        Console.WriteLine("=== CallableInference Done ===");
    }

    public static void Main(string[] args)
    {
        RunDemo();
    }
}
