//   6. Class in struct

namespace NestedScoping;

// ─── 6. Class nested inside a struct ─────────────────────────────────────────

public struct ContainerStruct
{
    public class Item
    {
        public string name;

        public Item(string name) { this.name = name; }

        public string Label() { return $"ContainerStruct.Item named {name}"; }
    }

    Item held;

    public ContainerStruct(string name)
    {
        held = new Item(name);
    }

    public Item Held()
    {
        return held;
    }
}
