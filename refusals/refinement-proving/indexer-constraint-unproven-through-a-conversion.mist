using Standard;

namespace Refusal;

public class Counter
{
    public Counter() { }

    public static implicit operator int(Counter c) { return 1; }
}

public class Shelf
{
    public int this[int slot] where slot >= 18
    {
        get { return slot; }
    }
}

public class Probe
{
    public static void Main()
    {
        var shelf = new Shelf();
        // REFUSE: MIST_PA_CONSTRAINT_UNPROVEN
        Console.WriteLine(shelf[new Counter()]);
        Console.WriteLine("unreachable");
    }
}
