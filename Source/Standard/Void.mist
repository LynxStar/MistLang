public struct Void
{
    
    public static Void Instance { get; } = new Void();

    private Void() { }

    public static implicit operator Type(Void v)
    {
        return void;
    }

    public static bool operator ==(Void a, Void b)
    {
        return true;
    }

    public static bool operator !=(Void a, Void b)
    {
        return false;
    }
}
