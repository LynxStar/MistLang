using Standard;

namespace Refusal;

public linear class Handle
{
    public int Fd;

    public Handle(int fd)
    {
        this.Fd = fd;
    }

    public void Drop()
    {
        Console.WriteLine("drop");
    }

    public int Get()
    {
        return Fd;
    }
}

public class Probe
{
    public static void Main()
    {
        var f = new Handle(1);
        f.Drop();
        // REFUSE: MIST_PA_USE_AFTER_MOVE
        Console.WriteLine(f.Get());
        Console.WriteLine("unreachable");
    }
}
