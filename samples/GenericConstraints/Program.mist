// GenericConstraints — Demonstrates all generic constraint variants in Mist.
// Each permutation prints labeled output to stdout for correctness verification.

using Standard;

namespace GenericConstraints;

// ─── Supporting types ────────────────────────────────────────────────────

public abstract IOrderable {
    int GetOrder();
}

public abstract IPrintable {
    string Print();
}

public abstract Describable {
    string Describe();
}

public class Animal {
    public string Species;
    public Animal(string species) {
        Species = species;
    }
    public string GetSpecies() {
        return Species;
    }
}

public class Dog : Animal {
    public Dog() : base("Dog") { }
}

public class Cat : Animal {
    public Cat() : base("Cat") { }
}

public struct Point {
    public int X;
    public int Y;
    public Point(int x, int y) {
        X = x;
        Y = y;
    }
}

public class Widget : IPrintable, Describable {
    public int Id;
    public Widget() {
        Id = 0;
    }
    public Widget(int id) {
        Id = id;
    }
    public Widget(bool flag) {
        if (flag) {
            Id = 1;
        } else {
            Id = 0;
        }
    }
    public string Print() {
        return $"Widget({Id})";
    }
    public string Describe() {
        return $"Widget#{Id}";
    }
}

public class OrderableInt : IOrderable {
    public int Value;
    public OrderableInt() {
        Value = 0;
    }
    public OrderableInt(int v) {
        Value = v;
    }
    public int GetOrder() {
        return Value;
    }
}

public class SimpleImpl : IPrintable {
    public string Print() {
        return "SimpleImpl";
    }
}

// ─── 1. class constraint ─────────────────────────────────────────────────

public class RefOnly<T> where T : class {
    public T Item;
    public RefOnly(T item) {
        Item = item;
    }
    public string Show() {
        return $"RefOnly: {Item}";
    }
}

// ─── 2. struct constraint ────────────────────────────────────────────────

public class ValOnly<T> where T : struct {
    public T Item;
    public ValOnly(T item) {
        Item = item;
    }
    public string Show() {
        return $"ValOnly: {Item}";
    }
}

// ─── 3. abstract type constraint with method call ────────────────────────────

public class Sorter<T> where T : IOrderable {
    public T First;
    public T Second;
    public Sorter(T first, T second) {
        First = first;
        Second = second;
    }
    public int GetFirstOrder() {
        return First.GetOrder();
    }
}

// ─── 4. abstract type constraint with member access ──────────────────────

public class Describer<T> where T : Describable {
    public T Item;
    public Describer(T item) {
        Item = item;
    }
    public string GetDescription() {
        return Item.Describe();
    }
}

// ─── 5. base class constraint with member access ─────────────────────────

public class AnimalHandler<T> where T : Animal {
    public T Animal;
    public AnimalHandler(T animal) {
        Animal = animal;
    }
    public string GetSpeciesName() {
        return Animal.GetSpecies();
    }
}

// ─── 6. parameterless new() constraint ───────────────────────────────────

public class Creator<T> where T : new() {
    public T Create() {
        return new T();
    }
}

// ─── 7. parameterized new(int) constraint ────────────────────────────────

public class IntFactory<T> where T : new(int) {
    public T Create(int value) {
        return new T(value);
    }
}

// ─── 8. multiple constructor constraints: new(), new(int), new(bool) ─────

public class MultiFactory<T> where T : new(), new(int), new(bool) {
    public T CreateDefault() {
        return new T();
    }
    public T CreateFromInt(int value) {
        return new T(value);
    }
    public T CreateFromBool(bool flag) {
        return new T(flag);
    }
}

// ─── 9. multiple constraints on single type parameter ────────────────────

public class PrintableCreator<T> where T : class, IPrintable, new() {
    public T CreateNew() {
        return new T();
    }
}

// ─── 10. multiple where clauses on multi-parameter generic ───────────────

public class Pair<K, V> where K : IOrderable where V : new() {
    public K Key;
    public V Value;
    public Pair(K key) {
        Key = key;
        Value = new V();
    }
}

// ─── 11. constraints on generic methods ──────────────────────────────────

public class MethodConstraints {
    public static T CreateItem<T>() where T : new() {
        return new T();
    }
}

// ─── 12. constraint propagation through inheritance ──────────────────────

public class BaseContainer<T> where T : IPrintable {
    public T Item;
    public BaseContainer(T item) {
        Item = item;
    }
}

public class DerivedContainer<T> : BaseContainer<T> where T : IPrintable, new() {
    public DerivedContainer(T item) : base(item) { }
    public T CreateNew() {
        return new T();
    }
}

// ─── 13. constructor constraints at any position ─────────────────────────

public class AnyPosition<T> where T : new(int), IOrderable, class {
    public T Item;
    public AnyPosition(int value) {
        Item = new T(value);
    }
}

// ─── 14. abstract type declaration with constraint ───────────────────────────

public abstract IRepository<T> where T : class, new() {
    T GetById(int id);
    void Save(T item);
}

public class WidgetRepository : IRepository<Widget> {
    public Widget GetById(int id) {
        return new Widget(id);
    }
    public void Save(Widget item) { }
}

// ─── 15. struct declaration with constraint ──────────────────────────────

public struct Holder<T> where T : IPrintable {
    public T Value;
    public Holder(T value) {
        Value = value;
    }
}

// ─── 16. generic abstract type with constraint ──────────────────────────

public abstract Transformable<T> where T : new() {
    T Transform(T input);
    T CreateDefault();
}

public class Doubler : Transformable<Widget> {
    public Widget Transform(Widget input) {
        return new Widget(input.Id * 2);
    }
    public Widget CreateDefault() {
        return new Widget();
    }
}

// ─── 17. generic abstract type with constraint — nominal conformance ─────

public class Tripler : Transformable<Widget>
{
    public Widget Transform(Widget input) 
    {
        return new Widget(input.Id * 2);
    }
    public Widget CreateDefault() 
    {
        return new Widget();
    }
}

public class TransformableHolder
{
    public static T UseTransformable<T>(Transformable<T> transformable) where T : new()
    {
        return transformable.CreateDefault();
    }
}

// ─── Entry point ─────────────────────────────────────────────────────────

public class Program {
    public static void RunDemo() {
        Console.WriteLine("--- Generic Constraints ---");

        // 1. class constraint
        RefOnly<string> r = new RefOnly<string>("hello");
        Console.WriteLine($"1. class constraint: {r.Show()}");

        // 2. struct constraint
        ValOnly<int> v = new ValOnly<int>(42);
        Console.WriteLine($"2. struct constraint: {v.Show()}");

        // 3. abstract type constraint — call constrained method
        OrderableInt a = new OrderableInt(10);
        OrderableInt b = new OrderableInt(20);
        Sorter<OrderableInt> sorter = new Sorter<OrderableInt>(a, b);
        Console.WriteLine($"3. abstract type constraint: first order = {sorter.GetFirstOrder()}");

        // 4. abstract type constraint — call constrained method
        Widget w = new Widget(7);
        Describer<Widget> desc = new Describer<Widget>(w);
        Console.WriteLine($"4. abstract type constraint: {desc.GetDescription()}");

        // 5. base class constraint — call constrained method
        Dog dog = new Dog();
        AnimalHandler<Dog> handler = new AnimalHandler<Dog>(dog);
        Console.WriteLine($"5. base class constraint: {handler.GetSpeciesName()}");

        // 6. parameterless new()
        Creator<Widget> creator = new Creator<Widget>();
        Widget created = creator.Create();
        Console.WriteLine($"6. new() constraint: created Widget({created.Id})");

        // 7. parameterized new(int)
        IntFactory<Widget> intFactory = new IntFactory<Widget>();
        Widget fromInt = intFactory.Create(99);
        Console.WriteLine($"7. new(int) constraint: Widget({fromInt.Id})");

        // 8. multiple constructor constraints
        MultiFactory<Widget> multi = new MultiFactory<Widget>();
        Widget mDefault = multi.CreateDefault();
        Widget mInt = multi.CreateFromInt(5);
        Widget mBool = multi.CreateFromBool(true);
        Console.WriteLine($"8. multi-ctor: default=Widget({mDefault.Id}), int=Widget({mInt.Id}), bool=Widget({mBool.Id})");

        // 9. multiple constraints on single type parameter
        PrintableCreator<Widget> pc = new PrintableCreator<Widget>();
        Widget pcWidget = pc.CreateNew();
        Console.WriteLine($"9. multiple constraints: Widget({pcWidget.Id})");

        // 10. multiple where clauses
        Pair<OrderableInt, Widget> pair = new Pair<OrderableInt, Widget>(new OrderableInt(1));
        Console.WriteLine($"10. multiple where clauses: key={pair.Key.Value}, value=Widget({pair.Value.Id})");

        // 11. constraints on generic methods
        Widget methodWidget = MethodConstraints.CreateItem<Widget>();
        Console.WriteLine($"11. method constraint: Widget({methodWidget.Id})");

        // 12. constraint propagation
        Widget propWidget = new Widget(3);
        DerivedContainer<Widget> dc = new DerivedContainer<Widget>(propWidget);
        Widget newFromDerived = dc.CreateNew();
        Console.WriteLine($"12. propagation: new=Widget({newFromDerived.Id})");

        // 13. constructor constraints at any position
        AnyPosition<OrderableInt> ap = new AnyPosition<OrderableInt>(77);
        Console.WriteLine($"13. any position: value={ap.Item.Value}");

        // 14. abstract type declaration with constraint
        WidgetRepository repo = new WidgetRepository();
        Widget fetched = repo.GetById(42);
        Console.WriteLine($"14. abstract type with constraint: Widget({fetched.Id})");

        // 15. struct declaration with constraint
        Holder<Widget> holder = new Holder<Widget>(new Widget(99));
        Console.WriteLine($"15. struct with constraint: holds a Widget");

        // 16. generic abstract type with constraint
        Doubler doubler = new Doubler();
        Widget doubled = doubler.Transform(new Widget(21));
        Widget defaultWidget = doubler.CreateDefault();
        Console.WriteLine($"16. generic abstract type: transformed=Widget({doubled.Id}), default=Widget({defaultWidget.Id})");

        // // 17. generic abstract type with constraint — nominal conformance
        // Tripler tripler = new Tripler();
        // var tripled = TransformableHolder.UseTransformable(tripler);
        // Console.WriteLine($"17. generic abstract type: default=Widget({tripled.Id})");

        Console.WriteLine("--- Generic Constraints Done ---");
    }

    public static void Main(string[] args) {
        RunDemo();
    }
}
