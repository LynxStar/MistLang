using Standard;

public class Program
{
    public static int SumAll(params int[] xs)
    {
        var total = 0;
        foreach (var x in xs)
        {
            total = total + x;
        }

        return total;
    }

    public static void Main(string[] cmdArgs)
    {
        var sum = SumAll(1, 2, 3, 4);
        Console.WriteLine($"sum={sum}");
    }
}
