namespace Standard;

intrinsic public struct Int64
{
    // Binary arithmetic operators — Requirement 3.1
    intrinsic public static Int64 operator +(Int64 a, Int64 b);
    intrinsic public static Int64 operator -(Int64 a, Int64 b);
    intrinsic public static Int64 operator *(Int64 a, Int64 b);
    intrinsic public static Int64 operator /(Int64 a, Int64 b);
    intrinsic public static Int64 operator %(Int64 a, Int64 b);

    // Comparison operators — Requirement 3.2
    intrinsic public static Boolean operator <(Int64 a, Int64 b);
    intrinsic public static Boolean operator >(Int64 a, Int64 b);
    intrinsic public static Boolean operator <=(Int64 a, Int64 b);
    intrinsic public static Boolean operator >=(Int64 a, Int64 b);
    intrinsic public static Boolean operator ==(Int64 a, Int64 b);
    intrinsic public static Boolean operator !=(Int64 a, Int64 b);

    // Unary negation — Requirement 3.3
    intrinsic public static Int64 operator -(Int64 a);
}
