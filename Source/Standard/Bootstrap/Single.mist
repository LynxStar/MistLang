namespace Standard;

intrinsic public struct Single
{
    // Binary arithmetic operators — Requirement 3.1
    intrinsic public static Single operator +(Single a, Single b);
    intrinsic public static Single operator -(Single a, Single b);
    intrinsic public static Single operator *(Single a, Single b);
    intrinsic public static Single operator /(Single a, Single b);
    intrinsic public static Single operator %(Single a, Single b);

    // Comparison operators — Requirement 3.2
    intrinsic public static Boolean operator <(Single a, Single b);
    intrinsic public static Boolean operator >(Single a, Single b);
    intrinsic public static Boolean operator <=(Single a, Single b);
    intrinsic public static Boolean operator >=(Single a, Single b);
    intrinsic public static Boolean operator ==(Single a, Single b);
    intrinsic public static Boolean operator !=(Single a, Single b);

    // Unary negation — Requirement 3.3
    intrinsic public static Single operator -(Single a);

    // Implicit widening conversions
    intrinsic public static implicit operator Double(Single value);
}
