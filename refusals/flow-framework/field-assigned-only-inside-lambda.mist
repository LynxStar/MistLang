using Standard;

namespace Refusal;

public class Dog
{
    public string Name;

    public Dog(string name)
    {
        Name = name;
    }
}

public class Account
{
    public Dog owner;

    // REFUSE: MIST_PA_FIELD_NOT_DEFINITELY_ASSIGNED
    public Account()
    {
        var assign = () => { owner = new Dog("a"); return 0; };
        Console.WriteLine(assign());
    }
}

public class Probe
{
    public static void Main()
    {
        var account = new Account();
        Console.WriteLine("unreachable");
    }
}
