using Standard;

namespace Refusal;

type AdultAge = int >= 18;

public abstract IAccept
{
    string Accept(int value);
}

public class Adults : IAccept
{
    // REFUSE: MIST_PA_CONSTRAINT_STRENGTHENED
    public string Accept(AdultAge value)
    {
        return "adult";
    }
}

public class Probe
{
    public static void Main()
    {
        var a = new Adults();
        Console.WriteLine(a.Accept(20));
        Console.WriteLine("unreachable");
    }
}
