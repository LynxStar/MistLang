namespace Standard;

intrinsic public readonly owned struct Int32 : IClonable<Int32>
{
    intrinsic public static readonly Int32 MinValue;
    intrinsic public static readonly Int32 MaxValue;
    intrinsic public string ToString(System.IFormatProvider? provider);
    intrinsic public pure int CompareTo(Int32 other);
    intrinsic public static Int32? Parse(string? text);
    intrinsic public static Int32? Parse(ReadOnlySpan<char> text);
    intrinsic public static Int32? Parse(string? text, System.IFormatProvider? provider);

    // IClonable base case — value-type identity copy (Requirement 8.6)
    intrinsic public pure owned Int32 Clone();

    // Binary arithmetic operators — Requirement 3.1
    intrinsic public pure static Int32 operator +(Int32 a, Int32 b);
    intrinsic public pure static Int32 operator -(Int32 a, Int32 b);
    intrinsic public pure static Int32 operator *(Int32 a, Int32 b);
    intrinsic public pure static Int32 operator /(Int32 a, Int32 b);
    intrinsic public pure static Int32 operator %(Int32 a, Int32 b);

    // Comparison operators — Requirement 3.2
    intrinsic public pure static Boolean operator <(Int32 a, Int32 b);
    intrinsic public pure static Boolean operator >(Int32 a, Int32 b);
    intrinsic public pure static Boolean operator <=(Int32 a, Int32 b);
    intrinsic public pure static Boolean operator >=(Int32 a, Int32 b);
    intrinsic public pure static Boolean operator ==(Int32 a, Int32 b);
    intrinsic public pure static Boolean operator !=(Int32 a, Int32 b);

    // Unary negation — Requirement 3.3
    intrinsic public pure static Int32 operator -(Int32 a);

    public pure Boolean IsEven()
    {
        return this % 2 == 0;
    }

    // Implicit widening conversions
    intrinsic public pure static implicit operator Int64(Int32 value);
    intrinsic public pure static implicit operator Single(Int32 value);
    intrinsic public pure static implicit operator Double(Int32 value);
    intrinsic public pure static implicit operator Decimal(Int32 value);
}
