using Standard;

namespace Refusal;

type Positive = int > 0;

public class Probe
{
    public static int Keep(int value)
    {
        if(value != 0)
        {
            // REFUSE: MIST_PA_REFINEMENT_UNPROVEN
            Positive positive = value;
            return positive;
        }

        return 1;
    }

    public static void Main()
    {
        Console.WriteLine(Keep(-1));
    }
}
