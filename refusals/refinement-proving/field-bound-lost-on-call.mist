using Standard;

namespace Refusal;

public class Probe
{
    int[] items = new int[3];

    public int At(int i)
    {
        if(i >= 0 && i < items.Length)
        {
            Shrink();
            // REFUSE: MIST_PA_INDEX_UNPROVEN
            return items[i];
        }

        return 0;
    }

    void Shrink()
    {
        items = new int[1];
    }

    public static void Main()
    {
        Console.WriteLine(new Probe().At(2));
        Console.WriteLine("unreachable");
    }
}