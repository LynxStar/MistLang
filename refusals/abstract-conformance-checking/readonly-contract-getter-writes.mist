using Standard;

namespace Refusal;

public readonly abstract ISized
{
    int Size { get; }
}

public class Jar : ISized
{
    int reads;

    // REFUSE: MIST_PA_READONLY_CONTRACT_NOT_MET
    public int Size
    {
        get
        {
            reads = reads + 1;
            return reads;
        }
    }
}

public class Probe
{
    public static void Main()
    {
        Console.WriteLine("unreachable");
    }
}
