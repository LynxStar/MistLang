using Standard;

namespace Refusal;

public struct Tally
{
    public static int made;
    public int v;

    public Tally(int x)
    {
        v = x;
    }

    public static Tally operator +(Tally a, Tally b)
    {
        made = made + 1;
        return new Tally(a.v + b.v);
    }

    public static pure int Twice(Tally t)
    {
        // REFUSE: MIST_PA_PURE_SCOPE_CALLS_IMPURE
        return (t + t).v;
    }
}

public class Probe
{
    public static void Main()
    {
        var t = new Tally(2);
        var d = Tally.Twice(t);
        Console.WriteLine("unreachable");
    }
}
