using Standard;

namespace Refusal;

public class Clock
{
    public static int Ticks;
}

public abstract Sink
{
    local void Add(int n);
}

// REFUSE-FILE: MIST_PA_PURITY_CONTRACT_NOT_MET
public class Loud : Sink
{
    public void Add(int n)
    {
        Clock.Ticks = n;
    }
}

public class Probe
{
    public static void Main()
    {
        var l = new Loud();
        l.Add(1);
        Console.WriteLine("unreachable");
    }
}
