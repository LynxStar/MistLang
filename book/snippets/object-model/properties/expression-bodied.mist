using System;

namespace Demo;

public class Rectangle
{
    private int _width;
    private int _height;

    public Rectangle(int width, int height)
    {
        this._width = width;
        this._height = height;
    }

    // Read-only computed property (top-level =>)
    public int Area => _width * _height;

    // Expression-bodied get accessor
    public int Width
    {
        get => _width;
    }

    // Expression-bodied get and set accessors
    public int Height
    {
        get => _height;
        set => _height = value;
    }
}
