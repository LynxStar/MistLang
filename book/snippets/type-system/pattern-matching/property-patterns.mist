using Standard;

public class Circle
{
    public int Radius { get; }

    public Circle(int radius)
    {
        this.Radius = radius;
    }
}

public class Program
{
    public static void Main(string[] args)
    {
        var bigCircle = new Circle(10);
        if (bigCircle is { Radius: > 5 })
        {
            Console.WriteLine("Found a circle with radius > 5");
        }
    }
}
