using Standard;

namespace Refusal;

public class Probe
{
    public static int At(Span<int> span, Span<int> other, int i)
    {
        if(i >= 0 && i < span.Length)
        {
            span = other;
            // REFUSE: MIST_PA_INDEX_UNPROVEN
            return span[i];
        }

        return 0;
    }

    public static void Main() { }
}
