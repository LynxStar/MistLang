using Standard;

namespace Refusal;

public owned class Engine
{
    public int Rpm;

    public Engine(int rpm)
    {
        this.Rpm = rpm;
    }

    public void Rev(int by)
    {
        this.Rpm = this.Rpm + by;
    }

    public int Get()
    {
        return Rpm;
    }
}

public class Probe
{
    public static void Main()
    {
        owned var e = new Engine(1);
        borrowed var b = e;
        // REFUSE: MIST_PA_LEASE_VIOLATION
        Console.WriteLine(e.Get());
        b.Rev(1);
        Console.WriteLine("unreachable");
    }
}
