using System;

namespace Introduction;

// Type alias — a transparent name for an existing type
type Percentage = int;

public class Scorer
{
    // Adhoc refinement — inline constraint on a parameter
    public static string | int Grade(Percentage score) where score >= 0 and <= 100
    {
        if (score >= 90)
        {
            return "A";
        }
        return score;
    }

    public static void Main(string[] args)
    {
        // Type union — the return value could be a string or an int
        var result = Scorer.Grade(95);

        if (result is string letter)
        {
            Console.WriteLine($"Grade: {letter}");
        }
        if (result is int numeric)
        {
            Console.WriteLine($"Score: {numeric}");
        }
    }
}
