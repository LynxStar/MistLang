using Standard;

namespace Refusal;

public struct Coin
{
    public static int Bias;

    public readonly int Worth;

    public Coin(int worth)
    {
        Worth = worth;
    }

    public static explicit operator int(Coin coin)
    {
        return coin.Worth + Bias;
    }
}

public class Jar
{
    readonly Coin coin = new Coin(1);

    public int Size
    {
        get { return (int)coin; }
    }
}

// REFUSE: MIST_PA_REFINEMENT_OVER_MUTABLE_MEMBER
type Low = Jar { Size: < 3 };

public class Probe
{
    public static void Main()
    {
        Console.WriteLine("unreachable");
    }
}
