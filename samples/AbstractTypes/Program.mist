using Standard;

namespace AbstractTypes;

public class Program
{
    private static void PrintDescribable(IDescribable item)
    {
        Console.WriteLine($"  Describable received");
    }

    public static void RunDemo()
    {
        // --- Class implementing single abstract type (IDescribable) ---
        Console.WriteLine("=== Class implementing single abstract type ===");
        var person = new Person("Alice", 30);
        Console.WriteLine(person.Describe());
        Console.WriteLine($"  Name: {person.GetName()}");

        // --- Abstract type-to-abstract type inheritance (IFullyDescribable : IDescribable) ---
        Console.WriteLine("=== Abstract type inheritance (transitive) ===");
        var robot = new Robot("T-800", 2);
        Console.WriteLine(robot.Describe());
        Console.WriteLine(robot.DetailedDescribe());

        // --- Assign implementing type to abstract type-typed variable ---
        Console.WriteLine("=== Abstract type-typed variable ===");
        IDescribable describable = new Person("Bob", 25);
        Console.WriteLine("  Assigned Person to IDescribable");

        // --- Assign Robot to IDescribable (transitive abstract type assignability) ---
        Console.WriteLine("=== Robot as IDescribable (transitive) ===");
        IDescribable robotAsDescribable = new Robot("C-3PO", 3);
        Console.WriteLine("  Assigned Robot to IDescribable (transitive)");

        // --- Pass implementing type to method accepting abstract type parameter ---
        Console.WriteLine("=== Abstract type parameter passing ===");
        PrintDescribable(person);
        PrintDescribable(robot);

        // --- Default implementation: taken as-is (FriendlyDog does NOT override Greet) ---
        Console.WriteLine("=== Default implementation (not overridden) ===");
        var dog = new FriendlyDog("Rex");
        Console.WriteLine(dog.Greet());

        // --- Default implementation: called through abstract type reference ---
        Console.WriteLine("=== Default via abstract type reference ===");
        IGreetable greetableDog = new FriendlyDog("Rex");
        Console.WriteLine(greetableDog.Greet());

        // --- Prove identical behavior: concrete ref vs abstract ref ---
        Console.WriteLine("=== Identical dispatch (concrete == abstract ref) ===");
        var dog2 = new FriendlyDog("Buddy");
        IGreetable greetableDog2 = new FriendlyDog("Buddy");
        Console.WriteLine($"  Concrete: {dog2.Greet()}");
        Console.WriteLine($"  Abstract: {greetableDog2.Greet()}");

        // --- Default implementation: overridden (FormalCat overrides Greet) ---
        Console.WriteLine("=== Default implementation (overridden) ===");
        var cat = new FormalCat("Whiskers");
        Console.WriteLine(cat.Greet());

        // --- Override through abstract type reference ---
        Console.WriteLine("=== Override via abstract type reference ===");
        IGreetable greetableCat = new FormalCat("Whiskers");
        Console.WriteLine(greetableCat.Greet());

        // --- Prove override takes precedence regardless of reference type ---
        Console.WriteLine("=== Override precedence (concrete == abstract ref) ===");
        var cat2 = new FormalCat("Shadow");
        IGreetable greetableCat2 = new FormalCat("Shadow");
        Console.WriteLine($"  Concrete: {cat2.Greet()}");
        Console.WriteLine($"  Abstract: {greetableCat2.Greet()}");

        Console.WriteLine("Done!");
    }

    public static void Main(string[] args)
    {
        RunDemo();
    }
}
