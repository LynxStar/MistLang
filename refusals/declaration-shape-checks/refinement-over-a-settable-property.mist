using Standard;

namespace Refusal;

public class Jar
{
    public Jar(int size)
    {
        Size = size;
    }

    public int Size { get; set; }
}

// The test below narrows to the refused type and owes nothing further.
// REFUSE: MIST_PA_REFINEMENT_OVER_MUTABLE_MEMBER
type Low = Jar { Size: < 3 };

public class Probe
{
    public static void Main()
    {
        var jar = new Jar(1);

        if (jar is Low low)
        {
            low.Size = 9;
            Console.WriteLine(low.Size);
        }
    }
}
