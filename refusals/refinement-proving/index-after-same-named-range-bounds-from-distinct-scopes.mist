using Standard;

namespace Refusal;

public class Probe
{
    public static int Read(bool flag)
    {
        var numbers = [10, 20, 30, 40, 50];
        Range window = ..;
        if(flag)
        {
            int end = 3;
            window = 0..end;
        }
        else
        {
            int end = 1;
            window = 0..end;
        }

        var slice = numbers[window];
        // REFUSE: MIST_PA_INDEX_UNPROVEN
        return slice[0];
    }

    public static void Main()
    {
        Console.WriteLine(Read(true));
    }
}
