using Standard;

namespace Refusal;

public class Ledger
{
    private int count = 3;

    public int Count
    {
        get { return count; }
    }

    public int this[int entry] where entry >= 0 and < Count
    {
        get { return entry; }
    }
}

public class Probe
{
    public static void Main()
    {
        var ledger = new Ledger();
        if (ledger is [
            // REFUSE: MIST_PA_CONSTRAINT_UNPROVEN
            var first])
        {
            Console.WriteLine(first);
        }
    }
}
