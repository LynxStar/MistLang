using Standard;

namespace UnknownDemo;

public class Program
{
    private static void Describe(unknown value)
    {
        if (value is int i)
        {
            Console.WriteLine($"int: {i}");
        }
        if (value is string s)
        {
            Console.WriteLine($"string: {s}");
        }
    }

    public static void Main(string[] args)
    {
        Describe(42);
        Describe("mist");
    }
}
