using Standard;

namespace ProofArithmetic;

public class Program
{
    public static void Main()
    {
        RunDemo();
    }

    public static int Value(Result<int, DivisionError> result)
    {
        return result.Inspect() switch
        {
            (true, var payload) => payload,
            (false, var error) => -1,
            _ => -2
        };
    }

    public static string Message(Result<int, DivisionError> result)
    {
        return result.Inspect() switch
        {
            (true, var payload) => "ok",
            (false, var error) => error.Message,
            _ => "unreachable"
        };
    }

    public static Result<int, DivisionError> Scale(int x, int y, int factor)
    {
        var scaled = (x / y * factor)!;
        return (scaled + 1).AsSuccess();
    }

    public static void RunDemo()
    {
        Console.WriteLine("=== ProofArithmetic Sample ===");

        int a = 20;
        int four = 4;
        int provenQuotient = a / four;
        Console.WriteLine($"proven int: {a} / {four} = {provenQuotient}");

        int d = Divisor();
        if (d > 0)
        {
            int guarded = a / d;
            Console.WriteLine($"guarded int: {a} / d = {guarded}");
        }

        var uncertain = a / d;
        Console.WriteLine($"uncertain Result -> {Value(uncertain)}");

        var byZero = a / Zero();
        Console.WriteLine($"divide by zero -> {Message(byZero)}");

        var composed = a / d * 3;
        Console.WriteLine($"compose (a/d)*3 -> {Value(composed)}");

        var composedError = a / Zero() * 3;
        Console.WriteLine($"compose carries error -> {Message(composedError)}");

        Console.WriteLine($"propagated (a/d*factor)! + 1 -> {Value(Scale(a, d, 3))}");
        Console.WriteLine($"propagated through zero -> {Message(Scale(a, Zero(), 3))}");

        int m = 1;
        if (Divisor() > 0)
        {
            m = 0;
        }
        var mutated = a / m;
        Console.WriteLine($"mutated divisor -> {Message(mutated)}");

        int counter = 2;
        while (counter >= 0)
        {
            var step = a / counter;
            Console.WriteLine($"loop {counter} -> {Value(step)}");
            counter = counter - 1;
        }

        int low = Minimum();
        int negOne = Divisor() - 6;
        var checkedRem = low % negOne;
        Console.WriteLine($"checked min % -1 -> {Value(checkedRem)}");

        if (negOne != 0)
        {
            int guardedRem = low % negOne;
            Console.WriteLine($"guarded min % -1 -> {guardedRem}");
        }

        Decimal money = 100.0m;
        Decimal rate = 3.0m;
        var product = money * rate;
        Console.WriteLine($"decimal product -> {Decimals(product)}");
        var byZeroDecimal = money / DecimalZero();
        Console.WriteLine($"decimal / 0 -> {Decimals(byZeroDecimal)}");
    }

    public static string Decimals(Result<Decimal, System.Exception> result)
    {
        return result.Inspect() switch
        {
            (true, var payload) => "ok",
            (false, var error) => error.Message,
            _ => "unreachable"
        };
    }

    public static Decimal DecimalZero()
    {
        return 0.0m;
    }

    public static int Minimum()
    {
        return -2147483648;
    }

    public static int Divisor()
    {
        return 5;
    }

    public static int Zero()
    {
        return 0;
    }
}
