// AmbientTypes — Covers String, Math, and Convert ambient type operations.

using System;

namespace AmbientTypes;

public class Program
{
    public static void RunDemo()
    {
        // 16. String operations (ambient System.String)
        string phrase = "Hello Mist World";
        Console.WriteLine($"contains={phrase.Contains("Mist")}");
        Console.WriteLine($"sub={phrase.Substring(6)}");

        // 17. Math operations (ambient System.Math)
        Console.WriteLine($"abs={Math.Abs(-42)} max={Math.Max(10, 25)} min={Math.Min(10, 25)}");

        // 18. Convert operations (ambient System.Convert)
        int parsed = Convert.ToInt32("42");
        Console.WriteLine($"parsed={parsed} back={Convert.ToString(parsed)}");
    }
}
