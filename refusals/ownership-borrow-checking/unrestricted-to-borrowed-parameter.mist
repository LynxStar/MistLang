using Standard;

namespace Refusal;

public owned class Engine
{
    public int Rpm;

    public Engine(int rpm)
    {
        this.Rpm = rpm;
    }

    public void Rev(int by)
    {
        this.Rpm = this.Rpm + by;
    }

    public int Get()
    {
        return Rpm;
    }
}

public class Probe
{
    public static void Borrow(borrowed Engine e)
    {
        e.Rev(1);
    }

    public static void Main()
    {
        var e = new Engine(1);
        // REFUSE: MIST_PA_INCOMPATIBLE_LEND
        Borrow(e);
        Console.WriteLine("unreachable");
    }
}
