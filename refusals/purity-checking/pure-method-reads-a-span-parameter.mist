using Standard;

namespace Refusal;

public class Reader
{
    public static pure int First(Span<int, 2> s)
    {
        // REFUSE: MIST_PA_PURE_SCOPE_READS_MUTABLE
        return s[0];
    }
}

public class Probe
{
    public static void Main()
    {
        int[] xs = [1, 2];
        Span<int, 2> s = new Span<int, 2>(xs);
        var r = Reader.First(s);
        Console.WriteLine("unreachable");
    }
}
