using Standard;

class Point
{
    public int X;
    public int Y;

    public Point(int x, int y)
    {
        X = x;
        Y = y;
    }

    public string Describe()
    {
        return $"Point({X}, {Y})";
    }
}

class Container
{
    // Field initializer
    public Point Origin = new(0, 0);
}

class Program
{
    // Return statement
    public static Point MakePoint(int x, int y)
    {
        return new(x, y);
    }

    // Method argument
    public static void PrintPoint(Point p)
    {
        Console.WriteLine(p.Describe());
    }

    public static void Main(string[] args)
    {
        // Local variable with explicit type
        Point p1 = new(1, 2);

        // Assignment to existing typed variable
        Point p2 = new(0, 0);
        p2 = new(3, 4);

        // Return type inference
        var p3 = MakePoint(5, 6);

        // Method argument inference
        PrintPoint(new(7, 8));
    }
}
