namespace GenericTraits;

// Class satisfying Converter<int, string> — string Convert(int) matches TOut Convert(TIn) with TIn=int, TOut=string
public class IntToString
{
    public IntToString()
    {
    }

    public string Convert(int input)
    {
        return "converted";
    }
}

with IntToString : Converter<int, string>
{
    Convert as Convert;
}
