namespace Standard;

intrinsic public readonly owned struct Int16 : IClonable<Int16>
{
    public type Nonzero = Int16 not 0;
    public type QuotientDividend = Int16 not (>= -32768 and <= -32768);
    public type QuotientDivisor = Int16 not (>= -1 and <= -1);

    // IClonable base case — value-type identity copy (Requirement 8.6)
    intrinsic public pure owned Int16 Clone();

    // Binary arithmetic operators — Requirement 3.1
    intrinsic public pure static Int16 operator +(Int16 a, Int16 b);
    intrinsic public pure static Int16 operator -(Int16 a, Int16 b);
    intrinsic public pure static Int16 operator *(Int16 a, Int16 b);

    intrinsic public pure static Result<Int16, DivisionError> operator /(Int16 a, Int16 b);
    intrinsic public pure static Result<Int16, DivisionError> operator %(Int16 a, Int16 b);

    // Comparison operators — Requirement 3.2
    intrinsic public pure static Boolean operator <(Int16 a, Int16 b);
    intrinsic public pure static Boolean operator >(Int16 a, Int16 b);
    intrinsic public pure static Boolean operator <=(Int16 a, Int16 b);
    intrinsic public pure static Boolean operator >=(Int16 a, Int16 b);
    intrinsic public pure static Boolean operator ==(Int16 a, Int16 b);
    intrinsic public pure static Boolean operator !=(Int16 a, Int16 b);

    // Unary negation — Requirement 3.3
    intrinsic public pure static Int16 operator -(Int16 a);

    // Implicit widening conversions
    intrinsic public pure static implicit operator Int32(Int16 value);
    intrinsic public pure static implicit operator Int64(Int16 value);
    intrinsic public pure static implicit operator Single(Int16 value);
    intrinsic public pure static implicit operator Double(Int16 value);
    intrinsic public pure static implicit operator Decimal(Int16 value);

