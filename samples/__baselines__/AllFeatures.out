=== Enums Sample ===
--- Explicit type annotation ---
  Direction.North = Direction { Value = N }
  Direction.South = Direction { Value = S }
  Direction.East = Direction { Value = E }
  Direction.West = Direction { Value = W }
--- Inferred type (int) ---
  Priority.High = Priority { Value = 1 }
  Priority.Medium = Priority { Value = 2 }
  Priority.Low = Priority { Value = 3 }
--- Name-only enum (byte) ---
  Color.Red = Color { Value = 0 }
  Color.Green = Color { Value = 1 }
  Color.Blue = Color { Value = 2 }
--- Mixed explicit/implicit ---
  HttpStatus.Ok = HttpStatus { Value = 200 }
  HttpStatus.Created = HttpStatus { Value = 201 }
  HttpStatus.BadRequest = HttpStatus { Value = 400 }
  HttpStatus.NotFound = HttpStatus { Value = 401 }
  HttpStatus.InternalError = HttpStatus { Value = 500 }
--- Union underlying type ---
  MixedResult.Success = MixedResult { Value = Union_Int32_String }
  MixedResult.ErrorMsg = MixedResult { Value = Union_Int32_String }
--- Member access (dot notation) ---
  north = Direction { Value = N }
--- Enum as variable type ---
  favorite = Color { Value = 2 }
--- Enum as parameter type ---
  Direction value: Direction { Value = E }
--- Enum as return type ---
  default priority = Priority { Value = 2 }
--- Enum as field type ---
  config level = LogLevel { Value = 1 }
--- Implicit conversion ---
  Priority.High as int = 1
  Direction.North as string = N
  Color.Red as byte = 0
--- Pattern matching ---
  d is Direction.North = True
  d is Direction.South = False
  c is Color.Green = True
  c is Color.Red = False
--- Public visibility ---
  Public enum Direction.North = Direction { Value = N }
--- Default visibility ---
  Default enum LogLevel.Info = LogLevel { Value = 0 }
  Default enum LogLevel.Error = LogLevel { Value = 2 }
--- Trailing comma ---
  Season.Spring = Season { Value = 1 }
  Season.Winter = Season { Value = 4 }
--- Struct underlying type ---
  CardinalDir.Up = CardinalDir { Value = Enums.Vec2 }
  CardinalDir.Down = CardinalDir { Value = Enums.Vec2 }
  CardinalDir.Left = CardinalDir { Value = Enums.Vec2 }
  CardinalDir.Right = CardinalDir { Value = Enums.Vec2 }
  CardinalDir.Up as Vec2 = (0, 1)
--- Class underlying type ---
  Severity.Critical = Severity { Value = Enums.Label }
  Severity.Warning = Severity { Value = Enums.Label }
  Severity.Info = Severity { Value = Enums.Label }
  Severity.Critical as Label = Label(CRITICAL, 1)
--- Interface/Trait underlying types ---
  Pet.Dog = Pet { Value = Enums.Animal }
  Pet.Cat = Pet { Value = Enums.Animal }
  Pet.Fish = Pet { Value = Enums.Animal }
  Pet.Dog as Animal = Animal(Dog)
Done!
