using Standard;

namespace Refusal;

public class Probe
{
    public static int Sliced(bool flag)
    {
        var numbers = [10, 20, 30, 40, 50];
        Range window = 0..1;

        if (flag)
        {
            window = 0..3;
        }

        var slice = numbers[window];

        // REFUSE: MIST_PA_INDEX_UNPROVEN
        return slice[1];
    }

    public static void Main()
    {
        Console.WriteLine(Sliced(true));
    }
}