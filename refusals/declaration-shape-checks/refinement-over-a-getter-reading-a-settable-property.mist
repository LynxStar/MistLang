using Standard;

namespace Refusal;

public class Lid
{
    public int Width { get; set; }
}

public class Jar
{
    readonly Lid top = new Lid();

    public int Size
    {
        get { return top.Width; }
    }
}

// REFUSE: MIST_PA_REFINEMENT_OVER_MUTABLE_MEMBER
type Low = Jar { Size: < 3 };

public class Probe
{
    public static void Main()
    {
        Console.WriteLine("unreachable");
    }
}
