using Standard;

namespace Refusal;

public class Probe
{
    public static int At(ReadOnlySpan<int> span, ReadOnlySpan<int> other, int i)
    {
        if(i >= 0 && i < span.Length)
        {
            i = -1;
            // REFUSE: MIST_PA_INDEX_OUT_OF_BOUNDS
            return span[i];
        }

        return 0;
    }

    public static void Main() { }
}
