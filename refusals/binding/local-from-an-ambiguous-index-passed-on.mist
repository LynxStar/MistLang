using Standard;

namespace Refusal;

public class Table
{
    public string this[uint u]
    {
        get { return "uint"; }
    }

    public string this[short s]
    {
        get { return "short"; }
    }
}

public class Probe
{
    public static void Main()
    {
        var table = new Table();
        byte small = 2;
        // REFUSE: MIST_PM_AMBIGUOUS_OVERLOAD
        var r = table[small];
        Console.WriteLine(r);
    }
}
