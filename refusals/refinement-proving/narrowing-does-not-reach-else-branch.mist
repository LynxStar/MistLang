using Standard;

namespace Refusal;

type AdultAge = int >= 18;

public class Probe
{
    public static int Accept(int x)
    {
        if(x >= 18)
        {
            return x;
        }
        else
        {
            // REFUSE: MIST_PA_REFINEMENT_UNPROVEN
            AdultAge a = x;
            return a;
        }
    }

    public static void Main()
    {
        Console.WriteLine(Accept(20));
        Console.WriteLine("unreachable");
    }
}
