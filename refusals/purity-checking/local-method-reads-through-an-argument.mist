using Standard;

namespace Refusal;

public class Bag
{
    public int Count;

    public local int Peek(Bag other)
    {
        // REFUSE: MIST_PA_LOCAL_SCOPE_READS_ARGUMENT
        return other.Count;
    }
}

public class Probe
{
    public static void Main()
    {
        var a = new Bag();
        var b = new Bag();
        var p = a.Peek(b);
        Console.WriteLine("unreachable");
    }
}
