using Standard;

namespace Refusal;

public readonly abstract IReadable
{
    int GetLength();
}

public class Document : IReadable
{
    public int Reads;

    // REFUSE: MIST_PA_READONLY_CONTRACT_NOT_MET
    public int GetLength()
    {
        Reads = Reads + 1;
        return Reads;
    }
}

public class Probe
{
    public static void Main()
    {
        Console.WriteLine("unreachable");
    }
}
