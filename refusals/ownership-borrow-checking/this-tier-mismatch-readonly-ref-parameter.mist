using Standard;

namespace Refusal;

public owned class Engine
{
    public int Rpm;

    public Engine(int rpm)
    {
        this.Rpm = rpm;
    }

    public void Rev(int by)
    {
        this.Rpm = this.Rpm + by;
    }

    public int Get()
    {
        return Rpm;
    }
}

public class Probe
{
    public static void Touch(readonly ref Engine e)
    {
        // REFUSE: MIST_PA_THIS_TIER_MISMATCH
        e.Rev(1);
    }

    public static void Main()
    {
        owned var e = new Engine(1);
        Touch(e);
        Console.WriteLine("unreachable");
    }
}
