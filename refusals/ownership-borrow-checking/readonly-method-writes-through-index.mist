using Standard;

namespace Refusal;

public struct Buffer
{
    public int[] cells;

    public Buffer(int[] cells)
    {
        this.cells = cells;
    }

    public readonly void Poke(int v)
    {
        // REFUSE: MIST_PA_READONLY_CONTEXT_WRITES_THROUGH_INDEX
        cells[0] = v;
    }
}

public class Probe
{
    public static void Main()
    {
        int[] data = [1, 2, 3];
        var b = new Buffer(data);
        b.Poke(9);
        Console.WriteLine("unreachable");
    }
}
