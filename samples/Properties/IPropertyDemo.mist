// IPropertyDemo — Demonstrates interface property declarations.

using Standard;

namespace Properties;

abstract ILabeled
{
    string Label { get; }
}

abstract IEditable : ILabeled
{
    int Value { get; set; }
}

public class LabeledItem : IEditable
{
    public string Label { get; }
    public int Value { get; set; }

    public LabeledItem(string label, int value)
    {
        this.Label = label;
        this.Value = value;
    }

    public string Describe()
    {
        return $"LabeledItem(Label={Label}, Value={Value})";
    }
}
