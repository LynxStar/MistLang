using Standard;

namespace Refusal;

public class Account
{
    public owned int Balance;

    public Account(owned int balance)
    {
        this.Balance = balance;
    }

    // REFUSE: MIST_PA_THIS_TIER_INSUFFICIENT
    public void Touch() with readonly ref
    {
        this.Balance = 5;
    }
}

public class Probe
{
    public static void Main()
    {
        owned var a = new Account(1);
        a.Touch();
        Console.WriteLine("unreachable");
    }
}
