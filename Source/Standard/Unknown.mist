// Universal extension methods every value in Mist can call. The method bodies are
// placeholders — actual behavior comes from the .NET runtime when the code is transpiled.
// Requirements: 23.1, 23.2, 23.3

extension(unknown self) 
{
    public string ToString() 
    {
        return "";
    }

    public int GetHashCode() 
    {
        return 0;
    }

    public Type GetType()
    {
        return Type.Of(self);
    }

}
