using Standard;

namespace Refusal;

public class Lid
{
    public int Width { get; set; }
}

public class Jar
{
    public Jar(Lid top)
    {
        Top = top;
    }

    public Lid Top { get; }
}

// REFUSE: MIST_PA_REFINEMENT_OVER_MUTABLE_MEMBER
type Narrow = Jar { Top: { Width: < 3 } };

public class Probe
{
    public static void Main()
    {
        Console.WriteLine("unreachable");
    }
}
