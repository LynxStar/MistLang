using Standard;

namespace Refusal;

public class Box
{
    public readonly int K;

    public pure Box(int k)
    {
        K = k;
    }

    public Box(Box other, int v)
    {
        K = 0;
        // REFUSE: MIST_PA_READONLY_FIELD_ASSIGNED
        other.K = v;
    }
}

public class Probe
{
    public static void Main()
    {
        var b = new Box(1);
        var h = new Box(b, 9);
        Console.WriteLine(b.K);
        Console.WriteLine("unreachable");
    }
}
