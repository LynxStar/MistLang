// ComputedProps — Demonstrates computed properties (get-only with body).

using Standard;

namespace Properties;

public class ComputedProps
{
    private int _width;
    private int _height;

    public ComputedProps(int width, int height)
    {
        this._width = width;
        this._height = height;
    }

    // Computed property — expression-bodied (no backing field)
    public int Area => _width * _height;

    // Computed property — block-body get (no backing field)
    public int Perimeter
    {
        get
        {
            return 2 * (_width + _height);
        }
    }

    // Computed property — expression-bodied get accessor
    public bool IsSquare
    {
        get => _width == _height;
    }

    public string Describe()
    {
        return $"ComputedProps(Area={Area}, Perimeter={Perimeter}, IsSquare={IsSquare})";
    }
}
