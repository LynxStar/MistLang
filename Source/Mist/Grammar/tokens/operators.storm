// ─── Hidden Tokens ───────────────────────────────────────────────────────────

hidden token WHITESPACE   = `\s+`;
hidden token LINE_COMMENT = "//" `[^\n]*`;

// ─── Operators and Punctuation ───────────────────────────────────────────────

token LOGICAL_AND           = "&&";
token PIPE                  = "|";
token LOGICAL_OR            = "||";
token EQUAL_EQUAL           = "==";
token NOT_EQUAL             = "!=";
token LESS_THAN_OR_EQUAL    = "<=";
token GREATER_THAN_OR_EQUAL = ">=";
token SUCH_THAT             = "=>";
token QUESTION_QUESTION_EQUAL = "??=";
token QUESTION_QUESTION     = "??";
token QUESTION_DOT          = "?.";
token QUESTION              = "?";
token PLUS_PLUS             = "++";
token MINUS_MINUS           = "--";
token PLUS_EQUAL            = "+=";
token MINUS_EQUAL           = "-=";
token STAR_EQUAL            = "*=";
token SLASH_EQUAL           = "/=";
token PERCENT_EQUAL         = "%=";
token PLUS                  = "+";
token MINUS                 = "-";
token STAR                  = "*";
token SLASH                 = "/";
token MODULO                = "%";
token EQUAL                 = "=";
token LESS_THAN             = "<";
token GREATER_THAN          = ">";
token EXCLAMATION           = "!";
token ELLIPSIS              = "...";
token CARET                 = "^";
token DOTDOT                = "..";
token DOT                   = ".";
token COMMA                 = ",";
token SEMICOLON             = ";";
token COLON                 = ":";
token LEFT_PARENTHESIS      = "(";
token RIGHT_PARENTHESIS     = ")";
token LEFT_BRACE            = "{" => push default;
token RIGHT_BRACE           = "}" => pop;
token LEFT_BRACKET          = "[";
token RIGHT_BRACKET         = "]";
