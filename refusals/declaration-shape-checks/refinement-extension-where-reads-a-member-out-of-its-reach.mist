using Standard;

namespace Refusal;

public class Gauge
{
    private readonly int level = 1;
}

extension(int self)
{
    // REFUSE: MIST_PA_INACCESSIBLE_MEMBER
    public int Take(Gauge gauge) where gauge { level: < 3 }
    {
        return self;
    }
}

