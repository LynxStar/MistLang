using Standard;

namespace Refusal;

public class Sink
{
    public static R Apply<T, R>(T value, func<T, R> callback)
    {
        return callback(value);
    }
}

public class Probe
{
    public static void Main()
    {
        // REFUSE: MIST_PM_TYPE_ARGUMENTS_CONFLICT
        Console.WriteLine(Sink.Apply(1, (string s) => s));
    }
}
