using Standard;

namespace Refusal;

public class Counter
{
    public static bool operator ==(Counter counter, int value) { return true; }
    public static bool operator !=(Counter counter, int value) { return false; }
    public static implicit operator Index(Counter counter) { return ^3; }
}

public class Probe
{
    public static void Main()
    {
        var numbers = [10, 20, 30, 40, 50];
        var counter = new Counter();
        if(counter == 3)
        {
            Range window = 0..counter;
            var slice = numbers[window];
            // REFUSE: MIST_PA_INDEX_UNPROVEN
            Console.WriteLine(slice[2]);
        }
    }
}
