using Standard;

public readonly class Interval
{
    public int Start;
    public int End;

    public Interval(int start, int end)
    {
        this.Start = start;
        this.End = end;
    }
}

type ValidInterval = Interval { Start: >= 0 };

public class Program
{
    public static void Main(string[] args)
    {
        var r = new Interval(10, 50);
        if (r is ValidInterval valid)
        {
            Console.WriteLine($"Valid: Start={valid.Start}");
        }
    }
}
