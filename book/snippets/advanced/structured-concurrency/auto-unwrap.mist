using Standard;

public class Program
{
    public static async int FetchData()
    {
        return 100;
    }

    public static async string FormatData(int value)
    {
        return "Value: " + value.ToString();
    }

    // This is a sync context — no async modifier
    public static void Main(string[] args)
    {
        // Async calls are auto-awaited; result types are unwrapped
        var result = FetchData();           // result: int (not Task<int>)
        var formatted = FormatData(result); // formatted: string

        Console.WriteLine(formatted);  // "Value: 100"
    }
}
