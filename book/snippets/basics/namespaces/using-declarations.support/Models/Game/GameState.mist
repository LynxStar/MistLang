using Standard;

// No explicit namespace — inferred as "Namespaces.Models.Game"

public class GameState
{
    private int level;
    private bool active;

    public GameState(int level, bool active)
    {
        this.level = level;
        this.active = active;
    }

    public string Summary()
    {
        return $"Level: {level}, Active: {active}";
    }
}
