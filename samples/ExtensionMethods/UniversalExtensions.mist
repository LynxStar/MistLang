// UniversalExtensions — Extension methods available on ALL types via `unknown` receiver.
// Demonstrates: Requirement 9.1 (universal extensions via extension(unknown self)).
// Universal extensions are the least specific — type-specific extensions take priority.

namespace ExtensionMethods;

// ─── Universal extension via extension(unknown self) ─────────────────────────
// These methods are callable on any value regardless of its type.
// In the emitted C#, the receiver becomes `object`.

extension(unknown self)
{
    // Returns a human-readable description of any value.
    public string Describe()
    {
        return "Value: " + self.ToString();
    }

    // Returns true if the value is not null.
    public bool IsNotNull()
    {
        return self != null;
    }
}
