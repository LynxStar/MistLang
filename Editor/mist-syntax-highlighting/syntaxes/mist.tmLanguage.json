{
  "name": "Mist",
  "scopeName": "source.mist",
  "fileTypes": [".mist"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#interpolated-strings" },
    { "include": "#strings" },
    { "include": "#regex-literals" },
    { "include": "#chars" },
    { "include": "#declaration-names" },
    { "include": "#property-initializer-names" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#literals" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "pack-domain-annotation": {
      "comment": "Type-parameter pack domain annotation (variadics Req 17.3): Type[]:TArgs, Type[N]:TArgs, Type[2]:TShapes. The pack name after the colon is scoped like any other type parameter.",
      "patterns": [
        {
          "comment": "Empty or numeric fixed-size domain: Type[]:TArgs, Type[2]:TShapes",
          "match": "\\b(Type)(\\[)([0-9](?:_?[0-9])*)?(\\])(:)([a-zA-Z_]\\w*)",
          "captures": {
            "1": { "name": "storage.type.metatype.mist" },
            "2": { "name": "punctuation.squarebracket.mist" },
            "3": { "name": "constant.numeric.integer.mist" },
            "4": { "name": "punctuation.squarebracket.mist" },
            "5": { "name": "punctuation.separator.annotation.mist" },
            "6": { "name": "entity.name.type.parameter.mist" }
          }
        },
        {
          "comment": "Named comptime-length domain: Type[N]:TArgs",
          "match": "\\b(Type)(\\[)([a-zA-Z_]\\w*)(\\])(:)([a-zA-Z_]\\w*)",
          "captures": {
            "1": { "name": "storage.type.metatype.mist" },
            "2": { "name": "punctuation.squarebracket.mist" },
            "3": { "name": "variable.other.mist" },
            "4": { "name": "punctuation.squarebracket.mist" },
            "5": { "name": "punctuation.separator.annotation.mist" },
            "6": { "name": "entity.name.type.parameter.mist" }
          }
        }
      ]
    },
    "attributes": {
      "comment": "Attribute annotation: [Name], [Name(args)], [Name<T>] at declaration position (line start)",
      "name": "meta.attribute.mist",
      "begin": "^(\\s*)(\\[)",
      "end": "(\\])",
      "beginCaptures": {
        "2": { "name": "punctuation.definition.attribute.begin.mist" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.attribute.end.mist" }
      },
      "patterns": [
        {
          "comment": "Attribute name (qualified identifier): e.g., System.Serializable, Fact, JsonConverter",
          "match": "(?<=\\[|,\\s*)\\s*([a-zA-Z_]\\w*(?:\\.[a-zA-Z_]\\w*)*)",
          "captures": {
            "1": { "name": "entity.other.attribute-name.mist" }
          }
        },
        {
          "comment": "Type arguments within attribute: <Type, Type>",
          "begin": "(<)",
          "end": "(>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.typeparameters.begin.mist" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.typeparameters.end.mist" }
          },
          "patterns": [
            {
              "comment": "Primitive type in type argument position",
              "name": "storage.type.primitive.mist",
              "match": "\\b(int|uint|long|ulong|short|ushort|byte|sbyte|float|double|decimal|bool|char|string|regex|unknown)\\b"
            },
            {
              "comment": "Type name in type argument position",
              "name": "entity.name.type.mist",
              "match": "\\b[A-Z]\\w*\\b"
            },
            {
              "comment": "Other identifier in type argument position",
              "name": "variable.other.mist",
              "match": "\\b[a-zA-Z_]\\w*\\b"
            },
            {
              "name": "punctuation.separator.comma.mist",
              "match": ","
            }
          ]
        },
        {
          "comment": "String arguments within attribute parentheses",
          "name": "string.quoted.double.mist",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.mist",
              "match": "\\\\(\\\\|\\\"|n|r|t|0|')"
            }
          ]
        },
        {
          "comment": "Boolean literal arguments",
          "name": "constant.language.boolean.mist",
          "match": "\\b(true|false)\\b"
        },
        {
          "comment": "Hex numeric literal arguments",
          "name": "constant.numeric.hex.mist",
          "match": "\\b0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*\\b"
        },
        {
          "comment": "Binary numeric literal arguments",
          "name": "constant.numeric.binary.mist",
          "match": "\\b0[bB][01](?:_?[01])*\\b"
        },
        {
          "comment": "Float numeric literal arguments",
          "name": "constant.numeric.float.mist",
          "match": "\\b[0-9](?:_?[0-9])*\\.[0-9](?:_?[0-9])*[fFdDmM]?\\b|\\b[0-9](?:_?[0-9])*[fFdDmM]\\b"
        },
        {
          "comment": "Integer numeric literal arguments",
          "name": "constant.numeric.integer.mist",
          "match": "-?\\b[0-9](?:_?[0-9])*([lLuU]|UL|ul|Ul|uL|Lu|lU|LU|lu)?\\b"
        },
        {
          "comment": "Named argument identifier (before =)",
          "match": "([a-zA-Z_]\\w*)\\s*(=)(?!=)",
          "captures": {
            "1": { "name": "variable.other.property.mist" },
            "2": { "name": "keyword.operator.assignment.mist" }
          }
        },
        {
          "name": "punctuation.separator.comma.mist",
          "match": ","
        }
      ]
    },
    "comments": {
      "name": "comment.line.double-slash.mist",
      "match": "//.*$"
    },
    "interpolated-strings": {
      "name": "string.interpolated.mist",
      "begin": "\\$\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.mist" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.mist" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.mist",
          "match": "\\\\(\\\\|\\\"|n|r|t|0|')"
        },
        {
          "comment": "Interpolation expression: {expr}",
          "contentName": "meta.embedded.expression.mist",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.interpolation.begin.mist" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.interpolation.end.mist" }
          },
          "patterns": [
            { "include": "#keywords" },
            { "include": "#types" },
            { "include": "#literals" },
            {
              "comment": "Method call: identifier.method(...) or identifier(...)",
              "match": "([a-zA-Z_]\\w*)\\s*(?=\\()",
              "captures": {
                "1": { "name": "entity.name.function.mist" }
              }
            },
            {
              "comment": "Variable/property access",
              "name": "variable.other.mist",
              "match": "[a-zA-Z_]\\w*"
            },
            { "include": "#operators" },
            { "include": "#punctuation" }
          ]
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.mist",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.mist",
          "match": "\\\\(\\\\|\\\"|n|r|t|0|')"
        }
      ]
    },
    "regex-literals": {
      "name": "string.regexp.mist",
      "begin": "`",
      "end": "`",
      "patterns": [
        {
          "name": "constant.character.escape.mist",
          "match": "\\\\[`\\\\dDwWsSnNrRtTbB.^$*+?()\\[\\]{}|/]"
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.mist",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.mist",
          "match": "\\\\(\\\\|\\\"|n|r|t|0|')"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mist",
          "match": "\\b(if|else|while|for|foreach|in|break|return|switch|when|await)\\b"
        },
        {
          "name": "keyword.declaration.mist",
          "match": "\\b(namespace|using|class|struct|abstract|extension|type|enum)\\b"
        },
        {
          "comment": "Storage modifiers. `params` (variadics Req 17.1) is the value-side slurp / type-pack modifier and is highlighted here for value-parameter positions and class/struct/abstract type-parameter lists.",
          "name": "storage.modifier.mist",
          "match": "\\b(public|private|protected|internal|sealed|static|intrinsic|implicit|explicit|readonly|pure|local|mutable|owned|affine|linear|relevant|frozen|ref|borrowed|async|params)\\b"
        },
        {
          "comment": "default modifier on enum variant: default VariantName",
          "match": "\\b(default)\\s+(?=[A-Z]\\w*\\s*[:,}])",
          "captures": {
            "1": { "name": "storage.modifier.mist" }
          }
        },
        {
          "comment": "stackalloc expression: stackalloc T[n] - scope the keyword like `new` (keyword.other.mist) and the element type like a `new T[n]` element type (entity.name.type.mist)",
          "match": "\\b(stackalloc)\\s+([a-zA-Z_]\\w*)",
          "captures": {
            "1": { "name": "keyword.other.mist" },
            "2": { "name": "entity.name.type.mist" }
          }
        },
        {
          "name": "keyword.other.mist",
          "match": "\\b(new|stackalloc|var|this|get|set|init|field|operator|with|default|where)\\b"
        },
        {
          "comment": "Discard pattern: standalone _ in pattern contexts",
          "name": "variable.language.mist",
          "match": "(?<![\\w])_(?![\\w])"
        },
        {
          "comment": "Adhoc refinement constraint: where Name >= / <= / > / < ... and ...",
          "match": "\\b(where)\\s+([a-zA-Z_]\\w*)\\s+(>=|<=|>|<)",
          "captures": {
            "1": { "name": "keyword.other.mist" },
            "2": { "name": "entity.name.type.parameter.mist" },
            "3": { "name": "keyword.operator.comparison.mist" }
          }
        },
        {
          "comment": "Constraint clause: where TypeParam : class/struct/new(...)",
          "match": "\\b(where)\\s+([a-zA-Z_]\\w*)\\s*:",
          "captures": {
            "1": { "name": "keyword.other.mist" },
            "2": { "name": "entity.name.type.parameter.mist" }
          }
        },
        {
          "comment": "class/struct/default within constraint clauses (after colon in where clause)",
          "match": "(?<=where\\s+[a-zA-Z_]\\w*\\s*:[^{]*?)\\b(class|struct|default)\\b",
          "captures": {
            "1": { "name": "storage.type.mist" }
          }
        },
        {
          "comment": "new within constructor constraints",
          "match": "(?<=where\\s+[a-zA-Z_]\\w*\\s*:[^{]*?)\\b(new)\\s*\\(",
          "captures": {
            "1": { "name": "keyword.other.mist" }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.mist",
          "match": "\\b(int|uint|long|ulong|short|ushort|byte|sbyte|float|double|decimal|bool|char|string|regex|unknown|func)\\b"
        },
        {
          "name": "storage.type.void.mist",
          "match": "\\bvoid\\b"
        },
        {
          "name": "storage.type.metatype.mist",
          "match": "\\bType\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.numeric.binary.mist",
          "match": "\\b0[bB][01](?:_?[01])*([lLuU]|UL|ul|Ul|uL|Lu|lU|LU|lu)?\\b"
        },
        {
          "name": "constant.numeric.hex.mist",
          "match": "\\b0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*([lLuU]|UL|ul|Ul|uL|Lu|lU|LU|lu)?\\b"
        },
        {
          "name": "constant.numeric.float.mist",
          "match": "\\b[0-9](?:_?[0-9])*\\.[0-9](?:_?[0-9])*[fFdDmM]?\\b|\\b[0-9](?:_?[0-9])*[fFdDmM]\\b"
        },
        {
          "name": "constant.numeric.integer.mist",
          "match": "\\b[0-9](?:_?[0-9])*([lLuU]|UL|ul|Ul|uL|Lu|lU|LU|lu)?\\b"
        },
        {
          "name": "constant.language.boolean.mist",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "declaration-names": {
      "patterns": [
        {
          "comment": "Method this-tier clause: with owned/borrowed/frozen/readonly ref (after parameter list)",
          "match": "\\b(with)\\s+(owned|borrowed|frozen|readonly\\s+ref)\\b",
          "captures": {
            "1": { "name": "keyword.other.mist" },
            "2": { "name": "storage.modifier.mist" }
          }
        },
        {
          "comment": "Context discard declaration: with TypeReference _ = expression;",
          "match": "\\b(with)\\s+(?:(int|uint|long|ulong|short|ushort|byte|sbyte|float|double|decimal|bool|char|string|regex|unknown)|([A-Z]\\w*))\\s+(_)\\s*(?==(?!=))",
          "captures": {
            "1": { "name": "keyword.other.mist" },
            "2": { "name": "storage.type.primitive.mist" },
            "3": { "name": "entity.name.type.mist" },
            "4": { "name": "variable.language.mist" }
          }
        },
        {
          "comment": "Context typed declaration: with TypeReference identifier = expression;",
          "match": "\\b(with)\\s+(?:(int|uint|long|ulong|short|ushort|byte|sbyte|float|double|decimal|bool|char|string|regex|unknown)|([A-Z]\\w*))\\s+([a-z_]\\w*)\\s*(?==(?!=))",
          "captures": {
            "1": { "name": "keyword.other.mist" },
            "2": { "name": "storage.type.primitive.mist" },
            "3": { "name": "entity.name.type.mist" },
            "4": { "name": "variable.other.mist" }
          }
        },
        {
          "comment": "Context var declaration: with var identifier = expression;",
          "match": "\\b(with)\\s+(var)\\s+([a-zA-Z_]\\w*)\\s*(?==(?!=))",
          "captures": {
            "1": { "name": "keyword.other.mist" },
            "2": { "name": "keyword.other.mist" },
            "3": { "name": "variable.other.mist" }
          }
        },
        {
          "comment": "Context block: with(expression) { ... }",
          "match": "\\b(with)\\s*(?=\\()",
          "captures": {
            "1": { "name": "keyword.other.mist" }
          }
        },
        {
          "comment": "Method with clause: with TypeReference identifier (after parameter list, not followed by =)",
          "match": "\\b(with)\\s+(?:(int|uint|long|ulong|short|ushort|byte|sbyte|float|double|decimal|bool|char|string|regex|unknown)|([A-Z]\\w*))\\s+([a-z_]\\w*)\\b(?!\\s*=)",
          "captures": {
            "1": { "name": "keyword.other.mist" },
            "2": { "name": "storage.type.primitive.mist" },
            "3": { "name": "entity.name.type.mist" },
            "4": { "name": "variable.parameter.mist" }
          }
        },
        {
          "comment": "Extension block declaration: extension<T>(ReceiverType receiverName)",
          "match": "\\b(extension)\\s*(?:<([^>]+)>)?\\s*\\(\\s*([a-zA-Z_]\\w*(?:\\s*<[^>]+>)?(?:\\[\\])?)\\s+([a-zA-Z_]\\w*)\\s*\\)",
          "captures": {
            "1": { "name": "keyword.declaration.mist" },
            "2": { "name": "entity.name.type.parameter.mist" },
            "3": { "name": "entity.name.type.mist" },
            "4": { "name": "variable.parameter.mist" }
          }
        },
        {
          "comment": "Associated type slot declaration: type Name<T> : Constraints; (in abstract body)",
          "match": "\\b(type)\\s+([A-Z]\\w*)\\s*(?:<[^>]*>)?\\s*(:)\\s*([^;]*)",
          "captures": {
            "1": { "name": "keyword.declaration.mist" },
            "2": { "name": "entity.name.type.alias.mist" },
            "3": { "name": "punctuation.separator.mist" },
            "4": {
              "patterns": [
                {
                  "comment": "Constraint keywords: struct, class",
                  "name": "storage.modifier.mist",
                  "match": "\\b(struct|class)\\b"
                },
                {
                  "comment": "Abstract/type references in constraint list",
                  "name": "entity.name.type.mist",
                  "match": "\\b[A-Z]\\w*\\b"
                }
              ]
            }
          }
        },
        {
          "comment": "Newtype declaration: type Foo = new SourceType",
          "match": "\\b(type)\\s+([a-zA-Z_]\\w*)\\s*(=)\\s*(new)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.mist" },
            "2": { "name": "entity.name.type.newtype.mist" },
            "3": { "name": "keyword.operator.assignment.mist" },
            "4": { "name": "keyword.operator.new.mist" }
          }
        },
        {
          "comment": "Type alias declaration: type Foo = ..., type Bar<T> = ...",
          "match": "\\b(type)\\s+([a-zA-Z_]\\w*)\\s*(?:<([^>]+)>)?",
          "captures": {
            "1": { "name": "keyword.declaration.mist" },
            "2": { "name": "entity.name.type.alias.mist" },
            "3": { "name": "entity.name.type.parameter.mist" }
          }
        },
        {
          "comment": "Generic ref struct declaration: ref struct Name<T>",
          "match": "\\b(ref)\\s+(struct)\\s+([a-zA-Z_]\\w*)\\s*(<)",
          "captures": {
            "1": { "name": "storage.modifier.mist" },
            "2": { "name": "keyword.declaration.mist" },
            "3": { "name": "entity.name.type.mist" },
            "4": { "name": "punctuation.definition.typeparameters.begin.mist" }
          }
        },
        {
          "comment": "ref struct declaration: ref struct Name",
          "match": "\\b(ref)\\s+(struct)\\s+([a-zA-Z_]\\w*)",
          "captures": {
            "1": { "name": "storage.modifier.mist" },
            "2": { "name": "keyword.declaration.mist" },
            "3": { "name": "entity.name.type.struct.mist" }
          }
        },
        {
          "comment": "Generic class/struct/abstract declaration with type parameter list: class Box<T>, class Array<Size:int>",
          "match": "\\b(class|struct|abstract)\\s+([a-zA-Z_]\\w*)\\s*(<)",
          "captures": {
            "1": { "name": "keyword.declaration.mist" },
            "2": { "name": "entity.name.type.mist" },
            "3": { "name": "punctuation.definition.typeparameters.begin.mist" }
          }
        },
        {
          "comment": "Type-parameter pack domain annotation inside a class/struct/abstract type-parameter list: Type[]:TArgs, Type[N]:TArgs (variadics Req 17.3). Placed before the dependent annotation so the Type[...]: prefix is recognized first.",
          "include": "#pack-domain-annotation"
        },
        {
          "comment": "Dependent type parameter annotation: Size:int, N:bool, Cap:char etc. inside angle brackets",
          "match": "([a-zA-Z_]\\w*)(:)(int|uint|long|ulong|short|ushort|byte|sbyte|bool|char)\\b",
          "captures": {
            "1": { "name": "entity.name.type.parameter.mist" },
            "2": { "name": "punctuation.separator.annotation.mist" },
            "3": { "name": "storage.type.primitive.mist" }
          }
        },
        {
          "match": "\\b(class)\\s+([a-zA-Z_]\\w*)",
          "captures": {
            "1": { "name": "keyword.declaration.mist" },
            "2": { "name": "entity.name.type.class.mist" }
          }
        },
        {
          "match": "\\b(struct)\\s+([a-zA-Z_]\\w*)",
          "captures": {
            "1": { "name": "keyword.declaration.mist" },
            "2": { "name": "entity.name.type.struct.mist" }
          }
        },
        {
          "match": "\\b(abstract)\\s+([a-zA-Z_]\\w*)",
          "captures": {
            "1": { "name": "keyword.declaration.mist" },
            "2": { "name": "entity.name.type.abstract.mist" }
          }
        },

        {
          "match": "\\b(enum)\\s+([a-zA-Z_]\\w*)",
          "captures": {
            "1": { "name": "keyword.declaration.mist" },
            "2": { "name": "entity.name.type.enum.mist" }
          }
        },
        {
          "comment": "Drop destructor method declaration: return-type Drop( -> highlight Drop as destructor",
          "match": "\\b(?:void|int|uint|long|ulong|short|ushort|byte|sbyte|float|double|decimal|bool|char|string|regex|unknown|[A-Z]\\w*)(?:\\[\\])?\\s+(Drop)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.destructor.mist" }
          }
        },
        {
          "comment": "Generic method declaration: identifier<...>( — enter the type-parameter list so the params modifier (Req 17.1), Type[]:/Type[N]: pack domains (Req 17.3), and dependent annotations tokenize individually. Bare type-parameter names stay entity.name.type.parameter.mist, matching the previous coarse behavior. The lookahead keeps this scoped to a name immediately followed by <...>( on one line.",
          "begin": "([a-zA-Z_]\\w*)\\s*(<)(?=[^<>;={}]*>\\s*\\()",
          "beginCaptures": {
            "1": { "name": "entity.name.function.mist" },
            "2": { "name": "punctuation.definition.typeparameters.begin.mist" }
          },
          "end": "(>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.typeparameters.end.mist" }
          },
          "patterns": [
            {
              "comment": "params modifier on a method type parameter (Req 17.1)",
              "name": "storage.modifier.mist",
              "match": "\\bparams\\b"
            },
            {
              "comment": "Type[]:/Type[N]: pack domain annotation (Req 17.3)",
              "include": "#pack-domain-annotation"
            },
            {
              "comment": "Dependent scalar type parameter annotation within a method type-parameter list: N:int",
              "match": "([a-zA-Z_]\\w*)(:)(int|uint|long|ulong|short|ushort|byte|sbyte|bool|char)\\b",
              "captures": {
                "1": { "name": "entity.name.type.parameter.mist" },
                "2": { "name": "punctuation.separator.annotation.mist" },
                "3": { "name": "storage.type.primitive.mist" }
              }
            },
            {
              "name": "punctuation.separator.comma.mist",
              "match": ","
            },
            {
              "comment": "Bare type-parameter name (kept as a type parameter, matching the prior coarse behavior)",
              "name": "entity.name.type.parameter.mist",
              "match": "\\b[a-zA-Z_]\\w*\\b"
            }
          ]
        },
        {
          "comment": "Method declaration: type/void followed by identifier followed by (",
          "match": "\\b(?:void|int|uint|long|ulong|short|ushort|byte|sbyte|float|double|decimal|bool|char|string|regex|unknown|[A-Z]\\w*)(?:\\[\\])?\\s+([a-zA-Z_]\\w*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.mist" }
          }
        },
        {
          "comment": "Type reference with type arguments containing literals: Array<5>, Buffer<true>, Mask<0xFF>",
          "begin": "([A-Z]\\w*)\\s*(<)",
          "end": "(>)",
          "beginCaptures": {
            "1": { "name": "entity.name.type.mist" },
            "2": { "name": "punctuation.definition.typeparameters.begin.mist" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.typeparameters.end.mist" }
          },
          "patterns": [
            {
              "comment": "Spread suffix in a type-argument list: Func<TArgs..., TResult>, ICountable<TArgs...> (variadics Req 17.2)",
              "name": "keyword.operator.spread.mist",
              "match": "\\.\\.\\."
            },
            {
              "comment": "Negated integer literal in type argument position: -1, -42",
              "match": "(-)(\\d+)",
              "captures": {
                "1": { "name": "keyword.operator.arithmetic.mist" },
                "2": { "name": "constant.numeric.integer.mist" }
              }
            },
            {
              "comment": "Binary literal in type argument position: 0b1010",
              "name": "constant.numeric.binary.mist",
              "match": "0[bB][01](?:_?[01])*"
            },
            {
              "comment": "Hex literal in type argument position: 0xFF",
              "name": "constant.numeric.hex.mist",
              "match": "0[xX][0-9a-fA-F](?:_?[0-9a-fA-F])*"
            },
            {
              "comment": "Integer literal in type argument position: 5, 42",
              "name": "constant.numeric.integer.mist",
              "match": "\\b[0-9](?:_?[0-9])*\\b"
            },
            {
              "comment": "Boolean literal in type argument position: true, false",
              "name": "constant.language.boolean.mist",
              "match": "\\b(true|false)\\b"
            },
            {
              "comment": "Char literal in type argument position: 'x'",
              "name": "string.quoted.single.mist",
              "begin": "'",
              "end": "'",
              "patterns": [
                {
                  "name": "constant.character.escape.mist",
                  "match": "\\\\(\\\\|\\\"|n|r|t|0|')"
                }
              ]
            },
            {
              "comment": "Primitive type in type argument position",
              "name": "storage.type.primitive.mist",
              "match": "\\b(int|uint|long|ulong|short|ushort|byte|sbyte|float|double|decimal|bool|char|string|regex|unknown)\\b"
            },
            {
              "comment": "Type name in type argument position",
              "name": "entity.name.type.mist",
              "match": "\\b[A-Z]\\w*\\b"
            },
            {
              "comment": "Const reference or type parameter in type argument position",
              "name": "variable.other.mist",
              "match": "\\b[a-zA-Z_]\\w*\\b"
            },
            {
              "name": "punctuation.separator.comma.mist",
              "match": ","
            }
          ]
        },
        {
          "comment": "Property declaration: type followed by identifier followed by { or =>",
          "match": "\\b(?:void|int|uint|long|ulong|short|ushort|byte|sbyte|float|double|decimal|bool|char|string|regex|unknown|[A-Z]\\w*)(?:\\[\\])?\\s+([a-zA-Z_]\\w*)\\s*(?=\\{|=>)",
          "captures": {
            "1": { "name": "entity.name.variable.property.mist" }
          }
        },
        {
          "comment": "Field declaration: PascalCase type (optional ? and []) followed by identifier followed by ;",
          "match": "\\b([A-Z]\\w*)(\\?)?(?:(\\[\\]))?\\s+([a-zA-Z_]\\w*)\\s*(?=;)",
          "captures": {
            "1": { "name": "entity.name.type.mist" },
            "2": { "name": "punctuation.nullable.mist" },
            "3": { "name": "punctuation.squarebracket.mist" },
            "4": { "name": "variable.other.field.mist" }
          }
        }
      ]
    },
    "property-initializer-names": {
      "comment": "Property name in initializer block (including anonymous types): identifier = (but not ==)",
      "match": "(\\b[a-zA-Z_]\\w*)\\s*(=)(?!=)",
      "captures": {
        "1": { "name": "variable.other.property.mist" },
        "2": { "name": "keyword.operator.assignment.property.mist" }
      }
    },
    "operators": {
      "patterns": [
        {
          "comment": "Spread / decompose suffix operator: TArgs..., args..., Item... (variadics Req 17.2). Listed before punctuation so the three dots read as one spread token distinct from the identifier, rather than a `..` range plus `.` accessor.",
          "name": "keyword.operator.spread.mist",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.void-coalescing-assignment.mist",
          "match": "\\?\\?="
        },
        {
          "name": "keyword.operator.void-coalescing.mist",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.void-conditional.mist",
          "match": "\\?\\."
        },
        {
          "comment": "Range operator: matched before the accessor '.' so 'a..b', 'a..', '..b', '..', and slice-pattern '..' inside list patterns all scope as an operator",
          "name": "keyword.operator.mist",
          "match": "\\.\\."
        },
        {
          "comment": "Index-from-end operator: ^expr",
          "name": "keyword.operator.mist",
          "match": "\\^"
        },
        {
          "comment": "Type conversion operator: expr as Type — highlight keyword and following type",
          "match": "\\b(as)\\s+(?:(int|uint|long|ulong|short|ushort|byte|sbyte|float|double|decimal|bool|char|string|regex|unknown)|([A-Z]\\w*))",
          "captures": {
            "1": { "name": "keyword.operator.type.mist" },
            "2": { "name": "storage.type.primitive.mist" },
            "3": { "name": "entity.name.type.mist" }
          }
        },
        {
          "comment": "Fallback: bare as keyword in expression context (e.g., before generic types)",
          "name": "keyword.operator.type.mist",
          "match": "\\b(as)\\b"
        },
        {
          "name": "keyword.operator.comparison.mist",
          "match": "\\b(is)\\b|==|!=|<=|>=|<|>"
        },
        {
          "match": "(?<=\\w|\\]|\\))\\s*(\\|)\\s*(?=\\w)",
          "captures": {
            "1": { "name": "keyword.operator.type.union.mist" }
          }
        },
        {
          "name": "keyword.operator.logical.mist",
          "match": "\\b(and|or|not)\\b|&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.mist",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.arrow.mist",
          "match": "=>"
        },
        {
          "name": "keyword.operator.assignment.mist",
          "match": "="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.accessor.mist", "match": "\\." },
        { "name": "punctuation.separator.comma.mist", "match": "," },
        { "name": "punctuation.terminator.statement.mist", "match": ";" }
      ]
    }
  }
}
