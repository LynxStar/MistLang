using Standard;

namespace Refusal;

public class Filler
{
    public static pure int Fill(Span<int, 2> s)
    {
        // REFUSE: MIST_PA_PURE_SCOPE_WRITES
        s[0] = 1;
        return 1;
    }
}

public class Probe
{
    public static void Main()
    {
        int[] xs = [1, 2];
        Span<int, 2> s = new Span<int, 2>(xs);
        var r = Filler.Fill(s);
        Console.WriteLine("unreachable");
    }
}
