namespace Standard;

intrinsic public readonly owned struct Char : IClonable<Char>
{
    // IClonable base case — value-type identity copy (Requirement 8.6)
    intrinsic public pure owned Char Clone();

    // Comparison and equality operators — Requirement 3.7
    intrinsic public pure static Boolean operator ==(Char a, Char b);
    intrinsic public pure static Boolean operator !=(Char a, Char b);
    intrinsic public pure static Boolean operator <(Char a, Char b);
    intrinsic public pure static Boolean operator >(Char a, Char b);
    intrinsic public pure static Boolean operator <=(Char a, Char b);
    intrinsic public pure static Boolean operator >=(Char a, Char b);

    // Implicit widening conversions
    intrinsic public pure static implicit operator UInt16(Char value);
    intrinsic public pure static implicit operator Int32(Char value);
    intrinsic public pure static implicit operator UInt32(Char value);
    intrinsic public pure static implicit operator Int64(Char value);
    intrinsic public pure static implicit operator UInt64(Char value);
    intrinsic public pure static implicit operator Single(Char value);
    intrinsic public pure static implicit operator Double(Char value);
    intrinsic public pure static implicit operator Decimal(Char value);
    intrinsic public pure Int32 CompareTo(Char other);
    intrinsic public pure static Boolean IsLetterOrDigit(Char value);
    intrinsic public pure static Boolean IsWhiteSpace(Char value);
    intrinsic public pure static Boolean IsDigit(Char value);
    intrinsic public pure static Boolean IsAsciiDigit(Char value);
    intrinsic public pure static Boolean IsAsciiLetter(Char value);
    intrinsic public pure static Boolean IsAsciiLetterOrDigit(Char value);
    intrinsic public pure static Boolean IsUpper(Char value);
    intrinsic public pure static Char ToUpperInvariant(Char value);
    intrinsic public pure static Char ToLowerInvariant(Char value);
}