using Standard;

namespace Refusal;

public abstract IThing
{
    readonly int Peek();
    int Poke();
}

public class Thing : IThing
{
    int count;

    // REFUSE: MIST_PA_READONLY_CONTRACT_NOT_MET
    public int Peek()
    {
        count = count + 1;
        return count;
    }

    public int Poke()
    {
        count = count + 1;
        return count;
    }
}

public class Probe
{
    public static void Main()
    {
        Console.WriteLine("unreachable");
    }
}
