using Standard;

namespace Snippets;

public linear class Connection
{
    int Id;
    public Connection(int id) { this.Id = id; }
    public int GetId() { return Id; }
    public void Drop() { Console.WriteLine($"Connection({Id}).Drop()"); }
}

// An affine box requires 'where T : affine'
public affine class AffineHolder<T> where T : affine
{
    T Value;
    public AffineHolder(T value) { this.Value = value; }
    public void Drop() { Console.WriteLine("AffineHolder<T>.Drop()"); }
}

// A relevant box requires 'where T : relevant'
public relevant class RelevantHolder<T> where T : relevant
{
    T Value;
    bool Dropped;
    public RelevantHolder(T value) { this.Value = value; this.Dropped = false; }
    public void Drop()
    {
        if (Dropped) { return; }
        this.Dropped = true;
        Console.WriteLine("RelevantHolder<T>.Drop()");
    }
}

public class Program
{
    public static void Main()
    {
        // Linear satisfies affine: exactly-once ⊆ at-most-once
        with (new AffineHolder<Connection>(new Connection(1)))
        {
            Console.WriteLine("Linear type in affine box");
        }

        // Linear satisfies relevant: exactly-once ⊆ at-least-once
        var r = new RelevantHolder<Connection>(new Connection(2));
        Console.WriteLine("Linear type in relevant box");
    }
}
