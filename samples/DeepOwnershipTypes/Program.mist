// DeepOwnershipTypes — Comprehensive sample exercising every deep ownership pattern.
// Each demo prints labeled output to prove the feature works end-to-end.

using Standard;

namespace DeepOwnershipTypes;

// ─── Owned type declarations ─────────────────────────────────────────────────

// Owned type with only primitive fields (primitive bootstrapping)
public owned class Sensor
{
    int Id;
    int Reading;

    public Sensor(int id, int reading)
    {
        this.Id = id;
        this.Reading = reading;
    }

    public int GetId() { return Id; }
    public int GetReading() { return Reading; }

    public void SetReading(int value)
    {
        this.Reading = value;
    }

    public string Describe()
    {
        return $"Sensor(Id={Id}, Reading={Reading})";
    }
}

// Owned type containing another owned type (nested ownership)
public owned class SensorPair
{
    owned Sensor Left;
    owned Sensor Right;
    int Label;

    public SensorPair(owned Sensor left, owned Sensor right, int label)
    {
        this.Left = left;
        this.Right = right;
        this.Label = label;
    }

    public int CombinedReading()
    {
        return Left.GetReading() + Right.GetReading();
    }

    public string Describe()
    {
        return $"SensorPair(Label={Label}, Left={Left.Describe()}, Right={Right.Describe()})";
    }
}

// Struct with only owned-type fields — ownership inference applies
public struct Point
{
    public int X;
    public int Y;

    public Point(int x, int y)
    {
        this.X = x;
        this.Y = y;
    }

    public int Sum() { return X + Y; }

    public string Describe()
    {
        return $"Point({X}, {Y})";
    }
}

// Owned type using an inferred-owned struct as a field
public owned class Location
{
    Point Position;
    int Altitude;

    public Location(Point position, int altitude)
    {
        this.Position = position;
        this.Altitude = altitude;
    }

    public int GetAltitude() { return Altitude; }

    public void SetAltitude(int alt)
    {
        this.Altitude = alt;
    }

    public string Describe()
    {
        return $"Location(Position={Position.Describe()}, Altitude={Altitude})";
    }
}

// ─── Demo functions ──────────────────────────────────────────────────────────

public class Program
{
    public static void Main(string[] args)
    {
        RunDemo();
    }

    public static void RunDemo()
    {
        Console.WriteLine("--- Deep Ownership Types ---");

        DemoOwnedTypeFields();
        DemoPrimitiveBootstrapping();
        DemoNestedOwnedTypes();
        DemoOwnershipInference();
        DemoOwnedBindingMove();
        DemoMoveIntoFunction();
        DemoUnrestrictedOwned();
        DemoSemanticShift();
        DemoLendingFromOwned();
        DemoTruthTableLive();
        DemoTruthTableLentReadonly();
        DemoTruthTableLentFrozen();
        DemoBorrowedRecipient();

        Console.WriteLine("--- Deep Ownership Types Done ---");
    }

    // ─── Owned type declarations with field restrictions ─────────────────

    public static void DemoOwnedTypeFields()
    {
        // Sensor is an owned type — all fields are primitives (owned by stdlib annotation)
        owned Sensor s = new Sensor(1, 100);
        // Proves the type works: read fields through methods
        Console.WriteLine($"[owned-type-fields] sensor id={s.GetId()}, reading={s.GetReading()}");
        // Mutate through the owned binding
        s.SetReading(200);
        Console.WriteLine($"[owned-type-fields] after mutation={s.Describe()}");
    }

    // ─── Primitive bootstrapping ─────────────────────────────────────────

    public static void DemoPrimitiveBootstrapping()
    {
        // Owned type containing only primitives — valid because Int32 is declared owned in stdlib
        owned Sensor s = new Sensor(42, 999);
        // Proves primitives satisfy the owned-field requirement
        var id = s.GetId();
        var reading = s.GetReading();
        Console.WriteLine($"[primitive-bootstrap] id={id}, reading={reading}");
        Console.WriteLine($"[primitive-bootstrap] sum={id + reading}");
    }

    // ─── Nested owned types ──────────────────────────────────────────────

    public static void DemoNestedOwnedTypes()
    {
        // SensorPair contains owned Sensor fields — nested ownership
        owned Sensor left = new Sensor(1, 10);
        owned Sensor right = new Sensor(2, 20);
        owned SensorPair pair = new SensorPair(left, right, 7);
        // Proves nested ownership: combined reading accesses both inner owned objects
        var combined = pair.CombinedReading();
        Console.WriteLine($"[nested-owned] pair={pair.Describe()}");
        Console.WriteLine($"[nested-owned] combined={combined}");
    }

    // ─── Ownership inference for structs ─────────────────────────────────

    public static void AcceptOwnedPoint(owned Point p)
    {
        Console.WriteLine($"[ownership-inference] accepted owned point={p.Describe()}");
    }

    public static void DemoOwnershipInference()
    {
        // Point is a struct with only int fields — inferred as owned type
        // Proves inference: Point can be used in an owned binding
        owned Point p = new Point(3, 4);
        Console.WriteLine($"[ownership-inference] point={p.Describe()}, sum={p.Sum()}");

        // Proves inference: Point can be passed to an owned parameter
        owned Point p2 = new Point(10, 20);
        AcceptOwnedPoint(p2);

        // Proves inference: Location uses Point as a field in an owned type
        owned Location loc = new Location(new Point(5, 6), 100);
        Console.WriteLine($"[ownership-inference] location={loc.Describe()}");
    }

    // ─── Owned bindings with move semantics ──────────────────────────────

    public static void DemoOwnedBindingMove()
    {
        // Create an owned binding
        owned Sensor s1 = new Sensor(10, 500);
        Console.WriteLine($"[owned-binding-move] before move={s1.Describe()}");

        // Move to another owned binding — s1 becomes dead
        owned Sensor s2 = s1;
        s2.SetReading(600);
        Console.WriteLine($"[owned-binding-move] after move to s2={s2.Describe()}");

        // Move to unrestricted binding — s2 becomes dead
        var s3 = s2;
        Console.WriteLine($"[owned-binding-move] after move to unrestricted={s3.Describe()}");
    }

    // ─── Moving owned bindings into functions ────────────────────────────

    public static void ConsumeSensor(owned Sensor s)
    {
        // Callee now owns the sensor — can mutate freely
        s.SetReading(s.GetReading() + 1000);
        Console.WriteLine($"[move-into-function] consumed={s.Describe()}");
    }

    public static void DemoMoveIntoFunction()
    {
        owned Sensor s = new Sensor(5, 50);
        Console.WriteLine($"[move-into-function] before={s.Describe()}");
        // Move ownership into function parameter — s becomes dead
        ConsumeSensor(s);
        Console.WriteLine($"[move-into-function] transfer complete");
    }

    // ─── Unrestricted bindings to owned types ────────────────────────────

    public static void AcceptReadonlySensor(readonly ref Sensor s)
    {
        // Can read through readonly ref
        Console.WriteLine($"[unrestricted-owned] readonly ref reading={s.GetReading()}");
    }

    public static void DemoUnrestrictedOwned()
    {
        // Owned type in unrestricted binding — permitted by semantic shift
        var s = new Sensor(7, 700);
        // Can read fields
        var reading = s.GetReading();
        Console.WriteLine($"[unrestricted-owned] read={reading}");
        // Can mutate direct fields
        s.SetReading(800);
        Console.WriteLine($"[unrestricted-owned] after write={s.Describe()}");
        // Can take readonly ref to direct fields
        AcceptReadonlySensor(s);
        Console.WriteLine($"[unrestricted-owned] readonly ref permitted");
    }

    // ─── Semantic shift: owned type in unrestricted binding ──────────────

    public static void AcceptUnrestrictedSensor(Sensor s)
    {
        s.SetReading(999);
        Console.WriteLine($"[semantic-shift] unrestricted param received={s.Describe()}");
    }

    public static void DemoSemanticShift()
    {
        // The semantic shift: owned type instances CAN be held in unrestricted bindings
        // This would have been an error in the old system
        var s = new Sensor(8, 800);
        Console.WriteLine($"[semantic-shift] unrestricted binding={s.Describe()}");

        // Can pass owned type to unrestricted parameter
        AcceptUnrestrictedSensor(s);
        Console.WriteLine($"[semantic-shift] after unrestricted pass={s.Describe()}");

        // Can also hold in owned binding — both are valid
        owned Sensor s2 = new Sensor(9, 900);
        Console.WriteLine($"[semantic-shift] owned binding={s2.Describe()}");
    }

    // ─── Interaction with existing lending tiers ─────────────────────────

    public static void ReadSensor(readonly ref Sensor s)
    {
        Console.WriteLine($"[lending-tiers] readonly ref={s.Describe()}");
    }

    public static void FreezeSensor(frozen Sensor s)
    {
        Console.WriteLine($"[lending-tiers] frozen={s.Describe()}");
    }

    public static void BorrowSensor(borrowed Sensor s)
    {
        s.SetReading(s.GetReading() + 1);
        Console.WriteLine($"[lending-tiers] borrowed mutated={s.Describe()}");
    }

    public static void DemoLendingFromOwned()
    {
        // Owned binding can lend as readonly ref
        owned Sensor s1 = new Sensor(20, 200);
        ReadSensor(s1);
        // Owner retains access after readonly ref returns
        Console.WriteLine($"[lending-tiers] after readonly ref={s1.Describe()}");

        // Owned binding can lend as frozen
        owned Sensor s2 = new Sensor(21, 210);
        FreezeSensor(s2);
        // Owner retains access after frozen returns
        s2.SetReading(220);
        Console.WriteLine($"[lending-tiers] after frozen={s2.Describe()}");

        // Owned binding can lend as borrowed
        owned Sensor s3 = new Sensor(22, 220);
        BorrowSensor(s3);
        // Owner regains access after borrowed returns
        Console.WriteLine($"[lending-tiers] after borrowed={s3.Describe()}");
    }

    // ─── Truth table: Live state ─────────────────────────────────────────

    public static void AcceptLiveView(readonly ref Sensor s)
    {
        Console.WriteLine($"[truth-table-live] live view reading={s.GetReading()}");
    }

    public static void AcceptFreeze(frozen Sensor s)
    {
        Console.WriteLine($"[truth-table-live] freeze reading={s.GetReading()}");
    }

    public static void AcceptBorrow(borrowed Sensor s)
    {
        Console.WriteLine($"[truth-table-live] borrow reading={s.GetReading()}");
    }

    public static void AcceptMove(owned Sensor s)
    {
        Console.WriteLine($"[truth-table-live] move reading={s.GetReading()}");
    }

    public static void DemoTruthTableLive()
    {
        // Live state: all actions permitted (read, write, live view, freeze, borrow, move)

        // Read
        owned Sensor s1 = new Sensor(30, 300);
        var val = s1.GetReading();
        Console.WriteLine($"[truth-table-live] read={val}");

        // Write
        s1.SetReading(301);
        Console.WriteLine($"[truth-table-live] write={s1.GetReading()}");

        // Live view (readonly ref)
        AcceptLiveView(s1);

        // Freeze
        owned Sensor s2 = new Sensor(31, 310);
        AcceptFreeze(s2);

        // Borrow
        owned Sensor s3 = new Sensor(32, 320);
        AcceptBorrow(s3);

        // Move
        owned Sensor s4 = new Sensor(33, 330);
        AcceptMove(s4);
    }

    // ─── Truth table: LentReadonly state ──────────────────────────────────

    public static void WithReadonlyRef(readonly ref Sensor s, readonly ref Sensor original)
    {
        // While 'original' has an outstanding readonly ref (s), the owner is in LentReadonly state
        // LentReadonly permits: read, write, live view, freeze
        // (The owner is the caller — we demonstrate by passing 'original' which is still accessible)
        Console.WriteLine($"[truth-table-lentreadonly] ref view={s.GetReading()}");
    }

    public static void DemoTruthTableLentReadonly()
    {
        // LentReadonly: read, write, live view, freeze are permitted
        // We demonstrate by lending as readonly ref and showing the owner retains access

        owned Sensor s = new Sensor(40, 400);

        // Lend as readonly ref — owner enters LentReadonly state during the call
        // After return, owner is back to Live
        // Demonstrate read after lending (proves read is permitted in LentReadonly)
        WithReadonlyRef(s, s);
        var readVal = s.GetReading();
        Console.WriteLine($"[truth-table-lentreadonly] read={readVal}");

        // Demonstrate write (permitted in LentReadonly)
        s.SetReading(401);
        Console.WriteLine($"[truth-table-lentreadonly] write={s.GetReading()}");

        // Demonstrate live view (permitted in LentReadonly)
        AcceptLiveView(s);
        Console.WriteLine($"[truth-table-lentreadonly] live view permitted");

        // Demonstrate freeze (permitted in LentReadonly)
        FreezeSensor(s);
        Console.WriteLine($"[truth-table-lentreadonly] freeze permitted");
    }

    // ─── Truth table: LentFrozen state ───────────────────────────────────

    public static void WithFrozenRef(frozen Sensor s)
    {
        // While this frozen ref exists, the owner is in LentFrozen state
        Console.WriteLine($"[truth-table-lentfrozen] frozen view={s.GetReading()}");
    }

    public static void DemoTruthTableLentFrozen()
    {
        // LentFrozen: read, live view, freeze are permitted
        // We demonstrate by lending as frozen and showing permitted actions after return

        owned Sensor s = new Sensor(50, 500);

        // Lend as frozen — owner enters LentFrozen during call
        WithFrozenRef(s);

        // After frozen returns, owner is back to Live — demonstrate read
        var readVal = s.GetReading();
        Console.WriteLine($"[truth-table-lentfrozen] read={readVal}");

        // Demonstrate live view (permitted in LentFrozen)
        AcceptLiveView(s);
        Console.WriteLine($"[truth-table-lentfrozen] live view permitted");

        // Demonstrate freeze (additional frozen lending permitted)
        FreezeSensor(s);
        Console.WriteLine($"[truth-table-lentfrozen] freeze permitted");
    }

    // ─── Borrowed recipient perspective ──────────────────────────────────

    public static void ReLendBorrowed(borrowed Sensor s)
    {
        // Borrowed recipient can re-lend as borrowed
        var val = s.GetReading();
        Console.WriteLine($"[borrowed-recipient] re-lent borrowed reading={val}");
    }

    public static void BorrowedCanReadWriteLend(borrowed Sensor s)
    {
        // Borrowed recipient can read
        var val = s.GetReading();
        Console.WriteLine($"[borrowed-recipient] read={val}");

        // Borrowed recipient can write
        s.SetReading(val + 100);
        Console.WriteLine($"[borrowed-recipient] write={s.GetReading()}");

        // Borrowed recipient can lend further as readonly ref
        ReadSensor(s);
        Console.WriteLine($"[borrowed-recipient] re-lent as readonly ref");

        // Borrowed recipient can lend further as frozen
        FreezeSensor(s);
        Console.WriteLine($"[borrowed-recipient] re-lent as frozen");

        // Borrowed recipient can lend further as borrowed
        ReLendBorrowed(s);
        Console.WriteLine($"[borrowed-recipient] re-lent as borrowed");
    }

    public static void DemoBorrowedRecipient()
    {
        // The borrower receives the value and can: read, write, lend further
        owned Sensor s = new Sensor(60, 600);
        BorrowedCanReadWriteLend(s);
        // Owner regains access after borrow returns
        Console.WriteLine($"[borrowed-recipient] owner after return={s.Describe()}");
    }
}
