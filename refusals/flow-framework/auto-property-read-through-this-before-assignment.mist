using Standard;

namespace Refusal;

public class Dog
{
    public string Name;

    public Dog(string name)
    {
        Name = name;
    }
}

public class Account
{
    public Dog Pet { get; set; }

    public Account()
    {
        // REFUSE: MIST_PA_FIELD_READ_BEFORE_ASSIGNMENT
        Console.WriteLine(this.Pet.Name);
        Pet = new Dog("a");
    }
}

public class Probe
{
    public static void Main()
    {
        var account = new Account();
        Console.WriteLine("unreachable");
    }
}
