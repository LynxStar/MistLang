using Standard;

namespace Refusal;

public class Tally
{
    public int total;

    public Tally(int start)
    {
        total = start;
        Log.Count();
    }
}

public class Log
{
    public static int seen;

    public static void Count()
    {
        seen = seen + 1;
    }
}

public class Factory
{
    public readonly int Make()
    {
        // REFUSE: MIST_PA_READONLY_CONTEXT_ALLOCATES_MUTABLE
        var t = new Tally(1);
        return t.total;
    }
}

public class Probe
{
    public static void Main()
    {
        var f = new Factory();
        var m = f.Make();
        Console.WriteLine("unreachable");
    }
}
