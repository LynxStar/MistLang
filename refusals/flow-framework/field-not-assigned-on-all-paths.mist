using Standard;

namespace Refusal;

public class Dog
{
    public string Name;

    public Dog(string name)
    {
        Name = name;
    }
}

public class Account
{
    public Dog owner;

    // REFUSE: MIST_PA_FIELD_NOT_DEFINITELY_ASSIGNED
    public Account(bool flag)
    {
        if(flag)
        {
            owner = new Dog("a");
        }
    }
}

public class Probe
{
    public static void Main()
    {
        var account = new Account(true);
        Console.WriteLine("unreachable");
    }
}
