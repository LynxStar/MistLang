using Standard;

public class Program
{
    public static async int SlowCompute()
    {
        Task.Yield();  // explicit yield point
        return 42;
    }

    public static async void Main(string[] args)
    {
        // Each async method invocation is a yield point — the scheduler
        // may run other tasks before resuming here
        var task = SlowCompute();

        // Explicit yield: give other tasks a chance to run
        Task.Yield();

        var result = await task;
        Console.WriteLine(result);
    }
}
