using Standard;

namespace Refusal;

public class Bounded
{
    public int Size;

    public Bounded(int size) where size > 0
    {
        Size = size;
    }
}

public class Empty : Bounded
{
    // REFUSE: MIST_PA_CONSTRAINT_VIOLATED
    public Empty() : base(0)
    {
    }
}

public class Probe
{
    public static void Main()
    {
        var e = new Empty();
        Console.WriteLine(e.Size);
    }
}
