// Circle — Demonstrates a class implementing an abstract type with auto-properties and computed properties.

using Standard;

namespace ShapeAbstracts;

public class Circle : IShape
{
    // Auto-property implementing abstract type property
    public string Name { get; }

    // Auto-property for radius
    public int Radius { get; set; }

    // Computed property — derives value from Radius
    public int Diameter => Radius * 2;

    public Circle(int radius)
    {
        this.Name = "Circle";
        this.Radius = radius;
    }

    public string Describe()
    {
        return $"Circle(radius={Radius})";
    }

    public int Area()
    {
        return Radius * Radius;
    }
}
