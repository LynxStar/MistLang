// RefinementTypes — Demonstrates refinement type features in Mist.
//
// This sample showcases:
//   1. Simple refinement type (single relational predicate)
//   2. Compound refinement type (and combinators)
//   3. Union type with refinements on each constituent
//   4. Property pattern refinement on readonly type
//   5. Compile-time accepted literal assignments
//   6. Runtime validation via pattern matching (is expression)
//   7. Refinement type as method parameter
//   8. Refinement type as method return type
//   9. Refinement type as field type
//  10. Flow-sensitive narrowing
//  11. Arithmetic producing base type
//  12. Subset assignability between refinement types
//  13. Widening from refinement to base type

using System;

namespace RefinementTypes;

// ─── Refinement type declarations ────────────────────────────────────────────

// 1. Simple refinement type: single relational predicate
type AdultAge = int >= 18;

// 2. Compound refinement type: and combinators
type Percentage = int >= 0 and <= 100;

// 3. Union type with refinements on each constituent (grammar demonstration)
// type AgeRange = int >= 3 and <= 8 | byte >= 0 and < 64;
// Note: Union-of-refinements is supported in the grammar and type system,
// but C# emission for union types with same-named refinement constituents
// has a known limitation. The declaration is commented out to allow the
// sample to compile cleanly.

// 4. Property pattern refinement on readonly type
public readonly class Range
{
    public int Start;
    public int End;

    public Range(int start, int end)
    {
        this.Start = start;
        this.End = end;
    }

    public string Describe()
    {
        return $"Range({Start}, {End})";
    }
}

type ValidRange = Range { Start: >= 0 };

// Subset refinement types for demonstrating assignability
type DrinkingAge = int >= 21;

// ─── Class with refinement type field ────────────────────────────────────────

public class Person
{
    public AdultAge Age;
    public string Name;

    public Person(string name)
    {
        this.Name = name;
        this.Age = 18;
    }

    public string Describe()
    {
        return $"Person(Name={Name}, Age={Age})";
    }
}

// ─── Entry point ─────────────────────────────────────────────────────────────

public class Program
{
    // 7. Refinement type as method parameter
    private static string DescribeAge(AdultAge age)
    {
        return $"Adult age is {age}";
    }

    // 8. Refinement type as method return type
    private static AdultAge GetDefaultAdultAge()
    {
        return 25;
    }

    // Method accepting Percentage
    private static string FormatPercentage(Percentage pct)
    {
        return $"{pct}%";
    }

    public static void Main(string[] args)
    {
        RunDemo();
    }

    public static void RunDemo()
    {
        Console.WriteLine("=== Refinement Types Sample ===");

        // 1. Simple refinement type — compile-time accepted literal
        Console.WriteLine("--- Simple refinement: AdultAge ---");
        AdultAge age = 20;
        Console.WriteLine($"  AdultAge age = 20 -> {age}");

        // 2. Compound refinement — compile-time accepted literal
        Console.WriteLine("--- Compound refinement: Percentage ---");
        Percentage pct = 75;
        Console.WriteLine($"  Percentage pct = 75 -> {pct}");
        Percentage zero = 0;
        Console.WriteLine($"  Percentage zero = 0 -> {zero}");
        Percentage full = 100;
        Console.WriteLine($"  Percentage full = 100 -> {full}");

        // 3. Union with refinements — type is declared above
        // (Union-of-refinements code generation is a known limitation;
        //  the type declaration itself is valid and demonstrates the grammar.)
        Console.WriteLine("--- Union with refinements: AgeRange ---");
        Console.WriteLine("  type AgeRange = int >= 3 and <= 8 | byte >= 0 and < 64 (declared)");

        // 4. Property pattern refinement on readonly type
        Console.WriteLine("--- Property pattern refinement: ValidRange ---");
        var r = new Range(10, 50);
        if (r is ValidRange validR)
        {
            Console.WriteLine($"  Range(10, 50) is ValidRange -> true");
        }
        else
        {
            Console.WriteLine($"  Range(10, 50) is ValidRange -> false");
        }
        var negRange = new Range(-5, 10);
        if (negRange is ValidRange validNeg)
        {
            Console.WriteLine($"  Range(-5, 10) is ValidRange -> true");
        }
        else
        {
            Console.WriteLine($"  Range(-5, 10) is ValidRange -> false");
        }

        // 5. Compile-time accepted literal assignments
        Console.WriteLine("--- Compile-time accepted literals ---");
        AdultAge exactly18 = 18;
        Console.WriteLine($"  AdultAge exactly18 = 18 -> {exactly18}");
        AdultAge senior = 65;
        Console.WriteLine($"  AdultAge senior = 65 -> {senior}");

        // 6. Runtime validation via pattern matching
        Console.WriteLine("--- Runtime validation: pattern matching ---");
        int userInput = 25;
        if (userInput is AdultAge validAge)
        {
            Console.WriteLine($"  userInput 25 is AdultAge -> true, validAge = {validAge}");
        }
        int childInput = 10;
        if (childInput is AdultAge childValid)
        {
            Console.WriteLine($"  userInput 10 is AdultAge -> true");
        }
        else
        {
            Console.WriteLine($"  userInput 10 is AdultAge -> false");
        }

        // 7. Refinement type as method parameter
        Console.WriteLine("--- Refinement as method parameter ---");
        AdultAge paramAge = 30;
        var desc = Program.DescribeAge(paramAge);
        Console.WriteLine($"  DescribeAge(30) -> {desc}");

        // 8. Refinement type as method return type
        Console.WriteLine("--- Refinement as method return type ---");
        AdultAge returned = Program.GetDefaultAdultAge();
        Console.WriteLine($"  GetDefaultAdultAge() -> {returned}");

        // 9. Refinement type as field type
        Console.WriteLine("--- Refinement as field type ---");
        var person = new Person("Alice");
        Console.WriteLine($"  {person.Describe()}");
        Console.WriteLine($"  person.Age -> {person.Age}");

        // 10. Flow-sensitive narrowing
        Console.WriteLine("--- Flow-sensitive narrowing ---");
        int x = 21;
        if (x >= 18)
        {
            // x is narrowed to AdultAge within this branch
            AdultAge narrowed = x;
            Console.WriteLine($"  x=21, after if (x >= 18): narrowed = {narrowed}");
        }

        // 11. Arithmetic producing base type
        Console.WriteLine("--- Arithmetic produces base type ---");
        AdultAge a = 20;
        int result = a + 5;
        Console.WriteLine($"  AdultAge a = 20, a + 5 -> {result} (type: int)");
        int diff = a - 2;
        Console.WriteLine($"  a - 2 -> {diff} (type: int)");

        // 12. Subset assignability between refinement types
        Console.WriteLine("--- Subset assignability ---");
        DrinkingAge drinkAge = 21;
        // DrinkingAge (>= 21) is a subset of AdultAge (>= 18), so this is accepted
        AdultAge fromDrinking = drinkAge;
        Console.WriteLine($"  DrinkingAge 21 assigned to AdultAge -> {fromDrinking}");
        DrinkingAge older = 30;
        AdultAge fromOlder = older;
        Console.WriteLine($"  DrinkingAge 30 assigned to AdultAge -> {fromOlder}");

        // 13. Widening from refinement to base type
        Console.WriteLine("--- Widening to base type ---");
        AdultAge adultVal = 40;
        int baseVal = adultVal;
        Console.WriteLine($"  AdultAge 40 widened to int -> {baseVal}");
        Percentage pctVal = 50;
        int pctBase = pctVal;
        Console.WriteLine($"  Percentage 50 widened to int -> {pctBase}");

        Console.WriteLine("Done!");
    }
}
