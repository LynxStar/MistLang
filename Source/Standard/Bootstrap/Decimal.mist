namespace Standard;

intrinsic public readonly struct Decimal
{
    // Binary arithmetic operators — Requirement 3.1
    intrinsic public static Decimal operator +(Decimal a, Decimal b);
    intrinsic public static Decimal operator -(Decimal a, Decimal b);
    intrinsic public static Decimal operator *(Decimal a, Decimal b);
    intrinsic public static Decimal operator /(Decimal a, Decimal b);
    intrinsic public static Decimal operator %(Decimal a, Decimal b);

    // Comparison operators — Requirement 3.2
    intrinsic public static Boolean operator <(Decimal a, Decimal b);
    intrinsic public static Boolean operator >(Decimal a, Decimal b);
    intrinsic public static Boolean operator <=(Decimal a, Decimal b);
    intrinsic public static Boolean operator >=(Decimal a, Decimal b);
    intrinsic public static Boolean operator ==(Decimal a, Decimal b);
    intrinsic public static Boolean operator !=(Decimal a, Decimal b);

    // Unary negation — Requirement 3.3
    intrinsic public static Decimal operator -(Decimal a);
}
