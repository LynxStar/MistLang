using Standard;

namespace Refusal;

type Percentage = int >= 0 and <= 100;
type Digit = int >= 0 and <= 9;

public class Probe
{
    public static int Narrow(Percentage p)
    {
        // REFUSE: MIST_PA_REFINEMENT_NOT_IMPLIED
        Digit d = p;
        return d;
    }

    public static void Main()
    {
        Percentage p = 50;
        Console.WriteLine(Narrow(p));
        Console.WriteLine("unreachable");
    }
}
