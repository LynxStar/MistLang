using System;

namespace Standard;

extension(Exception self)
{
    intrinsic public pure static Result<Decimal, Exception> CatchDecimal(pure func<Decimal, Decimal, Decimal> operation, Decimal a, Decimal b);
    intrinsic public static Result<TResult, Exception> Catch<params TArgs, TResult>(Func<TArgs..., TResult> operation, params TArgs args);
}

public sealed class ExceptionError : Error
{
    public Exception Original { get; }
    public string Message => Original.Message;

    public readonly static implicit operator ExceptionError(Exception original)
    {
        return new ExceptionError(original);
    }

    public readonly ExceptionError(Exception original)
    {
        Original = original;
    }
}