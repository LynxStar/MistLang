using Standard;

namespace Refusal;

public class Shelf
{
    public int this[int row, int column]
    {
        get { return row + column; }
    }

    public int this[byte slot]
    {
        get { return slot; }
    }
}

public class Probe
{
    public static void Main()
    {
        var shelf = new Shelf();
        // REFUSE: MIST_PA_NO_IMPLICIT_CONVERSION
        Console.WriteLine(shelf[300]);
        Console.WriteLine("unreachable");
    }
}
