using Standard;

namespace Refusal;

public class Ledger
{
    private int count = 9;

    public int Count
    {
        get { return count; }
    }

    public int this[int entry] where entry >= 0 and < 3
    {
        get { return entry; }
    }
}

public class Probe
{
    public static void Main()
    {
        var ledger = new Ledger();
        if (ledger is [_, _, _, _, _, _, _, _,
            // REFUSE: MIST_PA_CONSTRAINT_VIOLATED
            var last])
        {
            Console.WriteLine(last);
        }
    }
}
