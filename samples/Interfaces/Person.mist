using Standard;

namespace Interfaces;

public class Person : IDescribable
{
    private string name;
    private int age;

    public Person(string name, int age)
    {
        this.name = name;
        this.age = age;
    }

    public string GetName()
    {
        return name;
    }

    public string Describe()
    {
        return $"Person: {name}, age {age}";
    }
}
