using Standard;

namespace Refusal;

public class Ledger
{
    private bool small = true;

    public int Count
    {
        get
        {
            if (small)
            {
                return 3;
            }

            return 5;
        }
    }

    public int this[int entry] where entry >= 0 and < Count
    {
        get { return entry; }
    }
}

public class Probe
{
    public static void Main()
    {
        var ledger = new Ledger();
        // REFUSE: MIST_PA_CONSTRAINT_UNPROVEN
        int maybe = ledger[4];
        Console.WriteLine(maybe);
    }
}
