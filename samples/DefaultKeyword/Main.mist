// DefaultKeyword — Demonstrates the default keyword for value initialization.

using Standard;

namespace DefaultKeyword;

// ─── Simple class with defaultable fields ────────────────────────────────────

public class Config
{
    public int MaxRetries;
    public bool Verbose;
    public string Label;

    public string Describe()
    {
        return $"Config(MaxRetries={MaxRetries}, Verbose={Verbose}, Label={Label})";
    }
}

// ─── Class with field initializers ───────────────────────────────────────────

public class Settings
{
    public int Timeout = 30;
    public bool Enabled = true;
    public string Mode = "auto";

    public string Describe()
    {
        return $"Settings(Timeout={Timeout}, Enabled={Enabled}, Mode={Mode})";
    }
}

// ─── Class with an explicit default block overriding field values ─────────────

public class AppState
{
    public int ErrorCount;
    public bool Ready;
    public string Status;

    default {
        ErrorCount = 5
        Ready = true
        Status = "initialized"
    }

    public string Describe()
    {
        return $"AppState(ErrorCount={ErrorCount}, Ready={Ready}, Status={Status})";
    }
}

// ─── Readonly struct with constructor AND default block ──────────────────────

public class Payload
{
    public int Value;

    public string Describe()
    {
        return $"Payload(Value={this.Value})";
    }
}

public readonly struct Container
{
    public int Code;
    public string Label;

    public Container()
    {
        this.Code = 99;
        this.Label = "constructed";
    }

    default {
        Code = 42
        Label = "defaulted"
    }

    public string Describe()
    {
        return $"Container(Code={this.Code}, Label={this.Label})";
    }
}

// ─── Field initializers that leave a trail ───────────────────────────────────
// PROOF: an initializer runs once per construction and before the constructor body, and a derived
//        type's own initializers run before its base constructor's
public class Log
{
    public static string Trail = "";

    public static string Show(string tag)
    {
        Trail = Trail + tag;
        return tag;
    }

    public static int Num(string tag, int n)
    {
        Trail = Trail + tag;
        return n;
    }
}

public class Bare
{
    public string Field = Log.Show("a");
    public int Count = Log.Num("b", 7);

    public Bare(int seed)
    {
    }
}

public class Quiet
{
    public string Field = "q";
    public int Count = 7;
}

public class Declared
{
    public string Field = Log.Show("a");

    public Declared(int seed)
    {
        Log.Trail = Log.Trail + "C";
    }
}

public class Derived : Bare
{
    public string Extra = Log.Show("x");

    public Derived(int seed) : base(seed)
    {
    }
}

public struct Mark
{
    public int X = Log.Num("p", 3);

    public Mark(int seed)
    {
        Log.Trail = Log.Trail + "S";
    }
}

// ─── Entry point ─────────────────────────────────────────────────────────────

public class Program
{
    public static void Main(string[] args)
    {
        RunDemo();
    }

    public static void RunDemo()
    {
        Console.WriteLine("=== Default Keyword Sample ===");

        // 1. default(TypeName) for primitive types
        Console.WriteLine("--- Primitive Defaults ---");
        int i = default(int);
        bool b = default(bool);
        string s = default(string);
        Console.WriteLine($"int={i} bool={b} string={s}");

        // 2. default(TypeName) for a class with zero-initialized fields
        Console.WriteLine("--- Class Default (zero-init) ---");
        Config cfg = default(Config);
        Console.WriteLine(cfg.Describe());

        // 3. default(TypeName) for a class with field initializers
        Console.WriteLine("--- Class Default (field initializers) ---");
        Settings settings = default(Settings);
        Console.WriteLine(settings.Describe());

        // 4. Bare default with type inference from variable declaration
        Console.WriteLine("--- Bare Default (inferred) ---");
        Config inferred = default;
        Console.WriteLine(inferred.Describe());

        // 5. default(TypeName) for a class with an explicit default block
        Console.WriteLine("--- Explicit Default Block ---");
        AppState state = default(AppState);
        Console.WriteLine(state.Describe());

        // 6. Readonly struct: new vs default
        // new Container() calls the user's constructor (Code=99, Label="constructed")
        // default(Container) calls __CreateDefault via sentinel constructor (Code=42, Label="defaulted")
        Console.WriteLine("--- Readonly Struct: new vs default ---");
        var c1 = new Container();
        Container c2 = default(Container);
        Console.WriteLine($"new Container() = {c1.Describe()}");
        Console.WriteLine($"default(Container) = {c2.Describe()}");

        Console.WriteLine("--- Initializers Per Construction ---");
        var bare = new Bare(0);
        Console.WriteLine($"new Bare(0) = {bare.Field} {bare.Count} trail={Log.Trail}");
        Log.Trail = "";
        var quiet = new Quiet();
        Console.WriteLine($"new Quiet() = {quiet.Field} {quiet.Count} trail={Log.Trail}");
        var declared = new Declared(0);
        Console.WriteLine($"new Declared(0) = {declared.Field} trail={Log.Trail}");
        Log.Trail = "";
        var derived = new Derived(0);
        Console.WriteLine($"new Derived(0) = {derived.Field} {derived.Extra} trail={Log.Trail}");
        Log.Trail = "";
        var mark = new Mark(0);
        Console.WriteLine($"new Mark(0) = {mark.X} trail={Log.Trail}");

        Console.WriteLine("Done!");
    }
}
