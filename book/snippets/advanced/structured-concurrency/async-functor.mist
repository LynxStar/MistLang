using Standard;

int ComputeSync()
{
    return 2 + 2;
}

async int ComputeAsync()
{
    return 3 + 3;
}

int ComputePromoted()
{
    return ComputeAsync();
}

void Main()
{
    // Lift a sync method into a task
    var task1 = async ComputeSync();    // task1: Task<int>

    // In a sync context, async functor cancels auto-unwrap
    var task2 = async ComputeAsync();   // task2: Task<int>

    // Without async functor, sync context auto-unwraps
    var value = ComputeAsync();         // value: int (auto-awaited)
    var promotedTask = async ComputePromoted();
    Console.WriteLine(await promotedTask);
}
