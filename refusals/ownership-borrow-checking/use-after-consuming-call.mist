using Standard;

namespace Refusal;

public class Account
{
    public owned string Name;

    public Account(owned string name)
    {
        this.Name = name;
    }

    public string Close() with owned
    {
        return Name;
    }

    public string Summary()
    {
        return Name;
    }
}

public class Probe
{
    public static void Main()
    {
        owned var a = new Account("a");
        var closed = a.Close();
        // REFUSE: MIST_PA_USE_AFTER_MOVE
        Console.WriteLine(a.Summary());
        Console.WriteLine("unreachable");
    }
}
