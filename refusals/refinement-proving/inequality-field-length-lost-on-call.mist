using Standard;

namespace Refusal;

public class Probe
{
    int[] cells = new int[1];

    public int First()
    {
        if(cells.Length != 0)
        {
            Shrink();
            // REFUSE: MIST_PA_INDEX_UNPROVEN
            return cells[0];
        }

        return 0;
    }

    void Shrink()
    {
        cells = new int[0];
    }

    public static void Main()
    {
        Console.WriteLine(new Probe().First());
    }
}
