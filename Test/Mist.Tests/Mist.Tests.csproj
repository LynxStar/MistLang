<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="FsCheck.Xunit" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Source\Mist\Mist.csproj" />
    <ProjectReference Include="..\..\Source\Storm.SourceGenerator\Storm.SourceGenerator.csproj" />
    <ProjectReference Include="..\Mist.Tests.InteropFixtures\Mist.Tests.InteropFixtures.csproj" />
    <!--
      Carried for BUILD ORDER alone, which is why neither the assembly nor its files come along.
      SamplesCompileAndMatchBaselineTest runs the CLI with the no-build flag, so something must
      guarantee the CLI is built before these tests run; without this edge the solution constrains
      nothing between the two. Building it here rather than letting the test build it is the fix
      for the suite-wide flake in backlog/flaky-tests.yaml, where a nested MSBuild rewrites
      Mist.CLI's copy of Source/Standard while the compiler it launches is reading it.
    -->
    <ProjectReference Include="..\..\Source\Mist.CLI\Mist.CLI.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <!--
    Copy the Mist Standard Library next to the test assembly so that
    CompilerDriver.Compile's call to StdlibLoader.LoadFor (which reads from
    AppContext.BaseDirectory/Standard/) sees the stdlib files when tests run.
    Mirrors the Content item in Source/Mist.CLI/Mist.CLI.csproj (Task 28).
  -->
  <ItemGroup>
    <Content Include="..\..\Source\Standard\**\*.mist"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             TargetPath="Standard\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
