using Standard;

namespace Refusal;

public ref struct Cursor
{
    public int Pos;

    public Cursor(int pos)
    {
        this.Pos = pos;
    }
}

public class Bad
{
    // REFUSE: MIST_PA_REF_STRUCT_FIELD
    public Cursor Field;

    public Bad(Cursor c)
    {
        this.Field = c;
    }
}

public class Probe
{
    public static void Main()
    {
        var b = new Bad(new Cursor(1));
        Console.WriteLine("unreachable");
    }
}
