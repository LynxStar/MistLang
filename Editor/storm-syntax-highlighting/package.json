{
  "name": "storm-syntax-highlighting",
  "displayName": "Storm Syntax Highlighting",
  "version": "0.1.0",
  "publisher": "mist-lang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "storm",
        "aliases": ["Storm", "storm"],
        "extensions": [".storm"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "storm",
        "scopeName": "source.storm",
        "path": "./syntaxes/storm.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "test": "npx vscode-tmgrammar-test -g syntaxes/storm.tmLanguage.json tests/*.storm"
  },
  "devDependencies": {
    "vscode-tmgrammar-test": "^0.1.3"
  }
}
