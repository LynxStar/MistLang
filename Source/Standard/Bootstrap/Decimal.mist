namespace Standard;

intrinsic public readonly owned struct Decimal : IClonable<Decimal>
{
    intrinsic public static readonly Decimal MinValue;
    intrinsic public static readonly Decimal MaxValue;
    intrinsic public string ToString(System.IFormatProvider? provider);
    intrinsic public pure int CompareTo(Decimal other);
    intrinsic public static Decimal? Parse(string? text, System.Globalization.NumberStyles style, System.IFormatProvider? provider);

    // IClonable base case — value-type identity copy (Requirement 8.6)
    intrinsic public pure owned Decimal Clone();

    // Binary arithmetic operators — Requirement 3.1
    intrinsic public pure static Decimal operator +(Decimal a, Decimal b);
    intrinsic public pure static Decimal operator -(Decimal a, Decimal b);
    intrinsic public pure static Decimal operator *(Decimal a, Decimal b);
    intrinsic public pure static Decimal operator /(Decimal a, Decimal b);
    intrinsic public pure static Decimal operator %(Decimal a, Decimal b);

    // Comparison operators — Requirement 3.2
    intrinsic public pure static Boolean operator <(Decimal a, Decimal b);
    intrinsic public pure static Boolean operator >(Decimal a, Decimal b);
    intrinsic public pure static Boolean operator <=(Decimal a, Decimal b);
    intrinsic public pure static Boolean operator >=(Decimal a, Decimal b);
    intrinsic public pure static Boolean operator ==(Decimal a, Decimal b);
    intrinsic public pure static Boolean operator !=(Decimal a, Decimal b);

    // Unary negation — Requirement 3.3
    intrinsic public pure static Decimal operator -(Decimal a);
}
