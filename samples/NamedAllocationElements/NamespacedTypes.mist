namespace NamedAllocationElements.Ns;

public struct Point
{
    public int x;
    public int y;

    public Point(int a, int b)
    {
        this.x = a;
        this.y = b;
    }
}

public struct Pair<T>
{
    public int first;
    public int second;

    public Pair(int a, int b)
    {
        this.first = a;
        this.second = b;
    }
}
