// GenericBox<T> — Demonstrates a generic class implementing a generic interface
// in the AllFeatures sample.

using System;

namespace AllFeatures;

public class GenericBox<T> : IGenericContainer<T>
{
    private T item;

    public GenericBox(T item)
    {
        this.item = item;
    }

    public T GetItem()
    {
        return item;
    }

    public string Describe()
    {
        return $"GenericBox({item})";
    }
}
