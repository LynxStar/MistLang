// IShape — Demonstrates abstract type declarations, abstract type inheritance, and abstract type properties.

using Standard;

namespace ShapeAbstracts;

public abstract IShape
{
    string Name { get; }
    string Describe();
    int Area();

    // Bodied, so a default rather than a slot: a conformer declaring no Summary of its own gets
    // this one, and its body reaches the slots above through `this`.
    string Summary()
    {
        return $"{this.Name} -> {this.Describe()} area={this.Area()}";
    }

    string Kind()
    {
        return "shape";
    }
}

public abstract IResizable : IShape
{
    int Scale { get; set; }
    int ResizedArea(int factor);
}
