using Standard;

namespace Refusal;

public struct Point
{
    public int x;
    public int y;
}

public class Probe
{
    public static int Read()
    {
        Point p;
        p.x = 1;
        // REFUSE: MIST_PA_LOCAL_READ_BEFORE_ASSIGNMENT
        return p.y;
    }

    public static void Main()
    {
        Console.WriteLine(Read());
    }
}
