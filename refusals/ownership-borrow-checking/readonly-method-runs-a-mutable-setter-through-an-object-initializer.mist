using Standard;

namespace Refusal;

public class Globals
{
    public static int Counter;
}

public class Cell
{
    public int level;

    public int Level
    {
        get
        {
            return level;
        }
        set
        {
            level = value;
            Globals.Counter = Globals.Counter + 1;
        }
    }
}

public class Probe
{
    public static readonly int M()
    {
        // REFUSE: MIST_PA_READONLY_CONTEXT_SETS_PROPERTY
        var c = new Cell { Level = 3 };
        return c.Level;
    }

    public static void Main()
    {
        Console.WriteLine(M());
        Console.WriteLine("unreachable");
    }
}
