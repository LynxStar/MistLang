using Standard;

namespace Refusal;

public class Clock
{
    public static int Ticks;
}

public struct Pair
{
    public int A;

    public Pair(int a)
    {
        A = a;
    }
}

public class Bare
{
    public int N = Clock.Ticks;
    public Pair P;
}

public class Probe
{
    public static pure int Direct()
    {
        // REFUSE: MIST_PA_PURE_SCOPE_CALLS_IMPURE
        var b = new Bare();
        return b.N;
    }

    public static void Main()
    {
        Clock.Ticks = 5;
        Console.WriteLine(Direct());
        Console.WriteLine("unreachable");
    }
}
