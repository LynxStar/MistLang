using Standard;

namespace Refusal;

public class Shelf
{
    public int this[byte slot] where slot >= 18
    {
        get { return slot; }
    }
}

public class Probe
{
    public static void Main()
    {
        var shelf = new Shelf();
        // REFUSE: MIST_PA_NO_IMPLICIT_CONVERSION
        Console.WriteLine(shelf[-5]);
        Console.WriteLine("unreachable");
    }
}
