using Standard;

namespace Refusal;

public struct Point
{
    public int x;
    public int y;
}

public class Probe
{
    public static void Main()
    {
        Point p;
        p.x = 1;
        int Read() { return p.y; }
        // REFUSE: MIST_PA_LOCAL_FUNCTION_READS_UNASSIGNED
        func<int> read = Read;
        p.y = 2;
        Console.WriteLine(read());
    }
