using Standard;

namespace Refusal;

public class Gauge
{
    public static explicit operator Gauge(uint reading)
    {
        return new Gauge();
    }

    public static explicit operator Gauge(short reading)
    {
        return new Gauge();
    }
}

public class Probe
{
    public static void Main()
    {
        byte small = 2;
        // REFUSE: MIST_PA_AMBIGUOUS_CAST
        var converted = (Gauge)small;
        Console.WriteLine("unreachable");
    }
}
