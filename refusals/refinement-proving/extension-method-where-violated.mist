using Standard;

namespace Refusal;

extension(string self)
{
    public int Wide(int other) where other >= 3
    {
        return self.Length + other;
    }
}

public class Probe
{
    public static void Main()
    {
        // REFUSE: MIST_PA_CONSTRAINT_VIOLATED
        Console.WriteLine("s".Wide(1));
    }
}
