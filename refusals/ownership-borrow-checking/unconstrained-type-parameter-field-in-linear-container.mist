using Standard;

namespace Refusal;

public linear class Generic<T>
{
    // REFUSE: MIST_PA_FIELD_TYPE_PARAMETER_UNCONSTRAINED
    public T Value;

    public Generic(T value)
    {
        this.Value = value;
    }

    public void Drop()
    {
    }
}

public class Probe
{
    public static void Main()
    {
        var g = new Generic<int>(1);
        Console.WriteLine("unreachable");
    }
}
