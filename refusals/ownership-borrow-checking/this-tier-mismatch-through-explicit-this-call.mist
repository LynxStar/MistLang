using Standard;

namespace Refusal;

public class Account
{
    public owned int Balance;

    public Account(owned int balance)
    {
        this.Balance = balance;
    }

    public void Deposit(owned int amount)
    {
        this.Balance = this.Balance + amount;
    }

    public void DepositViaThis()
    {
        this.Deposit(1);
    }
}

public class Probe
{
    public static void Pay(Account a)
    {
        // REFUSE: MIST_PA_THIS_TIER_MISMATCH
        a.DepositViaThis();
    }

    public static void Main()
    {
        owned var a = new Account(1);
        Pay(a);
        Console.WriteLine("unreachable");
    }
}
