using Standard;

public class Rectangle
{
    public Rectangle(int width, int height)
    {
        this.Width = width;
        this.Height = height;
    }

    // Read-only computed property (top-level =>)
    public int Area => Width * Height;

    // Expression-bodied get and init accessors
    public int Width
    {
        get => field;
        init => field = value;
    }

    // Expression-bodied get and set accessors
    public int Height
    {
        get => field;
        set => field = value;
    }
}
