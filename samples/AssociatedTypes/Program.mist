// AssociatedTypes — Demonstrates all associated type slot variants and usage patterns.
//
// Associated types declare abstract type slots in interfaces/traits that implementors
// must fill with concrete nested types satisfying declared constraints. The compiler
// validates constraint satisfaction at compile time.
//
// PROOF OF CORRECTNESS: This program would NOT compile if the associated type feature
// were removed — the `type Name : Constraint;` declarations would fail to parse, and
// the constraint validation (struct/class/interface) would not occur. Each interface
// uses its slot in method signatures (return types or parameters), proving the slot
// is not just declared but actively participates in the interface contract.

using Standard;

namespace AssociatedTypes;

// ─── Supporting interfaces ───────────────────────────────────────────────────

interface IStringable {
    string Stringify();
}

interface IResettable {
    string GetState();
}

// ═══════════════════════════════════════════════════════════════════════════════
// Pattern 1: Single interface constraint
// The slot `type Output : IStringable` requires the concrete type to implement
// IStringable. The interface uses Output as a return type, proving the slot
// participates in the contract.
// ═══════════════════════════════════════════════════════════════════════════════

interface IProducer {
    type Output : IStringable;
    Output Produce(string value);
}

class MessageProducer : IProducer {
    public class Output : IStringable {
        public string Value;
        public Output(string value) { Value = value; }
        public string Stringify() { return $"Output({Value})"; }
    }
    public Output Produce(string value) {
        return new Output(value);
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
// Pattern 2: Trait slot with interface constraint
// Traits can also declare associated type slots. The trait uses Input as both
// a return type and parameter type in its method signatures.
// ═══════════════════════════════════════════════════════════════════════════════

trait Consumable {
    type Input : IStringable;
    Input Accept(string data);
    string Describe(Input item);
}

class StringConsumer {
    public class Input : IStringable {
        public string Data;
        public Input(string data) { Data = data; }
        public string Stringify() { return $"Input({Data})"; }
    }
    public Input Accept(string data) {
        return new Input(data);
    }
    public string Describe(Input item) {
        return item.Stringify();
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
// Pattern 3: Struct kind constraint — implementor with nested struct
// The slot `type Cursor : struct` requires the concrete type to be a value type.
// The interface uses Cursor as both return and parameter type.
// ═══════════════════════════════════════════════════════════════════════════════

interface IIterator {
    type Cursor : struct;
    Cursor Start();
    Cursor Advance(Cursor current);
}

class RangeIterator : IIterator {
    public struct Cursor {
        public int Position;
        public Cursor(int pos) { Position = pos; }
    }
    public Cursor Start() {
        return new Cursor(0);
    }
    public Cursor Advance(Cursor current) {
        return new Cursor(current.Position + 1);
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
// Pattern 4: Class kind constraint — implementor with nested class
// The slot `type Product : class` requires the concrete type to be a reference type.
// The interface uses Product as a return type.
// ═══════════════════════════════════════════════════════════════════════════════

interface IFactory {
    type Product : class;
    Product Create(string name, int weight);
}

class WidgetFactory : IFactory {
    public class Product {
        public string Name;
        public int Weight;
        public Product(string name, int weight) { Name = name; Weight = weight; }
    }
    public Product Create(string name, int weight) {
        return new Product(name, weight);
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
// Pattern 5: Multiple constraints (IStringable AND IResettable)
// The slot requires the concrete type to implement BOTH interfaces.
// The interface uses State as a return type.
// ═══════════════════════════════════════════════════════════════════════════════

interface IStatefulProducer {
    type State : IStringable, IResettable;
    State CreateState(int initial);
}

class CounterProducer : IStatefulProducer {
    public class State : IStringable, IResettable {
        public int Count;
        public State(int count) { Count = count; }
        public string Stringify() { return $"State(count={Count})"; }
        public string GetState() { return $"count={Count}"; }
    }
    public State CreateState(int initial) {
        return new State(initial);
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
// Pattern 6: Associated type slot on a generic interface
// The interface has a type parameter used in its methods, AND an associated type
// slot with its own constraint. The interface uses Mapped as a return type AND
// TIn as a parameter, proving both coexist correctly.
// ═══════════════════════════════════════════════════════════════════════════════

interface IMapper<TIn> {
    type Mapped : IStringable;
    Mapped Map(TIn value);
    TIn GetDefault();
}

class IntMapper : IMapper<int> {
    public class Mapped : IStringable {
        public int Value;
        public Mapped(int v) { Value = v; }
        public string Stringify() { return $"Mapped({Value})"; }
    }
    public Mapped Map(int value) {
        return new Mapped(value * 2);
    }
    public int GetDefault() {
        return 0;
    }
}

class StringMapper : IMapper<string> {
    public class Mapped : IStringable {
        public string Value;
        public Mapped(string v) { Value = v; }
        public string Stringify() { return $"Mapped({Value})"; }
    }
    public Mapped Map(string value) {
        return new Mapped(value);
    }
    public string GetDefault() {
        return "";
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
// Pattern 7: Unconstrained slot
// The slot `type Element;` has no constraints — any nested type satisfies it.
// The interface uses Element as a return type.
// ═══════════════════════════════════════════════════════════════════════════════

interface IContainer {
    type Element;
    Element Get(int index);
    int GetSize();
}

class IntContainer : IContainer {
    public struct Element {
        public int Value;
        public Element(int v) { Value = v; }
    }
    public Element Get(int index) {
        return new Element(index * 10);
    }
    public int GetSize() {
        return 1;
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
// Pattern 8: Class + interface constraint combined
// The slot requires BOTH `class` kind AND interface implementation.
// The interface uses Value as a return type.
// ═══════════════════════════════════════════════════════════════════════════════

interface IValueProducer {
    type Value : class, IStringable;
    Value Create(int x, int y);
}

class PointProducer : IValueProducer {
    public class Value : IStringable {
        public int X;
        public int Y;
        public Value(int x, int y) { X = x; Y = y; }
        public string Stringify() { return $"({X},{Y})"; }
    }
    public Value Create(int x, int y) {
        return new Value(x, y);
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
// Pattern 9: Multiple slots in one interface
// An interface can declare multiple associated type slots, each with different
// constraints. The interface uses both Key and Value in its method signatures.
// ═══════════════════════════════════════════════════════════════════════════════

interface IKeyValueStore {
    type Key : struct;
    type Value : class;
    Key MakeKey(int id);
    Value MakeValue(string data);
}

class StringStore : IKeyValueStore {
    public struct Key {
        public int Id;
        public Key(int id) { Id = id; }
    }
    public class Value {
        public string Data;
        public Value(string data) { Data = data; }
    }
    public Key MakeKey(int id) {
        return new Key(id);
    }
    public Value MakeValue(string data) {
        return new Value(data);
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
// Pattern 10: Multiple interfaces with slots on same implementor
// A class can implement multiple interfaces that each declare associated type
// slots. Each interface uses its slot in a method signature.
// ═══════════════════════════════════════════════════════════════════════════════

interface IReadable {
    type Reader : struct;
    Reader OpenReader(int offset);
}

interface IWritable {
    type Writer : class;
    Writer OpenWriter(int bufferSize);
}

class FileStream : IReadable, IWritable {
    public struct Reader {
        public int Offset;
        public Reader(int offset) { Offset = offset; }
    }
    public class Writer {
        public int BufferSize;
        public Writer(int size) { BufferSize = size; }
    }
    public Reader OpenReader(int offset) {
        return new Reader(offset);
    }
    public Writer OpenWriter(int bufferSize) {
        return new Writer(bufferSize);
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
// Pattern 11: Type parameter participating in associated type constraint
// The interface's type parameter T is used in the slot's constraint:
// `type Output : IWrapper<T>`. This requires the concrete Output type to
// implement IWrapper parameterized by the same T that the interface was
// instantiated with. Proves the compiler resolves enclosing type parameters
// inside slot constraint type arguments.
// ═══════════════════════════════════════════════════════════════════════════════

interface IWrapper<T> {
    T Unwrap();
}

interface IBoxFactory<T> {
    type Boxed : IWrapper<T>;
    Boxed Wrap(T value);
}

class IntBoxFactory : IBoxFactory<int> {
    public class Boxed : IWrapper<int> {
        public int Inner;
        public Boxed(int v) { Inner = v; }
        public int Unwrap() { return Inner; }
    }
    public Boxed Wrap(int value) {
        return new Boxed(value);
    }
}

class StringBoxFactory : IBoxFactory<string> {
    public class Boxed : IWrapper<string> {
        public string Inner;
        public Boxed(string v) { Inner = v; }
        public string Unwrap() { return Inner; }
    }
    public Boxed Wrap(string value) {
        return new Boxed(value);
    }
}

// ═══════════════════════════════════════════════════════════════════════════════
// Pattern 12: Parameterized (higher-kinded) associated type slot
// The slot `type Mapped<TOut> : ITransform<TIn, TOut>` is itself generic.
// The implementor provides a generic nested type, and callers choose the type
// argument at each usage site. The emitter erases the slot to its constraint
// interface in the C# output since C# lacks higher-kinded types.
// ═══════════════════════════════════════════════════════════════════════════════

interface ITransform<TIn, TOut> {
    TOut Transform(TIn input);
}

interface IConverter<TIn> {
    type Converted<TOut> : ITransform<TIn, TOut>;
    Converted<string> ConvertToString(TIn input);
    Converted<int> ConvertToInt(TIn input);
}

class IntConverter : IConverter<int> {
    public class Converted<TOut> : ITransform<int, TOut> {
        public TOut Value;
        public Converted(TOut v) { Value = v; }
        public TOut Transform(int input) { return Value; }
    }
    public Converted<string> ConvertToString(int input) {
        return new Converted<string>($"converted-{input}");
    }
    public Converted<int> ConvertToInt(int input) {
        return new Converted<int>(input * 10);
    }
}

// ─── Entry point ─────────────────────────────────────────────────────────────

public class Program {
    public static void RunDemo() {
        Console.WriteLine("--- Associated Types ---");

        // 1. Single interface constraint — slot used as return type
        Console.WriteLine("--- Single Interface Constraint ---");
        var producer = new MessageProducer();
        var output1 = producer.Produce("hello");
        Console.WriteLine(output1.Stringify());
        var output2 = producer.Produce("world");
        Console.WriteLine(output2.Stringify());

        // 2. Trait slot — slot used as return and parameter type
        Console.WriteLine("--- Trait Slot ---");
        var consumer = new StringConsumer();
        var input1 = consumer.Accept("data-payload");
        Console.WriteLine(consumer.Describe(input1));
        var input2 = consumer.Accept("second-payload");
        Console.WriteLine(consumer.Describe(input2));

        // 3. Struct kind constraint — slot used as return and parameter type
        Console.WriteLine("--- Struct Constraint ---");
        var iter = new RangeIterator();
        var cursor = iter.Start();
        Console.WriteLine($"start={cursor.Position}");
        var cursor2 = iter.Advance(cursor);
        Console.WriteLine($"advanced={cursor2.Position}");

        // 4. Class kind constraint — slot used as return type
        Console.WriteLine("--- Class Constraint ---");
        var factory = new WidgetFactory();
        var product = factory.Create("Gear", 5);
        Console.WriteLine($"product.Name={product.Name}");
        Console.WriteLine($"product.Weight={product.Weight}");

        // 5. Multiple constraints — slot used as return type, both constraints exercised
        Console.WriteLine("--- Multiple Constraints ---");
        var stateful = new CounterProducer();
        var state = stateful.CreateState(7);
        Console.WriteLine(state.Stringify());
        Console.WriteLine(state.GetState());

        // 6. Generic interface with slot — slot and type param both used in methods
        Console.WriteLine("--- Generic Interface With Slot ---");
        var intMapper = new IntMapper();
        var mapped1 = intMapper.Map(123);
        Console.WriteLine(mapped1.Stringify());
        Console.WriteLine($"intMapper.GetDefault()={intMapper.GetDefault()}");
        var strMapper = new StringMapper();
        var mapped2 = strMapper.Map("hello");
        Console.WriteLine(mapped2.Stringify());
        Console.WriteLine($"strMapper.GetDefault()={strMapper.GetDefault()}");

        // 7. Unconstrained slot — slot used as return type
        Console.WriteLine("--- Unconstrained Slot ---");
        var container = new IntContainer();
        var elem = container.Get(5);
        Console.WriteLine($"elem.Value={elem.Value}");
        var elem2 = container.Get(7);
        Console.WriteLine($"elem2.Value={elem2.Value}");

        // 8. Class + interface constraint — slot used as return type
        Console.WriteLine("--- Class Plus Interface ---");
        var pointProducer = new PointProducer();
        var point = pointProducer.Create(3, 4);
        Console.WriteLine(point.Stringify());
        var point2 = pointProducer.Create(10, 20);
        Console.WriteLine(point2.Stringify());

        // 9. Multiple slots — both slots used as return types
        Console.WriteLine("--- Multiple Slots ---");
        var store = new StringStore();
        var key = store.MakeKey(1);
        Console.WriteLine($"key.Id={key.Id}");
        var val = store.MakeValue("hello-store");
        Console.WriteLine($"val.Data={val.Data}");

        // 10. Multiple interfaces — each slot used as return type
        Console.WriteLine("--- Multiple Interfaces ---");
        var stream = new FileStream();
        var reader = stream.OpenReader(0);
        Console.WriteLine($"reader.Offset={reader.Offset}");
        var writer = stream.OpenWriter(4096);
        Console.WriteLine($"writer.BufferSize={writer.BufferSize}");

        // 11. Type parameter in slot constraint — T flows into IWrapper<T>
        Console.WriteLine("--- Type Param In Slot Constraint ---");
        var intFactory = new IntBoxFactory();
        var intBox = intFactory.Wrap(42);
        Console.WriteLine($"intBox.Unwrap()={intBox.Unwrap()}");
        var strFactory = new StringBoxFactory();
        var strBox = strFactory.Wrap("boxed");
        Console.WriteLine($"strBox.Unwrap()={strBox.Unwrap()}");

        // 12. Parameterized (higher-kinded) slot — slot is itself generic
        Console.WriteLine("--- Parameterized Slot ---");
        var converter = new IntConverter();
        var strResult = converter.ConvertToString(42);
        Console.WriteLine($"strResult.Transform(0)={strResult.Transform(0)}");
        var intResult = converter.ConvertToInt(7);
        Console.WriteLine($"intResult.Transform(0)={intResult.Transform(0)}");

        Console.WriteLine("--- Associated Types Done ---");
    }

    public static void Main(string[] args) {
        RunDemo();
    }
}
