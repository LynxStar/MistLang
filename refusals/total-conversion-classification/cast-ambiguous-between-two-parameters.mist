using Standard;

namespace Refusal;

public class Meters
{
}

public class Yards
{
}

public class Fathom
{
    public static explicit operator Fathom(Meters m)
    {
        return new Fathom();
    }

    public static explicit operator Fathom(Yards y)
    {
        return new Fathom();
    }
}

public class Sounding
{
    public static implicit operator Meters(Sounding s)
    {
        return new Meters();
    }

    public static implicit operator Yards(Sounding s)
    {
        return new Yards();
    }
}

public class Probe
{
    public static void Main()
    {
        var sounding = new Sounding();
        // REFUSE: MIST_PA_AMBIGUOUS_CAST
        var converted = (Fathom)sounding;
        Console.WriteLine("unreachable");
    }
}
