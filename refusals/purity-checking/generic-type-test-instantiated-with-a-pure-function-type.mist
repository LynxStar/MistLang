using Standard;

namespace Refusal;

public type Reader = pure func<int>;

public class Clock
{
    public static int Ticks;
}

public class Probe
{
    public static int Now()
    {
        Clock.Ticks = Clock.Ticks + 1;
        return Clock.Ticks;
    }

    public static pure int Twice(Reader f)
    {
        return f() + f();
    }

    public static T Coerce<T>(unknown u, T fallback)
    {
        if(u is T t)
        {
            return t;
        }

        return fallback;
    }

    public static void Main()
    {
        func<int> plain = Now;
        Reader safe = () => 0;
        // REFUSE: MIST_PA_PURE_FUNCTION_TYPE_UNTESTABLE
        Reader r = Coerce<Reader>(plain, safe);
        Console.WriteLine(Twice(r));
        Console.WriteLine("unreachable");
    }
}
