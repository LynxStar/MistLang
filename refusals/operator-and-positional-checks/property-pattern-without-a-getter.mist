using Standard;

namespace Refusal;

public class Gauge
{
    public int stored;

    public int Level
    {
        set { stored = value; }
    }
}

public class Probe
{
    public static void Main()
    {
        var gauge = new Gauge();
        // REFUSE: MIST_PA_NO_GET_ACCESSOR
        if(gauge is { Level: 1 })
        {
            Console.WriteLine("unreachable");
        }
    }
}
