using Standard;

namespace Refusal;

public struct Meters
{
    public static int made;
    public int v;

    public Meters(int x)
    {
        v = x;
    }

    public static explicit operator int(Meters m)
    {
        made = made + 1;
        return m.v;
    }

    public static pure int Read(Meters m)
    {
        // REFUSE: MIST_PA_PURE_SCOPE_CALLS_IMPURE
        return (int)m;
    }
}

public class Probe
{
    public static void Main()
    {
        var m = new Meters(2);
        var r = Meters.Read(m);
        Console.WriteLine("unreachable");
    }
}
