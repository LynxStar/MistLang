// SpecialBox<T> — Demonstrates generic class extending another generic class.
// IntBox — Demonstrates non-generic class extending a constructed generic type.

using System;

namespace Generics;

public class SpecialBox<T> : Box<T>
{
    private string label;

    public SpecialBox(T item, string label) : base(item)
    {
        this.label = label;
    }

    public string GetLabel()
    {
        return label;
    }

    public string DescribeSpecial()
    {
        return $"SpecialBox[{label}]({GetValue()})";
    }
}

public class IntBox : Box<int>
{
    public IntBox(int item) : base(item)
    {
    }

    public int GetDoubled()
    {
        return GetValue() * 2;
    }
}
