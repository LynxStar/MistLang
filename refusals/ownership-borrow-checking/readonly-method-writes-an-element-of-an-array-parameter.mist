using Standard;

namespace Refusal;

public class Probe
{
    public static readonly int Fill(int[] a)
    {
        if(a.Length > 0)
        {
            // REFUSE: MIST_PA_READONLY_CONTEXT_WRITES_THROUGH_INDEX
            a[0] = 5;
        }

        return a.Length;
    }

    public static void Main()
    {
        int[] xs = [1, 2, 3];
        Console.WriteLine(Fill(xs));
        Console.WriteLine("unreachable");
    }
}
