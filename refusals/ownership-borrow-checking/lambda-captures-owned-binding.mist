using Standard;

namespace Refusal;

public owned class Engine
{
    public int Rpm;

    public Engine(int rpm)
    {
        this.Rpm = rpm;
    }

    public void Rev(int by)
    {
        this.Rpm = this.Rpm + by;
    }

    public int Get()
    {
        return Rpm;
    }
}

public class Probe
{
    public static void Main()
    {
        owned var e = new Engine(1);
        // REFUSE: MIST_PA_CAPTURED_BINDING
        func<int, int> f = x => x + e.Get();
        Console.WriteLine(f(1));
        Console.WriteLine("unreachable");
    }
}
