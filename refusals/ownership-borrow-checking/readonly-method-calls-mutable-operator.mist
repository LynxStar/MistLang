using Standard;

namespace Refusal;

public struct Tally
{
    public static int made;
    public int v;

    public Tally(int x)
    {
        v = x;
    }

    public static Tally operator +(Tally a, Tally b)
    {
        made = made + 1;
        return new Tally(a.v + b.v);
    }

    public readonly int Twice()
    {
        // REFUSE: MIST_PA_READONLY_CONTEXT_CALLS_MUTABLE
        return (this + this).v;
    }
}

public class Probe
{
    public static void Main()
    {
        var t = new Tally(2);
        var d = t.Twice();
        Console.WriteLine("unreachable");
    }
}
