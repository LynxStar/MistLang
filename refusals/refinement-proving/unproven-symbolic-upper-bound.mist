using Standard;

namespace Refusal;

public class Probe
{
    public static int At(int[] items, int i)
    {
        if(i >= 0)
        {
            // REFUSE: MIST_PA_INDEX_UNPROVEN
            return items[i];
        }

        return 0;
    }

    public static void Main()
    {
        Console.WriteLine(At([1, 2], 1));
        Console.WriteLine("unreachable");
    }
}
