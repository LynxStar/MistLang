using Standard;

namespace Refusal;

public class Probe
{
    public static int End()
    {
        return 3;
    }

    public static int Read(bool flag)
    {
        var numbers = [10, 20, 30, 40, 50];
        Range window = 0..Probe.End();
        if(flag)
        {
            window = 0..Probe.End();
        }

        var slice = numbers[window];
        // REFUSE: MIST_PA_INDEX_UNPROVEN
        return slice[0];
    }

    public static void Main()
    {
        Console.WriteLine(Read(true));
    }
}
