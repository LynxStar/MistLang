// ExpressionBodied — Demonstrates expression-bodied properties and accessors.

using System;

namespace Properties;

public class ExpressionBodied
{
    private int _width;
    private int _height;

    public ExpressionBodied(int width, int height)
    {
        this._width = width;
        this._height = height;
    }

    // Expression-bodied property (top-level =>)
    public int Area => _width * _height;

    // Expression-bodied get accessor
    public int Width
    {
        get => _width;
    }

    // Expression-bodied get and set accessors
    public int Height
    {
        get => _height;
        set => _height = value;
    }

    public string Describe()
    {
        return $"ExpressionBodied(Width={Width}, Height={Height}, Area={Area})";
    }
}
