namespace Standard;

// The unproven and guarded Int32 division/remainder routes and the Result arithmetic composition the
// compiler selects for an operator with a Result operand (exceptions Requirement 4): each tests its
// hazard and returns the error instead of running a trapping instruction, carries an existing error
// forward, or applies the operation to proven payloads, keeping one Result layer.
public class ResultArithmetic
{
    public static Result<Int32, DivisionError> DivideChecked(Int32 a, Int32 b)
    {
        if (b == 0)
        {
            return DivisionError.DivideByZero();
        }
        else
        {
            if (b == -1)
            {
                if (a == -2147483648)
                {
                    return DivisionError.Overflow();
                }
                else
                {
                    return a / b;
                }
            }
            else
            {
                return a / b;
            }
        }
    }

    public static Result<Int32, DivisionError> RemainderChecked(Int32 a, Int32 b)
    {
        if (b == 0)
        {
            return DivisionError.DivideByZero();
        }
        else
        {
            if (b == -1)
            {
                return 0;
            }
            else
            {
                return a % b;
            }
        }
    }

    public pure static Int32 Remainder(Int32 a, Int32 b)
    {
        if (b == 0)
        {
            return 0;
        }
        else
        {
            if (b == -1)
            {
                return 0;
            }
            else
            {
                return a % b;
            }
        }
    }

    public static Result<Int64, DivisionError> DivideCheckedInt64(Int64 a, Int64 b)
    {
        if (b == 0)
        {
            return DivisionError.DivideByZero();
        }
        else
        {
            if (b == -1)
            {
                if (a == -9223372036854775808)
                {
                    return DivisionError.Overflow();
                }
                else
                {
                    return a / b;
                }
            }
            else
            {
                return a / b;
            }
        }
    }

    public static Result<Int64, DivisionError> RemainderCheckedInt64(Int64 a, Int64 b)
    {
        if (b == 0)
        {
            return DivisionError.DivideByZero();
        }
        else
        {
            if (b == -1)
            {
                return 0;
            }
            else
            {
                return a % b;
            }
        }
    }

    public pure static Int64 RemainderInt64(Int64 a, Int64 b)
    {
        if (b == 0)
        {
            return 0;
        }
        else
        {
            if (b == -1)
            {
                return 0;
            }
            else
            {
                return a % b;
            }
        }
    }

    public static Result<Byte, DivisionError> DivideCheckedByte(Byte a, Byte b)
    {
        if (b == 0)
        {
            return DivisionError.DivideByZero();
        }
        else
        {
            return a / b;
        }
    }

    public static Result<Byte, DivisionError> RemainderCheckedByte(Byte a, Byte b)
    {
        if (b == 0)
        {
            return DivisionError.DivideByZero();
        }
        else
        {
            return a % b;
        }
    }

    public static Result<UInt16, DivisionError> DivideCheckedUInt16(UInt16 a, UInt16 b)
    {
        if (b == 0)
        {
            return DivisionError.DivideByZero();
        }
        else
        {
            return a / b;
        }
    }

    public static Result<UInt16, DivisionError> RemainderCheckedUInt16(UInt16 a, UInt16 b)
    {
        if (b == 0)
        {
            return DivisionError.DivideByZero();
        }
        else
        {
            return a % b;
        }
    }

    public static Result<UInt32, DivisionError> DivideCheckedUInt32(UInt32 a, UInt32 b)
    {
        if (b == 0)
        {
            return DivisionError.DivideByZero();
        }
        else
        {
            return a / b;
        }
    }

    public static Result<UInt32, DivisionError> RemainderCheckedUInt32(UInt32 a, UInt32 b)
    {
        if (b == 0)
        {
            return DivisionError.DivideByZero();
        }
        else
        {
            return a % b;
        }
    }

    public static Result<UInt64, DivisionError> DivideCheckedUInt64(UInt64 a, UInt64 b)
    {
        if (b == 0)
        {
            return DivisionError.DivideByZero();
        }
        else
        {
            return a / b;
        }
    }

    public static Result<UInt64, DivisionError> RemainderCheckedUInt64(UInt64 a, UInt64 b)
    {
        if (b == 0)
        {
            return DivisionError.DivideByZero();
        }
        else
        {
            return a % b;
        }
    }

    // Decimal has no wrapping, so every operation returns the overflow or zero-division the CLR would
    // throw, captured at the Exception.Catch boundary over the raw CLR operation rather than the
    // proof-sensitive operator, so the check does not re-enter itself (exceptions Requirement 4).
    public static Result<Decimal, System.Exception> AddCheckedDecimal(Decimal a, Decimal b)
    {
        return System.Exception.Catch(Decimal.Add, a, b);
    }

    public static Result<Decimal, System.Exception> SubtractCheckedDecimal(Decimal a, Decimal b)
    {
        return System.Exception.Catch(Decimal.Subtract, a, b);
    }

    public static Result<Decimal, System.Exception> MultiplyCheckedDecimal(Decimal a, Decimal b)
    {
        return System.Exception.Catch(Decimal.Multiply, a, b);
    }

    public static Result<Decimal, System.Exception> DivideCheckedDecimal(Decimal a, Decimal b)
    {
        return System.Exception.Catch(Decimal.Divide, a, b);
    }

    public static Result<Decimal, System.Exception> RemainderCheckedDecimal(Decimal a, Decimal b)
    {
        return System.Exception.Catch(Decimal.Remainder, a, b);
    }
}
