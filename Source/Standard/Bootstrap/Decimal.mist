namespace Standard;

intrinsic public readonly owned struct Decimal : IClonable<Decimal>
{
    // IClonable base case — value-type identity copy (Requirement 8.6)
    intrinsic public pure owned Decimal Clone();

    // Binary arithmetic operators — Requirement 3.1
    intrinsic public pure static Decimal operator +(Decimal a, Decimal b);
    intrinsic public pure static Decimal operator -(Decimal a, Decimal b);
    intrinsic public pure static Decimal operator *(Decimal a, Decimal b);
    intrinsic public pure static Decimal operator /(Decimal a, Decimal b);
    intrinsic public pure static Decimal operator %(Decimal a, Decimal b);

    // Comparison operators — Requirement 3.2
    intrinsic public pure static Boolean operator <(Decimal a, Decimal b);
    intrinsic public pure static Boolean operator >(Decimal a, Decimal b);
    intrinsic public pure static Boolean operator <=(Decimal a, Decimal b);
    intrinsic public pure static Boolean operator >=(Decimal a, Decimal b);
    intrinsic public pure static Boolean operator ==(Decimal a, Decimal b);
    intrinsic public pure static Boolean operator !=(Decimal a, Decimal b);

    // Unary negation — Requirement 3.3
    intrinsic public pure static Decimal operator -(Decimal a);

    // Raw CLR operations behind the checked routes (exceptions Requirement 4): these throw on overflow
    // and zero division rather than being proof-routed, so the fallible helpers wrap them in a Catch
    // boundary instead of re-entering the proof-sensitive operator.
    intrinsic public pure static Decimal Add(Decimal a, Decimal b);
    intrinsic public pure static Decimal Subtract(Decimal a, Decimal b);
    intrinsic public pure static Decimal Multiply(Decimal a, Decimal b);
    intrinsic public pure static Decimal Divide(Decimal a, Decimal b);
    intrinsic public pure static Decimal Remainder(Decimal a, Decimal b);
}
