namespace Standard;

intrinsic public readonly owned struct Byte : IClonable<Byte>
{
    public type Nonzero = Byte not 0;

    // IClonable base case — value-type identity copy (Requirement 8.6)
    intrinsic public pure owned Byte Clone();

    // Binary arithmetic operators — Requirement 3.1
    intrinsic public pure static Byte operator +(Byte a, Byte b);
    intrinsic public pure static Byte operator -(Byte a, Byte b);
    intrinsic public pure static Byte operator *(Byte a, Byte b);
    intrinsic public pure static Result<Byte, DivisionError> operator /(Byte a, Byte b);
    intrinsic public pure static Result<Byte, DivisionError> operator %(Byte a, Byte b);

    // Comparison operators — Requirement 3.2
    intrinsic public pure static Boolean operator <(Byte a, Byte b);
    intrinsic public pure static Boolean operator >(Byte a, Byte b);
    intrinsic public pure static Boolean operator <=(Byte a, Byte b);
    intrinsic public pure static Boolean operator >=(Byte a, Byte b);
    intrinsic public pure static Boolean operator ==(Byte a, Byte b);
    intrinsic public pure static Boolean operator !=(Byte a, Byte b);

    // No unary '-' on unsigned types — Requirement 3.4.

    // Implicit widening conversions
    intrinsic public pure static implicit operator Int16(Byte value);
    intrinsic public pure static implicit operator UInt16(Byte value);
    intrinsic public pure static implicit operator Int32(Byte value);
    intrinsic public pure static implicit operator UInt32(Byte value);
    intrinsic public pure static implicit operator Int64(Byte value);
    intrinsic public pure static implicit operator UInt64(Byte value);
    intrinsic public pure static implicit operator Single(Byte value);
    intrinsic public pure static implicit operator Double(Byte value);
    intrinsic public pure static implicit operator Decimal(Byte value);

