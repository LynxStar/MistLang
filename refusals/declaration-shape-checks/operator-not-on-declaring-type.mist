using Standard;

namespace Refusal;

public struct Meters
{
    public int Value;

    public Meters(int value)
    {
        Value = value;
    }

    // REFUSE: MIST_PA_OPERATOR_NOT_ON_DECLARING_TYPE
    public static int operator +(int a, int b)
    {
        return a - b;
    }
}

public class Probe
{
    public static void Main()
    {
        var m = new Meters(1);
        Console.WriteLine("unreachable");
    }
}
