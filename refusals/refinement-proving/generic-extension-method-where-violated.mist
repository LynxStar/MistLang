using Standard;

namespace Refusal;

public class Box<T>
{
    public T Value;

    public Box(T value)
    {
        Value = value;
    }
}

<T> extension(Box<T> self)
{
    public T Same(T key) where key not 18
    {
        return key;
    }
}

public class Probe
{
    public static void Main()
    {
        var box = new Box<int>(4);

        // REFUSE: MIST_PA_CONSTRAINT_VIOLATED
        Console.WriteLine(box.Same(18));
    }
}
