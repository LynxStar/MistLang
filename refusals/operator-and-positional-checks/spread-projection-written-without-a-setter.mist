using Standard;

namespace Refusal;

public class Row<params TArgs>
{
    public TArgs... Slot { get; }

    public Row(params TArgs values)
    {
        Slot... = values...;
    }
}

public class Probe
{
    public static void Main()
    {
        var row = new Row<int, string>(7, "z");
        // REFUSE: MIST_PA_NO_SET_ACCESSOR
        row.Slot1 = 5;
        Console.WriteLine("unreachable");
    }
}
