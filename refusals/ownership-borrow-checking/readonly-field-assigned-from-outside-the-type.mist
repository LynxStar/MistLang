using Standard;

namespace Refusal;

public class Counter
{
    public readonly int Id;

    public Counter(int id)
    {
        this.Id = id;
    }
}

public class Probe
{
    public static void Main()
    {
        var c = new Counter(1);
        // REFUSE: MIST_PA_READONLY_FIELD_ASSIGNED
        c.Id = 9;
        Console.WriteLine("unreachable");
    }
}
