namespace Standard;

intrinsic public readonly owned struct Int32 : IClonable<Int32>
{
    // IClonable base case — value-type identity copy (Requirement 8.6)
    intrinsic public pure owned Int32 Clone();

    // Binary arithmetic operators — Requirement 3.1
    intrinsic public pure static Int32 operator +(Int32 a, Int32 b);
    intrinsic public pure static Int32 operator -(Int32 a, Int32 b);
    intrinsic public pure static Int32 operator *(Int32 a, Int32 b);
    intrinsic public pure static Int32 operator /(Int32 a, Int32 b);
    intrinsic public pure static Int32 operator %(Int32 a, Int32 b);

    // Comparison operators — Requirement 3.2
    intrinsic public pure static Boolean operator <(Int32 a, Int32 b);
    intrinsic public pure static Boolean operator >(Int32 a, Int32 b);
    intrinsic public pure static Boolean operator <=(Int32 a, Int32 b);
    intrinsic public pure static Boolean operator >=(Int32 a, Int32 b);
    intrinsic public pure static Boolean operator ==(Int32 a, Int32 b);
    intrinsic public pure static Boolean operator !=(Int32 a, Int32 b);

    // Unary negation — Requirement 3.3
    intrinsic public pure static Int32 operator -(Int32 a);

    public pure Boolean IsEven()
    {
        return this % 2 == 0;
    }

    // Implicit widening conversions
    intrinsic public pure static implicit operator Int64(Int32 value);
    intrinsic public pure static implicit operator Single(Int32 value);
    intrinsic public pure static implicit operator Double(Int32 value);
    intrinsic public pure static implicit operator Decimal(Int32 value);

    // Result arithmetic composition (exceptions Requirement 4): ordinary overloads that carry an
    // existing error forward (the left one when both fail) or apply the operation to the proven
    // payloads, reusing the proof-sensitive division and remainder so one Result layer is kept.
    public static Result<Int32, DivisionError> operator +(Result<Int32, DivisionError> a, Int32 b)
    {
        var ai = a.Inspect();
        if (ai is (false, var error)) { return error; }
        if (ai is (true, var value)) { return value + b; }
        return a;
    }

    public static Result<Int32, DivisionError> operator +(Int32 a, Result<Int32, DivisionError> b)
    {
        var bi = b.Inspect();
        if (bi is (false, var error)) { return error; }
        if (bi is (true, var value)) { return a + value; }
        return b;
    }

    public static Result<Int32, DivisionError> operator +(Result<Int32, DivisionError> a, Result<Int32, DivisionError> b)
    {
        var ai = a.Inspect();
        if (ai is (false, var ae)) { return ae; }
        var bi = b.Inspect();
        if (bi is (false, var be)) { return be; }
        if (ai is (true, var av)) { if (bi is (true, var bv)) { return av + bv; } }
        return a;
    }

    public static Result<Int32, DivisionError> operator -(Result<Int32, DivisionError> a, Int32 b)
    {
        var ai = a.Inspect();
        if (ai is (false, var error)) { return error; }
        if (ai is (true, var value)) { return value - b; }
        return a;
    }

    public static Result<Int32, DivisionError> operator -(Int32 a, Result<Int32, DivisionError> b)
    {
        var bi = b.Inspect();
        if (bi is (false, var error)) { return error; }
        if (bi is (true, var value)) { return a - value; }
        return b;
    }

    public static Result<Int32, DivisionError> operator -(Result<Int32, DivisionError> a, Result<Int32, DivisionError> b)
    {
        var ai = a.Inspect();
        if (ai is (false, var ae)) { return ae; }
        var bi = b.Inspect();
        if (bi is (false, var be)) { return be; }
        if (ai is (true, var av)) { if (bi is (true, var bv)) { return av - bv; } }
        return a;
    }

    public static Result<Int32, DivisionError> operator *(Result<Int32, DivisionError> a, Int32 b)
    {
        var ai = a.Inspect();
        if (ai is (false, var error)) { return error; }
        if (ai is (true, var value)) { return value * b; }
        return a;
    }

    public static Result<Int32, DivisionError> operator *(Int32 a, Result<Int32, DivisionError> b)
    {
        var bi = b.Inspect();
        if (bi is (false, var error)) { return error; }
        if (bi is (true, var value)) { return a * value; }
        return b;
    }

    public static Result<Int32, DivisionError> operator *(Result<Int32, DivisionError> a, Result<Int32, DivisionError> b)
    {
        var ai = a.Inspect();
        if (ai is (false, var ae)) { return ae; }
        var bi = b.Inspect();
        if (bi is (false, var be)) { return be; }
        if (ai is (true, var av)) { if (bi is (true, var bv)) { return av * bv; } }
        return a;
    }

    public static Result<Int32, DivisionError> operator /(Result<Int32, DivisionError> a, Int32 b)
    {
        var ai = a.Inspect();
        if (ai is (false, var error)) { return error; }
        if (ai is (true, var value)) { return value / b; }
        return a;
    }

    public static Result<Int32, DivisionError> operator /(Int32 a, Result<Int32, DivisionError> b)
    {
        var bi = b.Inspect();
        if (bi is (false, var error)) { return error; }
        if (bi is (true, var value)) { return a / value; }
        return b;
    }

    public static Result<Int32, DivisionError> operator /(Result<Int32, DivisionError> a, Result<Int32, DivisionError> b)
    {
        var ai = a.Inspect();
        if (ai is (false, var ae)) { return ae; }
        var bi = b.Inspect();
        if (bi is (false, var be)) { return be; }
        if (ai is (true, var av)) { if (bi is (true, var bv)) { return av / bv; } }
        return a;
    }

    public static Result<Int32, DivisionError> operator %(Result<Int32, DivisionError> a, Int32 b)
    {
        var ai = a.Inspect();
        if (ai is (false, var error)) { return error; }
        if (ai is (true, var value)) { return value % b; }
        return a;
    }

    public static Result<Int32, DivisionError> operator %(Int32 a, Result<Int32, DivisionError> b)
    {
        var bi = b.Inspect();
        if (bi is (false, var error)) { return error; }
        if (bi is (true, var value)) { return a % value; }
        return b;
    }

    public static Result<Int32, DivisionError> operator %(Result<Int32, DivisionError> a, Result<Int32, DivisionError> b)
    {
        var ai = a.Inspect();
        if (ai is (false, var ae)) { return ae; }
        var bi = b.Inspect();
        if (bi is (false, var be)) { return be; }
        if (ai is (true, var av)) { if (bi is (true, var bv)) { return av % bv; } }
        return a;
    }

    // The same composition over the base Error, so a Result carrying any Error composes too: addition,
    // subtraction and multiplication carry it forward, while division and remainder fold their own
    // DivisionError up into the Error channel, since DivisionError is an Error.
    public static Result<Int32, Error> operator +(Result<Int32, Error> a, Int32 b)
    {
        var ai = a.Inspect();
        if (ai is (false, var error)) { return error; }
        if (ai is (true, var value)) { return value + b; }
        return a;
    }

    public static Result<Int32, Error> operator +(Int32 a, Result<Int32, Error> b)
    {
        var bi = b.Inspect();
        if (bi is (false, var error)) { return error; }
        if (bi is (true, var value)) { return a + value; }
        return b;
    }

    public static Result<Int32, Error> operator +(Result<Int32, Error> a, Result<Int32, Error> b)
    {
        var ai = a.Inspect();
        if (ai is (false, var ae)) { return ae; }
        var bi = b.Inspect();
        if (bi is (false, var be)) { return be; }
        if (ai is (true, var av)) { if (bi is (true, var bv)) { return av + bv; } }
        return a;
    }

    public static Result<Int32, Error> operator -(Result<Int32, Error> a, Int32 b)
    {
        var ai = a.Inspect();
        if (ai is (false, var error)) { return error; }
        if (ai is (true, var value)) { return value - b; }
        return a;
    }

    public static Result<Int32, Error> operator -(Int32 a, Result<Int32, Error> b)
    {
        var bi = b.Inspect();
        if (bi is (false, var error)) { return error; }
        if (bi is (true, var value)) { return a - value; }
        return b;
    }

    public static Result<Int32, Error> operator -(Result<Int32, Error> a, Result<Int32, Error> b)
    {
        var ai = a.Inspect();
        if (ai is (false, var ae)) { return ae; }
        var bi = b.Inspect();
        if (bi is (false, var be)) { return be; }
        if (ai is (true, var av)) { if (bi is (true, var bv)) { return av - bv; } }
        return a;
    }

    public static Result<Int32, Error> operator *(Result<Int32, Error> a, Int32 b)
    {
        var ai = a.Inspect();
        if (ai is (false, var error)) { return error; }
        if (ai is (true, var value)) { return value * b; }
        return a;
    }

    public static Result<Int32, Error> operator *(Int32 a, Result<Int32, Error> b)
    {
        var bi = b.Inspect();
        if (bi is (false, var error)) { return error; }
        if (bi is (true, var value)) { return a * value; }
        return b;
    }

    public static Result<Int32, Error> operator *(Result<Int32, Error> a, Result<Int32, Error> b)
    {
        var ai = a.Inspect();
        if (ai is (false, var ae)) { return ae; }
        var bi = b.Inspect();
        if (bi is (false, var be)) { return be; }
        if (ai is (true, var av)) { if (bi is (true, var bv)) { return av * bv; } }
        return a;
    }

    public static Result<Int32, Error> operator /(Result<Int32, Error> a, Int32 b)
    {
        var ai = a.Inspect();
        if (ai is (false, var error)) { return error; }
        if (ai is (true, var value))
        {
            var qi = (value / b).Inspect();
            if (qi is (false, var de)) { return de; }
            if (qi is (true, var qv)) { return qv; }
        }
        return a;
    }

    public static Result<Int32, Error> operator /(Int32 a, Result<Int32, Error> b)
    {
        var bi = b.Inspect();
        if (bi is (false, var error)) { return error; }
        if (bi is (true, var value))
        {
            var qi = (a / value).Inspect();
            if (qi is (false, var de)) { return de; }
            if (qi is (true, var qv)) { return qv; }
        }
        return b;
    }

    public static Result<Int32, Error> operator /(Result<Int32, Error> a, Result<Int32, Error> b)
    {
        var ai = a.Inspect();
        if (ai is (false, var ae)) { return ae; }
        var bi = b.Inspect();
        if (bi is (false, var be)) { return be; }
        if (ai is (true, var av))
        {
            if (bi is (true, var bv))
            {
                var qi = (av / bv).Inspect();
                if (qi is (false, var de)) { return de; }
                if (qi is (true, var qv)) { return qv; }
            }
        }
        return a;
    }

    public static Result<Int32, Error> operator %(Result<Int32, Error> a, Int32 b)
    {
        var ai = a.Inspect();
        if (ai is (false, var error)) { return error; }
        if (ai is (true, var value))
        {
            var qi = (value % b).Inspect();
            if (qi is (false, var de)) { return de; }
            if (qi is (true, var qv)) { return qv; }
        }
        return a;
    }

    public static Result<Int32, Error> operator %(Int32 a, Result<Int32, Error> b)
    {
        var bi = b.Inspect();
        if (bi is (false, var error)) { return error; }
        if (bi is (true, var value))
        {
            var qi = (a % value).Inspect();
            if (qi is (false, var de)) { return de; }
            if (qi is (true, var qv)) { return qv; }
        }
        return b;
    }

    public static Result<Int32, Error> operator %(Result<Int32, Error> a, Result<Int32, Error> b)
    {
        var ai = a.Inspect();
        if (ai is (false, var ae)) { return ae; }
        var bi = b.Inspect();
        if (bi is (false, var be)) { return be; }
        if (ai is (true, var av))
        {
            if (bi is (true, var bv))
            {
                var qi = (av % bv).Inspect();
                if (qi is (false, var de)) { return de; }
                if (qi is (true, var qv)) { return qv; }
            }
        }
        return a;
    }
}
