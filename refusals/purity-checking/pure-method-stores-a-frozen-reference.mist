using Standard;

namespace Refusal;

public class Bag
{
    public int Count;

    public pure Bag()
    {
    }
}

public class Holder
{
    public Bag Item;
}

public class Keeper
{
    public static pure int Keep(frozen Bag b)
    {
        var h = new Holder();
        // REFUSE: MIST_PA_PURE_SCOPE_STORES_UNOWNED
        h.Item = b;
        return 1;
    }
}

public class Probe
{
    public static void Main()
    {
        owned var b = new Bag();
        var k = Keeper.Keep(b);
        Console.WriteLine("unreachable");
    }
}
