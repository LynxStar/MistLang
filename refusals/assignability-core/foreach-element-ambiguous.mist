using Standard;

namespace Refusal;

public class Tally
{
    public static implicit operator int(Tally t)
    {
        return 1;
    }

    public static implicit operator long(Tally t)
    {
        return 2L;
    }
}

public class Probe
{
    public static void Main()
    {
        Tally[] tallies = [new Tally()];
        // REFUSE: MIST_PA_AMBIGUOUS_IMPLICIT_CONVERSION
        foreach(double each in tallies)
        {
            Console.WriteLine(each);
        }
    }
}
