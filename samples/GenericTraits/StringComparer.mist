namespace GenericTraits;

// Class satisfying Comparable<string> — CompareTo(string) matches CompareTo(T) with T=string
public class StringComparer : Comparable<string>
{
    private string value;

    public StringComparer(string v)
    {
        value = v;
    }

    public int CompareTo(string other)
    {
        return 0;
    }
}
