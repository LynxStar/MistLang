// AllFeaturesV2 -- Orchestrator that exercises every sample currently working on
// the experimental (v2) compiler pipeline, by calling into each sample project
// via [references].
//
// THIS FILE IS THE RECORDED V2 PROGRESSION. A sample is "working on v2" if and
// only if it is referenced here and its RunDemo() is called below. Enabling a
// sample means adding it in both places and extending the stored baseline at
// samples/__baselines__/AllFeaturesV2.out.
//
// Progress cannot be silently lost: removing a sample shrinks the program's
// output, which fails the Tier 6 baseline diff.

using Standard;

namespace AllFeaturesV2;

public class Program
{
    public static void Main(string[] args)
    {
        Console.WriteLine("=== AllFeaturesV2 Mist Sample ===");
        Simpliest.Program.RunDemo();
        Primitives.Program.RunDemo();
        ArrayLiterals.Program.RunDemo();
        Overloading.Program.RunDemo();
        HelloMist.Program.RunDemo();
        Classes.Program.RunDemo();
        Inheritance.Program.RunDemo();
        StormAnonymousGroups.Program.RunDemo();
        Namespaces.Program.RunDemo();
        GlobalUsings.Program.RunDemo();
        GenericTypes.Program.RunDemo();
        ArityOverloads.Program.RunDemo();
        TopLevelStatements.Program.RunDemo();
    }
}
