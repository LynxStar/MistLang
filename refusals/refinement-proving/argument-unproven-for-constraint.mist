using Standard;

namespace Refusal;

public class Probe
{
    public static string Process(int x) where x < 100
    {
        return "ok";
    }

    public static string Accept(int x)
    {
        // REFUSE: MIST_PA_CONSTRAINT_UNPROVEN
        return Process(x);
    }

    public static void Main()
    {
        Console.WriteLine(Accept(20));
        Console.WriteLine("unreachable");
    }
}
