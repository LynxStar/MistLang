using Standard;

namespace Refusal;

public class Grid
{
    public int cell;

    public int this[int i]
    {
        get
        {
            return cell;
        }
        set
        {
            cell = value;
        }
    }
}

public class Probe
{
    public readonly int Fill(Grid grid)
    {
        // REFUSE: MIST_PA_READONLY_CONTEXT_SETS_PROPERTY
        grid[0] = 1;
        return grid[0];
    }

    public static void Main()
    {
        var p = new Probe();
        var g = new Grid();
        var f = p.Fill(g);
        Console.WriteLine("unreachable");
    }
}
