using Standard;

namespace Refusal;

public class Counter
{
    public int count;

    public void Bump()
    {
        count = count + 1;
    }
}

public class Probe
{
    public static void Use(readonly Counter counter)
    {
        // REFUSE: MIST_PA_READONLY_PARAMETER_CALLS_MUTABLE
        counter.Bump();
    }

    public static void Main()
    {
        Use(new Counter());
        Console.WriteLine("unreachable");
    }
}
