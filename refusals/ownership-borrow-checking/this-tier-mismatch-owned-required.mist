using Standard;

namespace Refusal;

public class Account
{
    public owned string Name;

    public Account(owned string name)
    {
        this.Name = name;
    }

    public string Close() with owned
    {
        return Name;
    }
}

public class Probe
{
    public static void Shut(Account a)
    {
        // REFUSE: MIST_PA_THIS_TIER_MISMATCH
        Console.WriteLine(a.Close());
    }

    public static void Main()
    {
        owned var a = new Account("a");
        Shut(a);
        Console.WriteLine("unreachable");
    }
}
