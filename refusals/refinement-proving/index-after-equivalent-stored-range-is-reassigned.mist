using Standard;

namespace Refusal;

public class Probe
{
    public static int Read(bool flag, Range replacement)
    {
        var numbers = [10, 20, 30, 40, 50];
        Range window = 0..3;
        if(flag)
        {
            window = 0..3;
        }

        window = replacement;
        var slice = numbers[window];
        // REFUSE: MIST_PA_INDEX_UNPROVEN
        return slice[2];
    }

    public static void Main()
    {
        Console.WriteLine(Read(true, 0..1));
    }
}
