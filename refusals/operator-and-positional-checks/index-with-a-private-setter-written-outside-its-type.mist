using Standard;

namespace Refusal;

public class Ledger
{
    public int stored;

    public int this[int slot]
    {
        get { return stored + slot; }
        private set { stored = value; }
    }
}

public class Probe
{
    public static void Main()
    {
        var ledger = new Ledger();
        // REFUSE: MIST_PA_INACCESSIBLE_ACCESSOR
        ledger[0] = 5;
        Console.WriteLine("unreachable");
    }
}
