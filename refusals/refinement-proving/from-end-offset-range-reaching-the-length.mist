using Standard;

namespace Refusal;

public class Probe
{
    public static int Tail(int[] xs, int k)
    {
        if(k >= 0 && k <= 2 && xs.Length >= 2)
        {
            // REFUSE: MIST_PA_INDEX_UNPROVEN
            return xs[^k];
        }

        return 0;
    }

    public static void Main()
    {
        Console.WriteLine(Tail([1, 2], 0));
    }
}
