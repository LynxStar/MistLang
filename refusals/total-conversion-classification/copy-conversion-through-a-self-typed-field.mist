using Standard;

namespace Refusal;

public readonly class Node
{
    public int Item { get; }
    public Node? Next { get; }

    public Node(int item)
    {
        this.Item = item;
    }
}

type Chain = new Node;

public class Probe
{
    public static void Main()
    {
        var node = new Node(1);
        // REFUSE: MIST_PA_COPY_CONVERSION_DOES_NOT_HOLD
        var chain = (Chain)node;
        Console.WriteLine("unreachable");
    }
}