// AllFeatures — Orchestrator that exercises every implemented Mist feature
// by calling into each feature sample project via [[references]].

using System;

namespace AllFeatures;

public class Program
{
    public static void Main(string[] args)
    {
        Console.WriteLine("=== AllFeatures Mist Sample ===");
        Primitives.Program.RunDemo();
        Classes.Program.RunDemo();
        AmbientTypes.Program.RunDemo();
        ShapeInterfaces.Program.RunDemo();
        GenericTypes.Program.RunDemo();
        Overloading.Program.RunDemo();
        VoidType.Program.RunDemo();
        CastOperators.Program.RunDemo();
        PatternMatching.Program.RunDemo();
        DefaultKeyword.Program.RunDemo();
        Tuples.Program.RunDemo();
        UnknownTypeDemo.RunDemo();
        Console.WriteLine("=== Done! ===");
    }
}
