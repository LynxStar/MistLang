public class Program
{
    public static int Factorial(int n)
    {
        if (n <= 1)
        {
            return 1;
        }
        return n * Factorial(n - 1);
    }

    public static void Main(string[] args)
    {
        Console.WriteLine($"5! = {Factorial(5)}");
        Console.WriteLine($"10! = {Factorial(10)}");
    }
}
