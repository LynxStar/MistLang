namespace GenericTraits;

// Generic abstract type with type parameter used as method parameter type
abstract Comparable<T>
{
    int CompareTo(T other);
}

// Generic abstract type with type parameter used as a property type
abstract Container<T>
{
    T Data { get; }
}

// Generic abstract type with type parameter used as a return type
abstract Provider<T>
{
    T Provide();
}

// Generic abstract type with multiple type parameters used in different positions
abstract Converter<TIn, TOut>
{
    TOut Convert(TIn input);
}

// Non-generic abstract types
abstract Readable
{
    string Read();
}

abstract Writable
{
    void Write(string data);
}

// Abstract type extending multiple non-generic parent abstract types
abstract ReadWriteStream : Readable, Writable
{
    void Flush();
}
