<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>mist</AssemblyName>
    <PackageId>Mist.CLI</PackageId>
    <!-- These only take effect during 'dotnet publish -r <rid>'.
         Keeping them unconditional causes VS/MSBuild to infer a RID during
         normal builds, producing a platform-specific DLL (e.g. win-x64/mist.dll)
         that triggers MSB3270 in referencing AnyCPU projects like the test suite. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <PublishTrimmed Condition="'$(RuntimeIdentifier)' != ''">true</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mist\Mist.csproj" />
  </ItemGroup>

  <!--
    Package the Mist Standard Library alongside the compiler binary so that
    StdlibLoader.LoadFor can resolve AppContext.BaseDirectory/Standard/ at
    runtime. CopyToOutputDirectory ensures `dotnet build` (used by the test
    suite) produces the layout too; CopyToPublishDirectory ensures
    `dotnet publish` ships the files in production builds (Requirement 15.5).
    TargetPath mirrors the source tree structure under a `Standard/` prefix.
  -->
  <ItemGroup>
    <Content Include="..\..\Source\Standard\**\*.mist"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true"
             TargetPath="Standard\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
