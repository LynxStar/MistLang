using Standard;

namespace Refusal;

public type Reader = pure func<int>;

public class Clock
{
    public static int Ticks;
}

public class Holder
{
    public static readonly Reader R = () =>
    {
        // REFUSE: MIST_PA_PURE_SCOPE_WRITES
        Clock.Ticks = 1;
        return 1;
    };
}

public class Probe
{
    public static pure int Twice()
    {
        return Holder.R() + Holder.R();
    }

    public static void Main()
    {
        Console.WriteLine(Twice());
        Console.WriteLine("unreachable");
    }
}
