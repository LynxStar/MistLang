using Standard;

namespace Refusal;

public abstract IValidator
{
    string Validate(int value) where value >= 0;
}

public class Strict : IValidator
{
    // REFUSE: MIST_PA_CONSTRAINT_STRENGTHENED
    public string Validate(int value) where value >= 10
    {
        return "strict";
    }
}

public class Probe
{
    public static void Main()
    {
        var v = new Strict();
        Console.WriteLine(v.Validate(20));
        Console.WriteLine("unreachable");
    }
}
