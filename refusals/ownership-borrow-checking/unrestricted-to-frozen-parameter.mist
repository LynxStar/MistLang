using Standard;

namespace Refusal;

public owned class Engine
{
    public int Rpm;

    public Engine(int rpm)
    {
        this.Rpm = rpm;
    }

    public void Rev(int by)
    {
        this.Rpm = this.Rpm + by;
    }

    public int Get()
    {
        return Rpm;
    }
}

public class Probe
{
    public static void Freeze(frozen Engine e)
    {
        Console.WriteLine(e.Get());
    }

    public static void Main()
    {
        var e = new Engine(1);
        // REFUSE: MIST_PA_INCOMPATIBLE_LEND
        Freeze(e);
        Console.WriteLine("unreachable");
    }
}
