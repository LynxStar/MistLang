using Standard;

namespace NewtypeClones;

// A newtype is a renamed clone of its source with no nominal relationship to it: a copyable source is
// left for implicitly and entered by a cast, a literal enters only where the slot's type is in sight, and
// a class that defines its own copy converts by running that Clone with the operand as this. Classic
// implements the earlier revision of the newtypes spec, so this sample is banked on AllFeaturesV2 alone.
public struct Point
{
    public int X;
    public int Y;

    public Point(int x, int y)
    {
        this.X = x;
        this.Y = y;
    }

    public Point Shifted(int dx)
    {
        return new Point(X + dx, Y);
    }
}

public readonly class Money
{
    public int Amount { get; }

    public Money(int amount)
    {
        this.Amount = amount;
    }
}

public class Reading
{
    public double Raw;

    public Reading(double raw)
    {
        this.Raw = raw;
    }

    public static implicit operator double(Reading reading)
    {
        return reading.Raw;
    }
}

public class Cat
{
    protected int lives;

    public Cat()
    {
        this.lives = 9;
    }

    public string Kind()
    {
        return $"cat with {lives} lives";
    }
}

public class Tiger : Cat, IClonable<Tiger>
{
    private static int made = 0;
    private int stripes;
    private string keeper { get; set; }

    public string Name { get; set; }

    public Tiger(string name, int stripes) : base()
    {
        this.Name = name;
        this.stripes = stripes;
        this.keeper = "zoo";
    }

    private Tiger(int stripes) : base()
    {
        this.Name = "unnamed";
        this.stripes = stripes;
        this.keeper = "none";
    }

    private int Inherited()
    {
        return stripes + lives - 9;
    }

    public Tiger Twin()
    {
        return new Tiger(Name + "-twin", stripes);
    }

    public owned Tiger Clone()
    {
        made = made + 1;
        var copy = new Tiger(Inherited());
        copy.Name = $"{Name}#{made}";
        copy.keeper = keeper;
        return copy;
    }

    public string Describe()
    {
        return $"{Name} stripes={stripes} keeper={keeper} made={made}";
    }

    public void Paint(int more)
    {
        stripes = stripes + more;
    }
}

public class Lion : IClonable<Lion>
{
    private int mane;

    public Lion(int mane)
    {
        this.mane = mane;
    }

    public owned Lion Clone()
    {
        return new Lion(0) { mane = mane + 1 };
    }

    public int Mane()
    {
        return mane;
    }
}

public class Box<T>
{
    private T item;

    public Box(T item)
    {
        this.item = item;
    }

    public T Get()
    {
        return item;
    }

    public Box<T> Again()
    {
        return new Box<T>(item);
    }

    public Box<string> Named()
    {
        return new Box<string>($"<{item}>");
    }
}

public struct Pair<A, B>
{
    private A first;
    public B Second { get; set; }

    public Pair(A first, B second)
    {
        this.first = first;
        this.Second = second;
    }

    public A First()
    {
        return first;
    }
}

public class Cell<T> : IClonable<Cell<T>>
{
    private static int made = 0;
    private T content;
    private string label { get; set; }

    public Cell(T content)
    {
        this.content = content;
        this.label = "fresh";
    }

    private Cell(T content, string label)
    {
        this.content = content;
        this.label = label;
    }

    public owned Cell<T> Clone()
    {
        made = made + 1;
        return new Cell<T>(content, $"{label}#{made}");
    }

    public string Describe()
    {
        return $"{content} {label} made={made}";
    }
}

public abstract ITag
{
    string Tag();
}

public class Mark : ITag
{
    private string text;

    public Mark(string text)
    {
        this.text = text;
    }

    public string Tag()
    {
        return text;
    }
}

public class Lynx : IClonable<Lynx>
{
    private int spots;
    private int? spare;

    private int? Spare
    {
        get { return spare; }
        set { spare = value; }
    }

    private int this[int index]
    {
        get { return spots + index; }
        set { spots = value - index; }
    }

    public Lynx(int spots)
    {
        this.spots = spots;
    }

    private string Shown<U>(U item) where U : ITag
    {
        return item.Tag();
    }

    private int Three()
    {
        return 3;
    }

    private void Bump()
    {
        spots = spots + 100;
    }

    public owned Lynx Clone()
    {
        var copy = new Lynx(spots);
        copy[1] = this[1] + 10;
        Lynx? maybe = copy;
        int? read = maybe?.spots;
        maybe?.Bump();
        copy.Spare ??= 5;
        Spare ??= 7;
        func<int> three = Three;
        func<int> copyThree = copy.Three;
        int fromRead = read ?? 0;
        int tagged = Shown<Mark>(new Mark("ab")).Length + copy.Shown<Mark>(new Mark("xyz")).Length;
        copy.spots = copy.spots + three() + copyThree() + fromRead + tagged;
        return copy;
    }

    public string Describe()
    {
        return $"spots={spots} spare={spare}";
    }
}

// A field whose type names the source answers the newtype in the clone, so no field of one stands for
// the corresponding field of the other and the copy cannot be field for field. A source that says how it
// is copied converts through that Clone instead: within the conversion, cloning a field IS the conversion,
// and a test naming the result type tests for the operand, so the whole chain crosses rather than the head.
public class Node<T> : IClonable<Node<T>>
{
    public T Item;
    public Node<T>? Next;
    private int depth;

    public Node(T item, Node<T>? next)
    {
        this.Item = item;
        this.Next = next;
        this.depth = 0;
    }

    public int Depth()
    {
        return depth;
    }

    public owned Node<T> Clone()
    {
        if(this.Next is Node<T> next)
        {
            var copy = new Node<T>(this.Item, next.Clone());
            copy.depth = next.depth + 1;
            return copy;
        }

        Node<T>? end = void;
        return new Node<T>(this.Item, end);
    }
}

public class Link : IClonable<Link>
{
    public int Item;
    public Link? Next;

    public Link(int item, Link? next)
    {
        this.Item = item;
        this.Next = next;
    }

    public owned Link Clone()
    {
        return new Link(this.Item, this.Next?.Clone());
    }
}

public type Slot = Pair<int, string>;

public type Age = new int;
public type Label = new string;
public type Position = new Point;
public type Cash = new Money;
public type Meters = new double;
public type Feet = new double;
public type Jaguar = new Tiger;
public type Puma = new Lion;
public type IntBox = new Box<int>;
public type Boxed<T> = new Box<T>;
public type IntPair = new Pair<int, string>;
public type AliasedPair = new Slot;
public type IntCell = new Cell<int>;
public type Twin<T> = new Pair<T, T>;
public type Swap<A, B> = new Pair<B, A>;
public type Celled<T> = new Cell<T>;
public type Ocelot = new Lynx;
public type Chain<T> = new Node<T>;
public type IntChain = new Node<int>;
public type Rope = new Link;

public class Person
{
    public Age Years = 18;
    public Label Title { get; set; } = "guest";
    public Meters Height => 2;
    public Age Retires;

    default {
        Retires = 67
    }

    public static Age Adult()
    {
        return 21;
    }
}

public class Program
{
    private static int Twice(int value)
    {
        return value * 2;
    }

    private static string Of(Position position)
    {
        return $"({position.X}, {position.Y})";
    }

    public static void RunDemo()
    {
        Console.WriteLine("=== Newtype Clones ===");

        Console.WriteLine("--- Intrinsic clone ---");
        Age age = 30;
        Age older = age + (Age)1;
        int raw = age;
        long wide = older;
        Label title = "mist";
        Label shout = title.ToUpper();
        Console.WriteLine($"older={older} raw={raw} wide={wide} twice={Twice(age + 1)} even={older.IsEven()}");
        Console.WriteLine($"shout={shout} length={title.Length}");

        Console.WriteLine("--- Never its source ---");
        unknown boxedAge = age;
        unknown boxedPosition = new Position(1, 2);
        unknown boxedJaguar = new Jaguar("Bagheera", 4);
        Console.WriteLine($"age-is-Age={boxedAge is Age} age-is-int={boxedAge is int}");
        Console.WriteLine($"position-is-Point={boxedPosition is Point} jaguar-is-Tiger={boxedJaguar is Tiger} jaguar-is-Cat={boxedJaguar is Cat}");

        Console.WriteLine("--- Struct clone ---");
        var position = new Position(1, 2);
        Point left = position;
        left.X = 99;
        Position entered = (Position)new Point(5, 6);
        Position shifted = position.Shifted(10);
        Console.WriteLine($"position={Of(position)} left.X={left.X} entered={Of(entered)} shifted={Of(shifted)}");

        Console.WriteLine("--- Readonly class clone ---");
        var cash = new Cash(7);
        Money money = cash;
        Cash back = (Cash)new Money(8);
        Console.WriteLine($"money={money.Amount} back={back.Amount}");

        Console.WriteLine("--- Cast through the source ---");
        var reading = new Reading(1.5);
        Meters fromReading = (Meters)reading;
        Feet feet = 3.0;
        Meters fromFeet = (Meters)feet;
        double total = fromReading + fromFeet;
        Console.WriteLine($"fromReading={fromReading} fromFeet={fromFeet} total={total}");

        Console.WriteLine("--- Literals in sight ---");
        Age assigned = (Age)1;
        assigned = 31;
        Age below = -5;
        Age[] ages = [40, 41];
        var person = new Person { Title = "host" };
        Console.WriteLine($"assigned={assigned} below={below} ages={ages[0]},{ages[1]}");
        Console.WriteLine($"years={person.Years} title={person.Title} height={person.Height} retires={person.Retires} adult={Person.Adult()}");

        Console.WriteLine("--- Renamed class clone ---");
        var jaguar = new Jaguar("Bagheera", 4);
        Jaguar twin = jaguar.Twin();
        Cat cat = jaguar;
        Console.WriteLine($"twin={twin.Describe()} kind={cat.Kind()}");

        Console.WriteLine("--- Clonable class conversions ---");
        var tiger = new Tiger("Shere", 3);
        var first = (Jaguar)tiger;
        var converted = (Jaguar)tiger;
        converted.Paint(100);
        var returned = (Tiger)converted;
        Console.WriteLine($"first={first.Describe()}");
        Console.WriteLine($"converted={converted.Describe()}");
        Console.WriteLine($"returned={returned.Describe()}");
        Console.WriteLine($"tiger={tiger.Describe()}");
        var puma = (Puma)new Lion(3);
        Console.WriteLine($"puma-mane={puma.Mane()} lion-mane={((Lion)puma).Mane()}");

        Console.WriteLine("--- Constructed and aliased sources ---");
        var box = new IntBox(5);
        IntBox again = box.Again();
        Box<string> named = box.Named();
        Boxed<string> renamed = new Boxed<bool>(true).Named();
        unknown boxedBox = box;
        Console.WriteLine($"again={again.Get()} named={named.Get()} renamed={renamed.Get()} box-is-Box={boxedBox is Box<int>}");
        var pair = new IntPair(1, "one");
        Pair<int, string> leftPair = pair;
        IntPair enteredPair = (IntPair)new Pair<int, string>(2, "two");
        Slot slot = new AliasedPair(3, "three");
        Console.WriteLine($"leftPair={leftPair.First()},{leftPair.Second} enteredPair={enteredPair.First()},{enteredPair.Second} slot={slot.First()},{slot.Second}");

        Console.WriteLine("--- Clonable constructed source ---");
        var cell = new Cell<int>(3);
        var firstCell = (IntCell)cell;
        var secondCell = (IntCell)cell;
        var cellBack = (Cell<int>)secondCell;
        Console.WriteLine($"firstCell={firstCell.Describe()} secondCell={secondCell.Describe()}");
        Console.WriteLine($"cellBack={cellBack.Describe()} cell={cell.Describe()}");

        Console.WriteLine("--- Generic newtype conversions ---");
        var twinPair = (Twin<int>)new Pair<int, int>(4, 5);
        Pair<int, int> leftTwin = twinPair;
        var swap = (Swap<int, string>)new Pair<string, int>("six", 6);
        Pair<string, int> leftSwap = swap;
        Console.WriteLine($"twinPair={twinPair.First()},{twinPair.Second} leftTwin={leftTwin.First()},{leftTwin.Second} swap={swap.First()},{swap.Second} leftSwap={leftSwap.First()},{leftSwap.Second}");
        var word = new Cell<string>("w");
        var firstWord = (Celled<string>)word;
        var secondWord = (Celled<string>)word;
        var wordBack = (Cell<string>)secondWord;
        Console.WriteLine($"firstWord={firstWord.Describe()} secondWord={secondWord.Describe()}");
        Console.WriteLine($"wordBack={wordBack.Describe()} word={word.Describe()}");

        Console.WriteLine("--- Members a Clone reaches ---");
        var lynx = new Lynx(4);
        var ocelot = (Ocelot)lynx;
        var lynxBack = (Lynx)ocelot;
        Console.WriteLine($"lynx={lynx.Describe()} ocelot={ocelot.Describe()} lynxBack={lynxBack.Describe()}");

        Console.WriteLine("--- A field that names its source ---");
        Node<int>? noNode = void;
        var nodes = new Node<int>(1, new Node<int>(2, new Node<int>(3, noNode)));
        var chain = (Chain<int>)nodes;
        var nodesBack = (Node<int>)chain;
        Console.WriteLine($"chain={SpellChain(chain)} back={SpellNodes(nodesBack)}");
        var closed = (IntChain)nodes;
        if(nodes.Next is Node<int> second)
        {
            second.Item = 99;
        }

        Console.WriteLine($"closed={closed.Item},{closed.Next is void} apart={SpellChain(chain)} source={SpellNodes(nodes)}");
        Link? noLink = void;
        var rope = (Rope)new Link(4, new Link(5, noLink));
        var tail = (Rope)new Link(6, noLink);
        Console.WriteLine($"rope={SpellRope(rope)} tail={tail.Item},{tail.Next is void}");

        Console.WriteLine("=== Newtype Clones Done ===");
    }

    public static string SpellNodes(Node<int>? head)
    {
        var text = "";
        var cursor = head;
        while(cursor is Node<int> here)
        {
            text = $"{text} {here.Item}/{here.Depth()}";
            cursor = here.Next;
        }

        return text;
    }

    public static string SpellChain(Chain<int>? head)
    {
        var text = "";
        var cursor = head;
        while(cursor is Chain<int> here)
        {
            text = $"{text} {here.Item}/{here.Depth()}";
            cursor = here.Next;
        }

        return text;
    }

    public static string SpellRope(Rope? head)
    {
        var text = "";
        var cursor = head;
        while(cursor is Rope here)
        {
            text = $"{text} {here.Item}";
            cursor = here.Next;
        }

        return text;
    }

    public static void Main(string[] args)
    {
        RunDemo();
    }
}
