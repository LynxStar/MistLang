using Standard;

namespace Refusal;

public class Waiter
{
    public static pure int Wait(Task<int> t)
    {
        // REFUSE: MIST_PA_PURE_SCOPE_CALLS_IMPURE
        return await t;
    }
}

public class Probe
{
    public static void Main()
    {
        var w = Waiter.Wait(async { return 1; });
        Console.WriteLine("unreachable");
    }
}
