// Rectangle — Demonstrates a class implementing a child interface (IResizable : IShape).

using System;

namespace AllFeatures;

public class Rectangle : IResizable
{
    private int _width;
    private int _height;

    public Rectangle(int width, int height)
    {
        this._width = width;
        this._height = height;
    }

    public string Describe()
    {
        return $"Rectangle(width={_width}, height={_height})";
    }

    public int Area()
    {
        return _width * _height;
    }

    public int ResizedArea(int factor)
    {
        return (_width * factor) * (_height * factor);
    }
}
