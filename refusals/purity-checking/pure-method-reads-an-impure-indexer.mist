using Standard;

namespace Refusal;

public class Log
{
    public static int reads;
    public int cell;

    public int this[int i]
    {
        get
        {
            reads = reads + 1;
            return cell;
        }
    }

    public pure int Peek()
    {
        // REFUSE: MIST_PA_PURE_SCOPE_CALLS_IMPURE
        return this[0];
    }
}

public class Probe
{
    public static void Main()
    {
        var log = new Log();
        var p = log.Peek();
        Console.WriteLine("unreachable");
    }
}
