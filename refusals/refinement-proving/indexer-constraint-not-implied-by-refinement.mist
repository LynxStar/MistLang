using Standard;

namespace Refusal;

type Digit = int >= 0 and <= 9;

public class Buffer
{
    int[5] items = new int[5];

    public int this[int index] where index >= 0 and < 5
    {
        get { return items[index]; }
        set { items[index] = value; }
    }
}

public class Probe
{
    public static int At(Digit d)
    {
        var b = new Buffer();
        // REFUSE: MIST_PA_CONSTRAINT_UNPROVEN
        return b[d];
    }

    public static void Main()
    {
        Digit d = 1;
        Console.WriteLine(At(d));
        Console.WriteLine("unreachable");
    }
}
