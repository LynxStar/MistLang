using Standard;

namespace Refusal;

public owned class Engine
{
    public int Rpm;

    public Engine(int rpm)
    {
        this.Rpm = rpm;
    }

    public int Get()
    {
        return Rpm;
    }
}

public class Probe
{
    public static int Peek(borrowed Engine e)
    {
        int Read()
        {
            // REFUSE: MIST_PA_CAPTURED_BINDING
            return e.Get();
        }

        return Read();
    }

    public static void Main()
    {
        owned var e = new Engine(1);
        Console.WriteLine(Peek(e));
    }
}
