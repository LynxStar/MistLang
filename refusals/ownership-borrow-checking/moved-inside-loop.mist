using Standard;

namespace Refusal;

public owned class Engine
{
    public int Rpm;

    public Engine(int rpm)
    {
        this.Rpm = rpm;
    }

    public void Rev(int by)
    {
        this.Rpm = this.Rpm + by;
    }

    public int Get()
    {
        return Rpm;
    }
}

public class Probe
{
    public static void Consume(owned Engine e)
    {
        Console.WriteLine(e.Get());
    }

    public static void Main()
    {
        var flag = true;
        owned var e = new Engine(1);
        while(flag)
        {
            // REFUSE: MIST_PA_LOOP_MOVE
            Consume(e);
            flag = false;
        }
        Console.WriteLine("unreachable");
    }
}
