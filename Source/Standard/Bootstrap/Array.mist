namespace Standard;

public type ZeroOrPositiveInt = int >= 0;

intrinsic public class Array<TValue, Length:ZeroOrPositiveInt> : IEnumerable<TValue>
{
    public type ArrayBounds = ZeroOrPositiveInt and < Length;

    // No `Length` property is declared: the dependent type parameter above already IS the
    // length, and declaring both makes a bare `arr.Length` match two declarations at once.
    // Reading it goes through the parameter, so the length stays a single source of truth.

    intrinsic public TValue this[ArrayBounds index] { get; set; }

    intrinsic public Array(Func<int, TValue> initializer);

    intrinsic public struct Enumerator : IEnumerator<TValue> {
        intrinsic public bool MoveNext();
        intrinsic public TValue Current { get; }
    }

    intrinsic public Enumerator GetEnumerator();
}
