// Rectangle — Demonstrates a class implementing a child abstract type (IResizable : IShape) with properties.

using Standard;

namespace ShapeAbstracts;

public class Rectangle : IResizable
{
    // Auto-property implementing IShape.Name
    public string Name { get; }

    // Auto-property implementing IResizable.Scale
    public int Scale { get; set; } = 1;

    private int _width;
    private int _height;

    public Rectangle(int width, int height)
    {
        this.Name = "Rectangle";
        this._width = width;
        this._height = height;
    }

    public string Describe()
    {
        return $"Rectangle(width={_width}, height={_height})";
    }

    public int Area()
    {
        return _width * _height;
    }

    public int ResizedArea(int factor)
    {
        return (_width * factor) * (_height * factor);
    }
}
