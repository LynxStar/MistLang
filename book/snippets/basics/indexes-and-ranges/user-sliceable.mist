using Standard;

// Shelf has a Range indexer, so a range is handed to it whole. Tape has no Range indexer, so a range
// reaches its Slice(int, int) as the start and the length, decoded against its Length. A list pattern's
// slice goes through the same member.
public class Shelf
{
    private string[4] books = ["Dune", "Emma", "Ivanhoe", "Kim"];

    public int Count
    {
        get
        {
            return 4;
        }
    }

    public string this[int index] where index >= 0 and < 4
    {
        get
        {
            return books[index];
        }
    }

    public string[] this[Range range]
    {
        get
        {
            return books[range];
        }
    }
}

public class Tape
{
    public int Length
    {
        get
        {
            return 10;
        }
    }

    public string Slice(int start, int length)
    {
        return $"start={start} length={length}";
    }
}

public class Program
{
    public static void Main(string[] args)
    {
        var shelf = new Shelf();
        foreach (var book in shelf[1..3])
        {
            Console.WriteLine(book);
        }

        var tape = new Tape();
        Console.WriteLine(tape[2..5]);
        Console.WriteLine(tape[^3..]);

        if (shelf is [var first, .. var rest])
        {
            Console.WriteLine($"{first} then {rest.Length} more");
        }
    }
}
