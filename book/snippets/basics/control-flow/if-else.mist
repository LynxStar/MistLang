using Standard;

public class Program
{
    public static void Main(string[] args)
    {
        var score = 85;

        if (score >= 90)
        {
            Console.WriteLine("Grade: A");
        }
        else if (score >= 80)
        {
            Console.WriteLine("Grade: B");
        }
        else
        {
            Console.WriteLine("Grade: C or below");
        }
    }
}
