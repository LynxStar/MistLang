using Standard;

namespace Refusal;

type AdultAge = int >= 18;
type DrinkingAge = int >= 21;

public class Probe
{
    public static int Serve(int x)
    {
        if(x is AdultAge a)
        {
            // REFUSE: MIST_PA_REFINEMENT_NOT_IMPLIED
            DrinkingAge d = a;
            return d;
        }

        return 0;
    }

    public static void Main()
    {
        Console.WriteLine(Serve(30));
        Console.WriteLine("unreachable");
    }
}
