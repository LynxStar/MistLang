using Standard;

namespace Refusal;

public abstract IValidator
{
    string Validate(int value) where value >= 0;
}

public class Lenient : IValidator
{
    public string Validate(int value)
    {
        return "ok";
    }
}

public class Probe
{
    public static string Accept(int x)
    {
        IValidator v = new Lenient();
        // REFUSE: MIST_PA_CONSTRAINT_UNPROVEN
        return v.Validate(x);
    }

    public static void Main()
    {
        Console.WriteLine(Accept(20));
        Console.WriteLine("unreachable");
    }
}
