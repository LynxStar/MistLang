using Standard;

namespace GenericTraits;

// Entry point
public class Program
{
    private static void PrintReadable(Readable item)
    {
        Console.WriteLine($"  PrintReadable: {item.Read()}");
    }

    public static void RunDemo()
    {
        Console.WriteLine("=== Generic Traits Demo ===");

        // 1. Comparable<T>: type parameter as method parameter type
        Console.WriteLine("--- 1. Type parameter as method parameter (Comparable<T>) ---");
        var ic = new IntComparer(10);
        Comparable<int> comp = ic;
        var cmpResult = comp.CompareTo(5);
        Console.WriteLine($"  IntComparer(10).CompareTo(5) = {cmpResult}");

        // 2. Comparable<string>: same trait, different type argument
        Console.WriteLine("--- 2. Same trait, different type arg (Comparable<string>) ---");
        var sc = new StringComparer("hello");
        Comparable<string> scomp = sc;
        var scmpResult = scomp.CompareTo("world");
        Console.WriteLine($"  StringComparer.CompareTo(\"world\") = {scmpResult}");

        // 3. Container<T>: type parameter as field type
        Console.WriteLine("--- 3. Type parameter as field type (Container<T>) ---");
        var box = new IntBox(42);
        Container<int> container = box;
        Console.WriteLine($"  IntBox(42) via Container<int>.Data = {container.Data}");

        // 4. Provider<T>: type parameter as return type
        Console.WriteLine("--- 4. Type parameter as return type (Provider<T>) ---");
        var prov = new NameProvider("hello");
        Provider<string> provider = prov;
        Console.WriteLine($"  NameProvider via Provider<string>.Provide() = {provider.Provide()}");

        // 5. Converter<TIn, TOut>: multiple type parameters
        Console.WriteLine("--- 5. Multiple type parameters (Converter<TIn, TOut>) ---");
        var conv = new IntToString();
        Converter<int, string> converter = conv;
        Console.WriteLine($"  IntToString via Converter<int,string>.Convert(7) = {converter.Convert(7)}");

        // 6. Non-generic abstract type inheritance
        Console.WriteLine("--- 6. Non-generic abstract type inheritance ---");
        Console.WriteLine("  abstract ReadWriteStream : Readable, Writable { void Flush(); }");

        // 7. Nominal satisfaction of non-generic abstract type
        Console.WriteLine("--- 7. Nominal satisfaction of non-generic abstract type ---");
        var stream = new MemoryStream();
        Readable r = stream;
        Console.WriteLine($"  MemoryStream.Read() via Readable = {r.Read()}");

        // 8. With-block mapping for non-generic abstract type
        Console.WriteLine("--- 8. With-block mapping for non-generic abstract type ---");
        var logger = new Logger();
        Writable w = logger;
        w.Write("hello");
        Console.WriteLine("  Logger.Write() via Writable called successfully");

        // 9. Passing to abstract-typed parameter
        Console.WriteLine("--- 9. Passing to abstract-typed parameter ---");
        PrintReadable(stream);

        Console.WriteLine("=== Generic Traits Demo Complete ===");
    }
}
