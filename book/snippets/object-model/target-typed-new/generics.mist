class Pair<T>
{
    public T First;
    public T Second;

    public Pair(T first, T second)
    {
        First = first;
        Second = second;
    }

    public string Describe()
    {
        return $"Pair({First}, {Second})";
    }
}

class Program
{
    public static void Main(string[] args)
    {
        // Generic target type — type arguments are inferred from the declaration
        Pair<int> intPair = new(1, 2);
        Pair<string> strPair = new("hello", "world");
        Console.WriteLine(intPair.Describe());
        Console.WriteLine(strPair.Describe());
    }
}
