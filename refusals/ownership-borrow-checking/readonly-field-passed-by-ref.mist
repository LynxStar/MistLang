using Standard;

namespace Refusal;

public class Box
{
    public readonly int K;

    public pure Box(int k)
    {
        K = k;
    }

    public static void Set(ref int slot)
    {
        slot = 8;
    }

    public void Twist()
    {
        // REFUSE: MIST_PA_READONLY_FIELD_ASSIGNED
        Set(ref K);
    }
}

public class Probe
{
    public static void Main()
    {
        var b = new Box(1);
        b.Twist();
        Console.WriteLine(b.K);
        Console.WriteLine("unreachable");
    }
}
