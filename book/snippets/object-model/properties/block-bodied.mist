using System;

namespace Demo;

public class Thermostat
{
    public Thermostat(int initial)
    {
        this.Temperature = initial;
    }

    public int Temperature
    {
        get
        {
            return field;
        }
        set
        {
            if (value < -273)
            {
                field = -273;
            }
            else
            {
                field = value;
            }
        }
    }
}
