using Standard;

namespace Refusal;

public class Ledger
{
    public int Count
    {
        get { return 3; }
    }

    public int this[int entry] where entry >= 0 and < Count
    {
        get { return entry; }
    }
}

public class Probe
{
    public static void Main()
    {
        var ledger = new Ledger();
        // REFUSE: MIST_PA_CONSTRAINT_VIOLATED
        int past = ledger[7];
        Console.WriteLine(past);
    }
}
