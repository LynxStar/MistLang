grammar Mist;
import "tokens/tokens";

// ─── Parser Rules — Top Level ────────────────────────────────────────────────

rule CompilationUnit = usings:UsingDeclaration* items:TopLevelItem*;

@memo
rule TopLevelItem
    = namespaceDeclaration:NamespaceDeclaration  as NamespaceItem
    | typeDeclaration:TypeDeclaration            as TypeItem
    | extensionDeclaration:ExtensionBlockDeclaration as ExtensionItem
    | withDeclaration:WithDeclaration            as WithItem
    | usingDeclaration:UsingDeclaration          as UsingItem
    | statement:Statement                        as StatementItem
    ;

rule UsingDeclaration = USING name:QualifiedIdentifier SEMICOLON;

rule QualifiedIdentifier = IDENTIFIER (DOT IDENTIFIER)*;

rule NamespaceBodyItem
    = typeDeclaration:TypeDeclaration              as NamespaceTypeItem
    | extensionDeclaration:ExtensionBlockDeclaration as NamespaceExtensionItem
    | namespaceDeclaration:NamespaceDeclaration    as NamespaceNamespaceItem
    ;

rule NamespaceDeclaration
    = NAMESPACE name:QualifiedIdentifier SEMICOLON body:NamespaceBodyItem*   as FileScopedNamespace
    | NAMESPACE name:QualifiedIdentifier LEFT_BRACE body:NamespaceBodyItem* RIGHT_BRACE as BlockNamespace
    ;

rule TypeDeclaration
    = typeBody:TypeBodyDeclaration as BodyType
    | enumDeclaration:EnumDeclaration as EnumType
    | newtypeDeclaration:NewtypeDeclaration as NewtypeType
    | typeAliasDeclaration:TypeAliasDeclaration as TypeAliasType
    ;

rule TypeAliasDeclaration = TYPE name:IDENTIFIER typeParams:TypeParameterList? EQUAL type:RefinableTypeExpression
    constraints:WhereClause*
    SEMICOLON;

rule RefinableTypeExpression = first:RefinableSingleTypeExpr (PIPE rest:RefinableSingleTypeExpr)*;

rule RefinableSingleTypeExpr = type:SingleTypeRef refinement:RefinementPredicate?;

rule RefinementPredicate
    = AND first:UnaryPattern (AND rest:UnaryPattern)*   as CompoundRefinementPredicate
    | predicate:AndPattern                              as SimpleRefinementPredicate
    ;

rule NewtypeDeclaration = TYPE name:IDENTIFIER EQUAL NEW sourceType:TypeReference SEMICOLON;

// ─── Parser Rules — Type Parameter and Type Argument Lists ───────────────────

rule TypeParameterList = LESS_THAN TypeParameter (COMMA TypeParameter)* GREATER_THAN;

rule TypeParameter
    = name:IDENTIFIER COLON valueType:PrimitiveType           as DependentTypeParameter
    | name:IDENTIFIER COLON constraintName:IDENTIFIER         as NamedConstraintDependentTypeParameter
    | name:IDENTIFIER                                          as RegularTypeParameter
    ;

rule TypeArgumentList = LESS_THAN TypeArgument (COMMA TypeArgument)* GREATER_THAN;

rule TypeArgument
    = MINUS literal:INTEGER_LITERAL   as NegatedIntegerTypeArgument
    | literal:INTEGER_LITERAL         as IntegerLiteralTypeArgument
    | literal:HEX_LITERAL             as HexLiteralTypeArgument
    | literal:BINARY_LITERAL          as BinaryLiteralTypeArgument
    | TRUE                            as TrueLiteralTypeArgument
    | FALSE                           as FalseLiteralTypeArgument
    | literal:CHAR_LITERAL            as CharLiteralTypeArgument
    | type:TypeReference              as TypeReferenceTypeArgument
    ;

// ─── Parser Rules — Constraint Clauses ───────────────────────────────────────

rule WhereClause
    = WHERE name:IDENTIFIER COLON constraints:ConstraintList  as GenericConstraintClause
    | WHERE name:IDENTIFIER predicate:AndPattern              as AdhocRefinementConstraint
    ;

rule ConstraintList = Constraint (COMMA Constraint)*;

rule Constraint
    = CLASS                                                                    as ClassConstraint
    | STRUCT                                                                   as StructConstraint
    | READONLY                                                                 as ReadonlyConstraint
    | MUTABLE                                                                  as MutableConstraint
    | OWNED                                                                    as OwnedConstraint
    | LINEAR                                                                   as LinearConstraint
    | AFFINE                                                                   as AffineConstraint
    | RELEVANT                                                                 as RelevantConstraint
    | NEW LEFT_PARENTHESIS paramTypes:ConstraintParameterTypeList? RIGHT_PARENTHESIS  as ConstructorConstraint
    | DEFAULT                                                                  as DefaultConstraint
    | type:TypeReference                                                       as TypeConstraint
    ;

rule ConstraintParameterTypeList = TypeReference (COMMA TypeReference)*;

// ─── Parser Rules — Attributes ───────────────────────────────────────────────

rule AttributeList = LEFT_BRACKET Attribute (COMMA Attribute)* RIGHT_BRACKET;

rule Attribute = name:QualifiedIdentifier typeArgs:TypeArgumentList?
    arguments:AttributeArguments?;

rule AttributeArguments = LEFT_PARENTHESIS argList:AttributeArgumentList? RIGHT_PARENTHESIS;

rule AttributeArgumentList = AttributeArgument (COMMA AttributeArgument)*;

rule AttributeArgument
    = name:IDENTIFIER EQUAL value:AttributeExpression  as NamedAttributeArgument
    | value:AttributeExpression               as PositionalAttributeArgument
    ;

// Attribute expressions are like regular expressions but with special handling
// for type literals with type arguments (e.g., List<int>) which would otherwise
// be ambiguous with relational comparisons in the general expression grammar.
// PEG ordered choice tries the generic type literal first; if it fails (no TypeArgumentList
// follows the identifier), it falls through to the regular expression path.
rule AttributeExpression
    = name:QualifiedIdentifier typeArgs:TypeArgumentList  as GenericTypeLiteralExpression
    | expr:Expression                                     as RegularExpression
    ;

// ─── Parser Rules — Type Declarations ────────────────────────────────────────

rule TypeKeyword = CLASS as ClassKeyword | STRUCT as StructKeyword | ABSTRACT as AbstractKeyword;

rule TypeBodyDeclaration = attributes:AttributeList* modifiers:Modifier* keyword:TypeKeyword name:IDENTIFIER
    typeParams:TypeParameterList?
    baseClause:(COLON baseList:BaseList)?
    constraints:WhereClause*
    LEFT_BRACE members:MemberDeclaration* RIGHT_BRACE;

rule BaseTypeRef = name:IDENTIFIER typeArgs:TypeArgumentList?;

rule BaseList = first:BaseTypeRef (COMMA rest:BaseTypeRef)*;

// ─── Parser Rules — Associated Type Slot Declarations ────────────────────────

rule AssociatedTypeSlotDeclaration = TYPE name:IDENTIFIER
    typeParams:TypeParameterList?
    COLON constraints:ConstraintList
    slotWhereConstraints:WhereClause*
    SEMICOLON;

rule UnconstrainedAssociatedTypeSlotDeclaration = TYPE name:IDENTIFIER
    typeParams:TypeParameterList?
    SEMICOLON;

rule ModifiedTypeHead = modifiers:Modifier+ TYPE name:IDENTIFIER typeParams:TypeParameterList?;

rule ModifiedAssociatedTypeSlotDeclaration = modifiers:Modifier+ TYPE name:IDENTIFIER
    typeParams:TypeParameterList?
    constraintClause:(COLON constraints:ConstraintList slotWhereConstraints:WhereClause*)?
    SEMICOLON;

// ─── Parser Rules — Enum Declarations ────────────────────────────────────────

rule EnumDeclaration = attributes:AttributeList* modifiers:Modifier* ENUM name:IDENTIFIER
    typeAnnotation:(COLON type:TypeReference)?
    LEFT_BRACE members:EnumMemberList? RIGHT_BRACE;

rule EnumMemberList = EnumMember (COMMA EnumMember)* COMMA?;

rule EnumMember = isDefault:DEFAULT? name:IDENTIFIER value:(EQUAL Expression)?;

// ─── Parser Rules — Extension Block Declaration ──────────────────────────────

rule ExtensionBlockDeclaration = typeParams:TypeParameterList?
    EXTENSION LEFT_PARENTHESIS receiverType:TypeReference receiverName:IDENTIFIER RIGHT_PARENTHESIS
    LEFT_BRACE members:ExtensionMemberDeclaration* RIGHT_BRACE;

rule ExtensionMemberDeclaration
    = method:MethodDeclaration    as ExtensionMethodMember
    | property:PropertyDeclaration as ExtensionPropertyMember
    ;

// ─── Parser Rules — With Declaration (Retroactive Conformance) ───────────────

rule WithDeclaration = WITH typeName:IDENTIFIER COLON abstractName:IDENTIFIER abstractTypeArgs:TypeArgumentList?
    LEFT_BRACE mappings:MemberMapping+ RIGHT_BRACE;

rule MemberMapping = sourceName:IDENTIFIER AS targetName:IDENTIFIER SEMICOLON;

// ─── Parser Rules — Modifiers ────────────────────────────────────────────────

rule Modifier
    = PUBLIC    as PublicModifier
    | PRIVATE   as PrivateModifier
    | STATIC    as StaticModifier
    | INTRINSIC as IntrinsicModifier
    | READONLY  as ReadonlyModifier
    | OWNED     as OwnedModifier
    | AFFINE    as AffineModifier
    | LINEAR    as LinearModifier
    | RELEVANT  as RelevantModifier
    | ASYNC     as AsyncModifier
    | REF       as RefModifier
    ;

// ─── Parser Rules — Ownership Specifiers ─────────────────────────────────────

rule OwnershipSpecifier
    = OWNED                as OwnedSpecifier
    | FROZEN               as FrozenSpecifier
    | READONLY REF         as ReadonlyRefSpecifier
    | BORROWED             as BorrowedSpecifier
    | REF                  as RefSpecifier
    ;

rule MemberDeclaration
    = constructor:ConstructorDeclaration as ConstructorMember
    | method:MethodDeclaration           as MethodMember
    | operator:OperatorDeclaration       as OperatorMember
    | castOperator:CastOperatorDeclaration as CastOperatorMember
    | property:PropertyDeclaration       as PropertyMember
    | indexer:IndexerDeclaration         as IndexerMember
    | defaultBlock:DefaultBlockDeclaration as DefaultBlockMember
    | field:FieldDeclaration             as FieldMember
    | nestedType:TypeDeclaration         as NestedTypeMember
    | inline ModifiedTypeHead: {
          memberTypeAlias:MemberTypeAliasDeclaration as MemberTypeAliasMember,
          modifiedAssociatedType:ModifiedAssociatedTypeSlotDeclaration as ModifiedAssociatedTypeMember,
      }
    | associatedType:AssociatedTypeSlotDeclaration as AssociatedTypeMember
    | unconstrainedAssociatedType:UnconstrainedAssociatedTypeSlotDeclaration as UnconstrainedAssociatedTypeMember
    ;

rule MemberTypeAliasDeclaration = modifiers:Modifier+ TYPE name:IDENTIFIER
    typeParams:TypeParameterList?
    EQUAL type:RefinableTypeExpression
    constraints:WhereClause*
    SEMICOLON;

// ─── Parser Rules — Default Block ───────────────────────────────────────────

rule DefaultNestedOverride = fieldName:IDENTIFIER EQUAL value:Expression;

rule DefaultFieldInitializer
    = fieldName:IDENTIFIER EQUAL value:Expression                                          as DefaultFieldOverride
    | fieldName:IDENTIFIER COLON typeName:TypeReference
      (LEFT_BRACE nestedEntries:DefaultNestedOverride* RIGHT_BRACE)?                       as DefaultTypeBinding
    ;

rule DefaultBlockDeclaration = DEFAULT LEFT_BRACE entries:DefaultFieldInitializer* RIGHT_BRACE;

// ─── Parser Rules — Members ─────────────────────────────────────────────────

rule FieldDeclaration = attributes:AttributeList* 
    modifiers:Modifier* 
    ownershipSpecifier:OwnershipSpecifier? 
    type:TypeReference 
    name:IDENTIFIER 
    initializer:(EQUAL Expression)? SEMICOLON
    ;

rule PropertyDeclaration
    = modifiers:Modifier* type:TypeReference name:IDENTIFIER
      LEFT_BRACE accessors:AccessorDeclaration+ RIGHT_BRACE
      initializer:(EQUAL Expression SEMICOLON)?                    as BlockProperty
    | modifiers:Modifier* type:TypeReference name:IDENTIFIER
      SUCH_THAT body:Expression SEMICOLON                          as ExpressionBodiedProperty
    ;

rule AccessorDeclaration
    = accessorModifier:Modifier? GET SEMICOLON                                    as AutoGetAccessor
    | accessorModifier:Modifier? GET body:Block                                   as BlockGetAccessor
    | accessorModifier:Modifier? GET SUCH_THAT expression:Expression SEMICOLON    as ExpressionGetAccessor
    | accessorModifier:Modifier? SET SEMICOLON                                    as AutoSetAccessor
    | accessorModifier:Modifier? SET body:Block                                   as BlockSetAccessor
    | accessorModifier:Modifier? SET SUCH_THAT expression:Expression SEMICOLON    as ExpressionSetAccessor
    | accessorModifier:Modifier? INIT SEMICOLON                                   as AutoInitAccessor
    | accessorModifier:Modifier? INIT body:Block                                  as BlockInitAccessor
    | accessorModifier:Modifier? INIT SUCH_THAT expression:Expression SEMICOLON   as ExpressionInitAccessor
    ;

rule IndexerDeclaration = modifiers:Modifier* type:TypeReference THIS
      LEFT_BRACKET parameters:ParameterList RIGHT_BRACKET
      constraints:WhereClause*
      body:IndexerBody;

rule IndexerBody
    = LEFT_BRACE accessors:AccessorDeclaration+ RIGHT_BRACE       as BlockIndexerBody
    ;

trait CallableDeclaration = 
    attributes:AttributeList* 
    modifiers:Modifier* 
    parameters:ParameterList? 
    withClauses:WithClause* 
    constraints:WhereClause* 
    body:CallableBody
    ;

rule ConstructorDeclaration : CallableDeclaration = attributes:AttributeList* modifiers:Modifier* name:IDENTIFIER LEFT_PARENTHESIS parameters:ParameterList? RIGHT_PARENTHESIS
                              withClauses:WithClause*
                              constraints:WhereClause*
                              chain:ConstructorChain? body:CallableBody;

rule ConstructorChain
    = COLON THIS LEFT_PARENTHESIS arguments:ArgumentList? RIGHT_PARENTHESIS  as ThisChain
    | COLON BASE LEFT_PARENTHESIS arguments:ArgumentList? RIGHT_PARENTHESIS  as BaseChain
    ;

rule MethodDeclaration : CallableDeclaration = attributes:AttributeList* modifiers:Modifier* returnOwnership:OwnershipSpecifier? returnType:TypeReference name:IDENTIFIER
                         typeParams:TypeParameterList?
                         LEFT_PARENTHESIS parameters:ParameterList? RIGHT_PARENTHESIS
                         withClauses:WithClause*
                         constraints:WhereClause*
                         body:CallableBody;

rule CallableBody
    = block:Block as CallableBlockBody
    | SEMICOLON   as CallableNoBody
    ;

rule OperatorDeclaration = modifiers:Modifier*
                           returnType:TypeReference
                           OPERATOR
                           symbol:OperatorSymbol
                           LEFT_PARENTHESIS parameters:ParameterList? RIGHT_PARENTHESIS
                           body:CallableBody;

rule CastOperatorDeclaration = modifiers:Modifier*
                               castKind:CastOperatorKind
                               OPERATOR
                               targetType:TypeReference
                               LEFT_PARENTHESIS parameters:ParameterList? RIGHT_PARENTHESIS
                               body:CallableBody;

rule CastOperatorKind
    = IMPLICIT as ImplicitCast
    | EXPLICIT as ExplicitCast
    ;

rule OperatorSymbol
    = PLUS                  as PlusOp
    | MINUS                 as MinusOp
    | STAR                  as StarOp
    | SLASH                 as SlashOp
    | MODULO                as ModuloOp
    | EQUAL_EQUAL           as EqualEqualOp
    | NOT_EQUAL             as NotEqualOp
    | LESS_THAN_OR_EQUAL    as LessThanOrEqualOp
    | GREATER_THAN_OR_EQUAL as GreaterThanOrEqualOp
    | LESS_THAN             as LessThanOp
    | GREATER_THAN          as GreaterThanOp
    | LOGICAL_AND           as LogicalAndOp
    | LOGICAL_OR            as LogicalOrOp
    | EXCLAMATION           as ExclamationOp
    ;

rule ParameterList = Parameter (COMMA Parameter)*;
rule Parameter = modifier:READONLY? refModifier:REF? ownershipSpecifier:OwnershipSpecifier? type:TypeReference name:(IDENTIFIER | DISCARD);

rule ArgumentList = Argument (COMMA Argument)*;
rule Argument = REF expression:Expression as RefArgument | expression:Expression as ValueArgument;

// ─── Parser Rules — Type References ─────────────────────────────────────────

rule ArrayRankSuffix
    = LEFT_BRACKET size:INTEGER_LITERAL RIGHT_BRACKET as SizedArrayRank
    | LEFT_BRACKET RIGHT_BRACKET as UnsizedArrayRank
    ;

// Element type reference for array creation expressions (new T[N]).
// Same as TypeReference but without ArrayRankSuffix to avoid ambiguity
// between `new int[3]` (create array of int with size 3) and `new int[3][...]`
// (create array of int[3] — which would be a sized array type as element).
rule ElementTypeRef
    = primitiveType:PrimitiveType as PrimitiveElementTypeRef
    | UNKNOWN as UnknownElementTypeRef
    | name:QualifiedIdentifier typeArgs:TypeArgumentList? as NamedElementTypeRef
    ;

@memo
rule TypeReference = first:SingleTypeRef (PIPE rest:SingleTypeRef)*;

rule SingleTypeRef
    = primitiveType:PrimitiveType arrayRank:ArrayRankSuffix? optional:QUESTION?  as PrimitiveSingleTypeRef
    | VOID as VoidSingleTypeRef
    | UNKNOWN as UnknownSingleTypeRef
    | name:QualifiedIdentifier typeArgs:TypeArgumentList? arrayRank:ArrayRankSuffix? optional:QUESTION? as NamedSingleTypeRef
    | LEFT_PARENTHESIS inner:TypeReference RIGHT_PARENTHESIS arrayRank:ArrayRankSuffix? as ParenthesizedTypeRef
    | LEFT_PARENTHESIS first:TupleTypeElement COMMA rest:TupleTypeElement (COMMA additional:TupleTypeElement)* RIGHT_PARENTHESIS as TupleSingleTypeRef
    | FUNC typeArgs:TypeArgumentList as FuncSingleTypeRef
    ;

rule TupleTypeElement = type:TypeReference name:IDENTIFIER?;

rule PrimitiveType
    = INT as IntType | UINT as UintType | LONG as LongType | ULONG as UlongType
    | SHORT as ShortType | USHORT as UshortType | BYTE as ByteType | SBYTE as SbyteType
    | FLOAT as FloatType | DOUBLE as DoubleType | DECIMAL as DecimalType
    | BOOL as BoolType | CHAR as CharType | STRING as StringType
    | REGEX as RegexType
    ;

// ─── Parser Rules — Statements ──────────────────────────────────────────────

rule Block = LEFT_BRACE statements:Statement* RIGHT_BRACE;

@memo
rule Statement
    = variableDeclaration:VariableDeclarationStatement   as VariableDeclarationStatement
    | returnStatement:ReturnStatement                     as ReturnStatement
    | ifStatement:IfStatement                             as IfStatement
    | whileStatement:WhileStatement                       as WhileStatement
    | forStatement:ForStatement                           as ForStatement
    | foreachStatement:ForeachStatement                   as ForeachStatement
    | breakStatement:BreakStatement                       as BreakStatement
    | readonlyBlock:ReadonlyBlockStatement                as ReadonlyBlockStatement
    | withVarDeclaration:WithVarDeclarationStatement         as WithVarDeclarationStatement
    | withTypedDeclaration:WithTypedDeclarationStatement     as WithTypedDeclarationStatement
    | withDiscardDeclaration:WithDiscardDeclarationStatement as WithDiscardDeclarationStatement
    | withPushStatement:WithPushStatement                    as WithPushStatement
    | withVarBlockStatement:WithVarBlockStatement            as WithVarBlockStatement
    | withBlockStatement:WithBlockStatement                  as WithBlockStatement
    | blockStatement:Block                                   as BlockStatement
    | expressionStatement:ExpressionStatement             as ExpressionStatement
    | uninitializedVariable:UninitializedVariableDeclaration as UninitializedVariableStatement
    ;

// Uninitialized variable declaration: `type name;` (no initializer).
// Placed after ExpressionStatement in Statement to avoid ambiguity with cast
// expression statements like `(ulong)a;` which would otherwise match as a
// parenthesized-type variable declaration.
rule UninitializedVariableDeclaration = ownershipSpecifier:OwnershipSpecifier? type:TypeReference name:IDENTIFIER SEMICOLON;

rule ReadonlyBlockStatement = READONLY body:Block;

rule VariableDeclarationStatement
    = readonlyModifier:READONLY? ownershipSpecifier:OwnershipSpecifier? type:TypeReference name:IDENTIFIER EQUAL initializer:Expression SEMICOLON  as TypedVariableDeclaration
    | readonlyModifier:READONLY? VAR LEFT_PARENTHESIS firstName:IDENTIFIER (COMMA restNames:IDENTIFIER)* RIGHT_PARENTHESIS EQUAL initializer:Expression SEMICOLON  as VarTupleDeconstruction
    | readonlyModifier:READONLY? ownershipSpecifier:OwnershipSpecifier? VAR name:(IDENTIFIER | DISCARD) EQUAL initializer:Expression SEMICOLON     as InferredVariableDeclaration
    | readonlyModifier:READONLY? LEFT_PARENTHESIS first:TupleDeconstructionElement COMMA rest:TupleDeconstructionElement (COMMA additional:TupleDeconstructionElement)* RIGHT_PARENTHESIS EQUAL initializer:Expression SEMICOLON  as TypedTupleDeconstruction
    ;

rule TupleDeconstructionElement = type:TypeReference name:IDENTIFIER;

rule ReturnStatement
    = RETURN refKeyword:REF? value:Expression? SEMICOLON
    ;

rule IfStatement
    = IF LEFT_PARENTHESIS condition:Expression RIGHT_PARENTHESIS thenBranch:Block
      elseBranch:ElseClause?
    ;

rule ElseClause
    = ELSE elseIf:IfStatement   as ElseIf
    | ELSE elseBlock:Block      as ElseBlock
    ;

rule WhileStatement = WHILE LEFT_PARENTHESIS condition:Expression RIGHT_PARENTHESIS body:Block;

rule ForStatement = FOR LEFT_PARENTHESIS initializer:ForInitializer? SEMICOLON condition:Expression? SEMICOLON iterator:Expression? RIGHT_PARENTHESIS body:Block;

rule ForInitializer
    = variableDeclaration:TypeReference name:(IDENTIFIER | DISCARD) EQUAL initializer:Expression  as ForInitializerVariableDeclaration
    | varDeclaration:VAR name:(IDENTIFIER | DISCARD) EQUAL initializer:Expression                 as ForInitializerVarDeclaration
    | expression:Expression                                                            as ForInitializerExpression
    ;

rule ForeachStatement
    = FOREACH LEFT_PARENTHESIS type:TypeReference name:(IDENTIFIER | DISCARD) IN collection:Expression RIGHT_PARENTHESIS body:Block  as TypedForeach
    | FOREACH LEFT_PARENTHESIS VAR name:(IDENTIFIER | DISCARD) IN collection:Expression RIGHT_PARENTHESIS body:Block                 as VarForeach
    ;

rule BreakStatement = BREAK SEMICOLON;

rule ExpressionStatement = expression:Expression SEMICOLON;

// ─── Parser Rules — Context Statements ──────────────────────────────────────

rule WithVarDeclarationStatement = WITH VAR name:IDENTIFIER EQUAL initializer:Expression SEMICOLON;
rule WithTypedDeclarationStatement = WITH type:TypeReference name:IDENTIFIER EQUAL initializer:Expression SEMICOLON;
rule WithDiscardDeclarationStatement = WITH type:TypeReference DISCARD EQUAL initializer:Expression SEMICOLON;
rule WithPushStatement = WITH value:Expression SEMICOLON;
rule WithBlockStatement = WITH LEFT_PARENTHESIS expression:Expression RIGHT_PARENTHESIS body:Block;
rule WithVarBlockStatement = WITH LEFT_PARENTHESIS VAR name:IDENTIFIER EQUAL initializer:Expression RIGHT_PARENTHESIS body:Block;

// ─── Parser Rules — With Clause (Method Signature Context Bindings + This-Tier) ─

rule WithClause
    = WITH tier:OwnershipSpecifier  as ThisTierWithClause
    | WITH type:TypeReference name:IDENTIFIER as ContextWithClause
    ;

// ─── Parser Rules — Expressions (Precedence Climbing) ───────────────────────
// Operator precedence is encoded structurally via a chain of rules, from
// lowest to highest binding:
//   Lambda < Assignment < VoidCoalescing < LogicalOr < LogicalAnd < Equality
//   < Relational < Additive < Multiplicative < Unary < Postfix < Primary
//
// Lambda sits at the lowest binding precedence (a peer of, but looser than,
// Assignment) so that it can appear anywhere a value is expected and binds
// looser than every operator including `=`. PEG ordered choice tries the
// LambdaExpression alternative first: it only succeeds if it matches a
// parameter list followed by SUCH_THAT (`=>`); otherwise it backtracks and
// Assignment handles the input. This is the structural analogue of how
// C#/Roslyn treats a lambda as the lowest-precedence expression form.

@memo
rule Expression
    = lambda:LambdaExpression  as LambdaForm
    | assignment:Assignment    as AssignmentForm
    ;

// The assignment RHS is a full Expression (not just Assignment) so that lambdas
// — which live above Assignment at the Expression level — are reachable from the
// RHS of an assignment, and right-associativity falls out naturally
// (`f = x => x + 1` parses as `f = (x => x + 1)`).
rule Assignment = target:VoidCoalescing (operator:(EQUAL | QUESTION_QUESTION_EQUAL) value:Expression)?;

rule VoidCoalescing = left:LogicalOr (QUESTION_QUESTION right:LogicalOr)*;

rule LogicalOr  = left:LogicalAnd (LOGICAL_OR right:LogicalAnd)*;
rule LogicalAnd = left:Equality   (LOGICAL_AND right:Equality)*;
rule Equality   = left:Relational (operator:(EQUAL_EQUAL | NOT_EQUAL) right:Relational)*;
rule Relational
    = left:Additive IS pattern:Pattern                                          as IsExpression
    | left:Additive AS targetType:TypeReference                                 as AsExpression
    | left:Additive (operator:(LESS_THAN | GREATER_THAN | LESS_THAN_OR_EQUAL
                              | GREATER_THAN_OR_EQUAL) right:Additive)*         as RelationalComparison
    ;
rule Additive   = left:Multiplicative (operator:(PLUS | MINUS) right:Multiplicative)*;
rule Multiplicative = left:Unary (operator:(STAR | SLASH | MODULO) right:Unary)*;

@memo
rule Unary
    = LEFT_PARENTHESIS targetType:TypeReference RIGHT_PARENTHESIS operand:Unary  as CastExpression
    // PostfixExpression is tried before the ASYNC/AWAIT prefix operators. An
    // async-prefixed lambda (`async x => ...`) is recognized at the Expression
    // level (via the LambdaExpression alternative, whose LambdaModifier* accepts
    // `async`), not here in Unary/Primary. Because Expression tries the
    // LambdaExpression alternative before Assignment, a leading `async`/`static`
    // followed by a lambda parameter list resolves as a lambda; non-lambda inputs
    // such as `async foo()` fail the LambdaExpression attempt and fall through to
    // Assignment, reaching the `ASYNC operand:Unary` async-functor rule below.
    | primary:Postfix              as PostfixExpression
    | ASYNC hint:IDENTIFIER body:Block                                            as AsyncHintBlockExpression
    | ASYNC body:Block                                                            as AsyncBlockExpression
    | ASYNC operand:Unary                                                         as AsyncExpression
    | AWAIT operand:Unary                                                         as AwaitExpression
    | EXCLAMATION operand:Unary    as LogicalNot
    | MINUS operand:Unary          as Negate
    ;

@memo
rule Postfix = target:Primary suffix:PostfixSuffix*;

rule PostfixSuffix
    = QUESTION_DOT name:IDENTIFIER typeArgs:TypeArgumentList? LEFT_PARENTHESIS arguments:ArgumentList? RIGHT_PARENTHESIS  as OptionalMethodCallSuffix
    | QUESTION_DOT name:IDENTIFIER                                                as OptionalMemberAccessSuffix
    | DOT name:IDENTIFIER typeArgs:TypeArgumentList? LEFT_PARENTHESIS arguments:ArgumentList? RIGHT_PARENTHESIS  as MethodCallSuffix
    | DOT name:IDENTIFIER                                                         as MemberAccessSuffix
    | LEFT_BRACKET index:Expression RIGHT_BRACKET                                 as IndexSuffix
    | LEFT_PARENTHESIS arguments:ArgumentList? RIGHT_PARENTHESIS                       as InvocationSuffix
    | SWITCH LEFT_BRACE arms:SwitchArmList? RIGHT_BRACE                           as SwitchExpressionSuffix
    ;

rule SwitchArmList = SwitchArm (COMMA SwitchArm)* COMMA?;

rule SwitchArm = pattern:Pattern guard:WhenGuard? SUCH_THAT result:Expression;

// The guard condition is bounded to VoidCoalescing (not the full Expression)
// so the arm's trailing `=>` is never consumed by a lambda/assignment inside
// the guard. This is the structural analogue of Roslyn's Precedence.Coalescing
// floor: `??` and everything tighter is permitted; lambda and assignment (which
// sit above VoidCoalescing) are excluded, leaving the `=>` for SwitchArm.
rule WhenGuard = WHEN condition:VoidCoalescing;

@memo
rule Primary
    // Lambda expressions are NOT handled here — they are recognized at the
    // Expression level (the lowest precedence tier) as a peer of Assignment, so
    // that a lambda's `=>` body binds looser than every operator and never
    // collides with a switch-arm `=>`. Primary is the highest-precedence tier
    // and contains only atomic/parenthesized forms.
    = integerLiteral:INTEGER_LITERAL                                               as IntegerLiteralExpression
    | hexLiteral:HEX_LITERAL                                                       as HexLiteralExpression
    | binaryLiteral:BINARY_LITERAL                                                 as BinaryLiteralExpression
    | floatLiteral:FLOAT_LITERAL                                                   as FloatLiteralExpression
    | stringLiteral:STRING_LITERAL                                                 as StringLiteralExpression
    | regexLiteral:REGEX_LITERAL                                                   as RegexLiteralExpression
    | interpolatedString:InterpolatedString                                        as InterpolatedStringExpression
    | charLiteral:CHAR_LITERAL                                                     as CharLiteralExpression
    | TRUE                                                                         as TrueLiteralExpression
    | FALSE                                                                        as FalseLiteralExpression
    | THIS                                                                         as ThisExpression
    | FIELD                                                                        as FieldKeywordExpression
    | NEW type:ElementTypeRef LEFT_BRACKET size:Expression RIGHT_BRACKET            as ArrayCreationExpression
    | STACKALLOC type:ElementTypeRef LEFT_BRACKET size:Expression RIGHT_BRACKET     as StackallocExpression
    | NEW type:QualifiedIdentifier typeArgs:TypeArgumentList? LEFT_PARENTHESIS arguments:ArgumentList? RIGHT_PARENTHESIS initializer:PropertyInitializerBlock? as ObjectCreationExpression
    | NEW type:QualifiedIdentifier typeArgs:TypeArgumentList? initializer:PropertyInitializerBlock as ObjectCreationExpressionNoArgs
    | NEW LEFT_PARENTHESIS arguments:ArgumentList? RIGHT_PARENTHESIS initializer:PropertyInitializerBlock? as TargetTypedNewExpression
    | NEW LEFT_BRACE properties:AnonymousPropertyList RIGHT_BRACE as AnonymousTypeExpression
    | NEW initializer:PropertyInitializerBlock as TargetTypedNewExpressionNoArgs
    | LEFT_PARENTHESIS first:TupleLiteralElement COMMA rest:TupleLiteralElement (COMMA additional:TupleLiteralElement)* RIGHT_PARENTHESIS as TupleLiteralExpression
    | LEFT_PARENTHESIS inner:Expression RIGHT_PARENTHESIS                          as ParenthesizedExpression
    | DEFAULT LEFT_PARENTHESIS type:TypeReference RIGHT_PARENTHESIS               as DefaultExpression
    | DEFAULT                                                                      as DefaultLiteralExpression
    | LEFT_BRACKET RIGHT_BRACKET                                                    as EmptyArrayLiteralExpression
    | LEFT_BRACKET first:Expression (COMMA rest:Expression)* COMMA? RIGHT_BRACKET  as ArrayLiteralExpression
    | name:IDENTIFIER                                                              as IdentifierExpression
    | typeRef:TypeReference                                                        as TypeLiteralExpression
    ;

rule TupleLiteralElement
    = name:IDENTIFIER COLON value:Expression  as NamedTupleLiteralElement
    | value:Expression                         as UnnamedTupleLiteralElement
    ;

// ─── Parser Rules — Lambda Expressions ──────────────────────────────────────
// Lambdas reuse the existing SUCH_THAT (`=>`) token. The block-bodied
// alternative is tried before the expression-bodied one so that a brace-led
// body (`{ ... }`) is parsed as a Block rather than failing through Expression.

rule LambdaExpression
    = modifiers:LambdaModifier* params:LambdaParameterList SUCH_THAT body:Block       as BlockLambda
    | modifiers:LambdaModifier* params:LambdaParameterList SUCH_THAT body:Expression   as ExpressionLambda
    ;

rule LambdaModifier
    = STATIC as StaticLambdaModifier
    | ASYNC  as AsyncLambdaModifier
    ;

rule LambdaParameterList
    = LEFT_PARENTHESIS params:LambdaParamList? RIGHT_PARENTHESIS  as ParenthesizedLambdaParams
    | name:IDENTIFIER                                              as SingleImplicitParam
    ;

rule LambdaParamList = LambdaParam (COMMA LambdaParam)*;

rule LambdaParam
    = type:TypeReference name:IDENTIFIER  as TypedLambdaParam
    | name:IDENTIFIER                      as UntypedLambdaParam
    ;

rule InterpolatedString = INTERPOLATED_STRING_START parts:InterpolatedPart* INTERPOLATED_STRING_END;

rule InterpolatedPart
    = text:INTERPOLATED_STRING_TEXT  as TextPart
    | INTERPOLATION_OPEN expression:Expression RIGHT_BRACE      as ExpressionPart
    ;

// ─── Parser Rules — Anonymous Type Properties ───────────────────────────────

rule AnonymousPropertyList = AnonymousProperty (COMMA AnonymousProperty)* COMMA?;

rule AnonymousProperty
    = name:IDENTIFIER EQUAL value:Expression   as ExplicitAnonymousProperty
    | projection:Postfix                        as ProjectedAnonymousProperty
    ;

// ─── Parser Rules — Property Initializers ───────────────────────────────────

rule PropertyInitializerBlock = LEFT_BRACE assignments:PropertyAssignmentList? RIGHT_BRACE;

rule PropertyAssignmentList = PropertyAssignment (COMMA PropertyAssignment)* COMMA?;

rule PropertyAssignment
    = name:IDENTIFIER EQUAL value:Expression   as NamedPropertyAssignment
    | value:Expression                          as CollectionElementAssignment
    ;

// ─── Parser Rules — Patterns ────────────────────────────────────────────────
// Pattern grammar for `is` expressions. Precedence: or < and < not < primary.

rule Pattern = OrPattern;

rule OrPattern = left:AndPattern (OR right:AndPattern)*;

rule AndPattern = left:UnaryPattern (AND right:UnaryPattern)*;

rule UnaryPattern
    = NOT operand:PrimaryPattern   as NotPattern
    | primary:PrimaryPattern       as DirectPattern
    ;

rule PrimaryPattern
    = type:TypeReference name:(IDENTIFIER | DISCARD)                         as TypePattern
    | LEFT_PARENTHESIS first:Pattern COMMA rest:Pattern (COMMA additional:Pattern)* RIGHT_PARENTHESIS  as TuplePositionalPattern
    | LEFT_PARENTHESIS inner:Pattern RIGHT_PARENTHESIS                      as ParenthesizedPattern
    | type:TypeReference                                                    as BareTypePattern
    | VAR name:(IDENTIFIER | DISCARD)                                       as VarPattern
    | DISCARD                                                               as DiscardPattern
    | LESS_THAN constant:VoidCoalescing                                     as LessThanRelationalPattern
    | GREATER_THAN constant:VoidCoalescing                                  as GreaterThanRelationalPattern
    | LESS_THAN_OR_EQUAL constant:VoidCoalescing                            as LessThanOrEqualRelationalPattern
    | GREATER_THAN_OR_EQUAL constant:VoidCoalescing                         as GreaterThanOrEqualRelationalPattern
    | typeName:QualifiedIdentifier? LEFT_BRACE subpatterns:PropertySubpatternList? RIGHT_BRACE name:(IDENTIFIER | DISCARD)?  as PropertyPattern
    | LEFT_BRACKET elements:ListPatternElementList? RIGHT_BRACKET           as ListPattern
    | literal:ConstantLiteral                                               as ConstantPattern
    ;

rule ConstantLiteral
    = value:INTEGER_LITERAL   as IntegerConstant
    | value:FLOAT_LITERAL     as FloatConstant
    | value:STRING_LITERAL    as StringConstant
    | value:CHAR_LITERAL      as CharConstant
    | value:REGEX_LITERAL     as RegexConstant
    | TRUE                    as TrueConstant
    | FALSE                   as FalseConstant
    ;

rule PropertySubpatternList = PropertySubpattern (COMMA PropertySubpattern)*;

rule PropertySubpattern = name:IDENTIFIER COLON pattern:Pattern;

rule ListPatternElementList = ListPatternElement (COMMA ListPatternElement)*;

rule ListPatternElement
    = pattern:Pattern                          as PatternElement
    | DOTDOT name:(IDENTIFIER | DISCARD)?      as SliceElement
    ;
