using Standard;

namespace Refusal;

public class Probe
{
    public static int First(int[] xs, int[] replacement)
    {
        if(xs.Length != 0)
        {
            xs = replacement;
            // REFUSE: MIST_PA_INDEX_UNPROVEN
            return xs[0];
        }

        return 0;
    }

    public static void Main()
    {
        Console.WriteLine(First([1], new int[0]));
    }
}
