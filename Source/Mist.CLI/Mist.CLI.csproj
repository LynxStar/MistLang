<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>mist</AssemblyName>
    <PackageId>Mist.CLI</PackageId>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mist\Mist.csproj" />
  </ItemGroup>

  <!--
    Package the Mist Standard Library alongside the compiler binary so that
    StdlibLoader.LoadFor can resolve AppContext.BaseDirectory/Standard/ at
    runtime. CopyToOutputDirectory ensures `dotnet build` (used by the test
    suite) produces the layout too; CopyToPublishDirectory ensures
    `dotnet publish` ships the files in production builds (Requirement 15.5).
    TargetPath mirrors the source tree structure under a `Standard/` prefix.
  -->
  <ItemGroup>
    <Content Include="..\..\Source\Standard\**\*.mist"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true"
             TargetPath="Standard\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    Package the distributable Mist steering files alongside the compiler binary
    so that `mist steering` can resolve AppContext.BaseDirectory/Steering/ at
    runtime and install them into a project's .kiro/steering/ directory.
    Mirrors the Standard Library bundling above.
  -->
  <ItemGroup>
    <Content Include="..\..\distribute\steering\mist-*.md"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true"
             TargetPath="Steering\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
