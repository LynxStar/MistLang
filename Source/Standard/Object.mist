// Universal extension methods available on all types.
// These provide the base object operations (ToString, GetHashCode)
// that every value in Mist can call. The method bodies are placeholders —
// actual behavior comes from the .NET runtime when the code is transpiled.
// Requirements: 23.1, 23.2

extension(unknown self) {
    string ToString() {
        return "";
    }

    int GetHashCode() {
        return 0;
    }
}
