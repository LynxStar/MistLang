// StructuredContext — Demonstrates structured context features in Mist.
//
// This sample showcases:
//   1. with var x = expr (inferred type context declaration with local binding)
//   2. with TypeReference x = expr (explicit type context declaration with local binding)
//   3. with TypeReference _ = expr (explicit type context declaration without local binding)
//   4. with expr (push-only context declaration)
//   5. with(expr) { ... } (scoped context block)
//   6. Context propagation through transparent intermediate methods
//   7. Context shadowing and restoration
//   8. Multiple with-clauses on a single method
//   9. Explicit type annotation for variance control
//  10. Multiple same-type pushes in a single scope
//  11. Generic types as independent context keys
//  12. Constructor with-clause
//  13. Class, struct, abstract type-satisfying, and abstract type-implementing types as context values
//  14. Type alias, union type, refinement type, and dependent type as context keys
//  15. Abstract type method dispatch with with-clause
//  16. Abstract type structural dispatch with with-clause
//  17. Optional-reference/value and nested tuple/callable key independence
//  18. Extension method and abstract/concrete default body entry
//  19. Generic context keys: optional and required keys erased behind a type parameter

using Standard;

namespace StructuredContext;

// ─── Supporting types ────────────────────────────────────────────────────────

// Simple class for context values
public class Config
{
    public string Value;

    public Config(string value)
    {
        this.Value = value;
    }
}

// Derived class for variance control demonstration
public class DetailedConfig : Config
{
    public int Level;

    public DetailedConfig(string value, int level) : base(value)
    {
        this.Level = level;
    }
}

// Struct for context values
public struct Locale
{
    public string Language;

    public Locale(string language)
    {
        this.Language = language;
    }
}

// Wrapper classes for independent context keys (demonstrates the concept
// that different types are independent keys, analogous to generic type args)
public class IntHolder
{
    public int Item;

    public IntHolder(int item)
    {
        this.Item = item;
    }
}

public class StringHolder
{
    public string Item;

    public StringHolder(string item)
    {
        this.Item = item;
    }
}

public class Holder<T>
{
    public T Item;
    public Holder(T item) { this.Item = item; }
}

public abstract DefaultReader
{
    string Read() with string text { return text; }
}

public class DefaultReaderImpl : DefaultReader { }

extension (string self)
{
    public string WithCount() with int count { return $"{self}:{count}"; }
}

// Abstract type with with-clause on method
public abstract IContextConsumer
{
    string Consume() with Config cfg;
}

// Class implementing IContextConsumer
public class ConsumerImpl : IContextConsumer
{
    public string Consume() with Config cfg
    {
        return $"ConsumerImpl.Consume: cfg={cfg.Value}";
    }
}

// Abstract type with with-clause on method
public abstract ContextReader
{
    string ReadContext() with int count;
}

// Class implementing ContextReader (nominal conformance)
public class CountReader : ContextReader
{
    public string ReadContext() with int count
    {
        return $"CountReader.ReadContext: count={count}";
    }
}

// Type alias (resolves to underlying type for keying — shares key with string)
type Name = string;

// Union type (distinct key from constituents)
type IntOrBool = int | bool;

// Refinement type (resolves to base type for keying — shares key with int)
type PositiveInt = int >= 1;

// Dependent type class
public class Sized<N:int>
{
    public int GetSize() { return N; }
}

// Class with constructor that has a with-clause
public class Greeter
{
    public string Greeting;

    public Greeter() with string message
    {
        this.Greeting = $"Hello, {message}";
    }
}

// ─── Context consumer methods ────────────────────────────────────────────────

public class Consumers
{
    // Consumes string context
    public static string GetString() with string s
    {
        return s;
    }

    public static string? GetOptionalString() with string? s { return s; }
    public static int? GetOptionalInt() with int? n { return n; }
    public static T GetGeneric<T>() with Holder<T> h { return h.Item; }
    public static string GetNestedTuple() with ((string, int), bool) t { return t.Item1.Item1; }
    public static string? GetOptionalNestedTuple() with ((string?, int), bool) t { return t.Item1.Item1; }
    public static string GetFunction() with func<string> f { return f(); }
    public static string? GetOptionalFunction() with func<string?> f { return f(); }

    // Consumes int context
    public static int GetInt() with int n
    {
        return n;
    }

    // Consumes Config context (class type)
    public static string GetConfig() with Config cfg
    {
        return cfg.Value;
    }

    // Consumes Locale context (struct type)
    public static string GetLocale() with Locale loc
    {
        return loc.Language;
    }

    // Multiple with-clauses: consumes both string and int
    public static string GetBoth() with string s with int n
    {
        return $"s={s}, n={n}";
    }

    // Consumes IntHolder context
    public static int GetHolderInt() with IntHolder h
    {
        return h.Item;
    }

    // Consumes StringHolder context
    public static string GetHolderString() with StringHolder h
    {
        return h.Item;
    }

    // Consumes CountReader context (abstract type-implementing type)
    public static string GetCountReader() with CountReader r
    {
        return $"CountReader(ReadContext with 0 would be: ready)";
    }

    // Consumes ConsumerImpl context (abstract type-implementing type)
    public static string GetConsumerImpl() with ConsumerImpl c
    {
        return $"ConsumerImpl(ready)";
    }

    // Consumes Sized<5> context (dependent type)
    public static int GetSized() with Sized<5> s
    {
        return s.GetSize();
    }
}

// ─── Intermediate methods that propagate context ─────────────────────────────

public class Intermediary
{
    // This method binds context and passes it through to the consumer.
    // It demonstrates that context propagates through the call chain.
    public static string CallGetString() with string s
    {
        // s is available here but we just forward to the consumer
        return Consumers.GetString();
    }

    // Two levels of propagation
    public static string CallCallGetString() with string s
    {
        return Intermediary.CallGetString();
    }
}

// ─── Generic context keys (section 19) ───────────────────────────────────────

public class Generics
{
    public static T Get<T>() with T value { return value; }

    public static T Outer<T>() with T value { return Get<T>(); }

    public static T Shadow<T>(T replacement) with T value { with replacement; return Get<T>(); }
}

public class Keyed<T>
{
    public T Seeded;

    public Keyed() with T value { Seeded = value; }

    public T Read() with T value { return value; }
}

public class KeyHolder<T>
{
    public T Item;

    public KeyHolder(T item) { Item = item; }
}

<T> extension(KeyHolder<T> self)
{
    public T Ambient() with T value { return value; }
}

public abstract KeyReader { T Get<T>() with T value; }

public class OpenKeyReader : KeyReader
{
    public T Get<T>() with T value { return value; }
}

public abstract OptionalReader<T> { T Read() with T value; }

public class ClosedOptionalReader : OptionalReader<string?>
{
    public string? Read() with string? value { return value; }
}

// ─── Entry point ─────────────────────────────────────────────────────────────

public class Program
{
    public static void Main(string[] args)
    {
        RunDemo();
    }

    public static void RunDemo()
    {
        Console.WriteLine("=== Structured Context Sample ===");

        // ─── 1. with var x = expr (inferred type, local binding) ─────────
        Console.WriteLine("--- 1. with var x = expr ---");
        with var greeting = "hello";
        Console.WriteLine($"  greeting={greeting}");
        var result1 = Consumers.GetString();
        Console.WriteLine($"  GetString()={result1}");

        // ─── 2. with TypeReference x = expr (explicit type, local binding) ───
        Console.WriteLine("--- 2. with Type x = expr ---");
        with int count = 42;
        Console.WriteLine($"  count={count}");
        var result2 = Consumers.GetInt();
        Console.WriteLine($"  GetInt()={result2}");

        // ─── 3. with TypeReference _ = expr (explicit type, no local binding) ─
        Console.WriteLine("--- 3. with Type _ = expr ---");
        with Config _ = new Config("from-discard");
        var result3 = Consumers.GetConfig();
        Console.WriteLine($"  GetConfig()={result3}");

        // ─── 4. with expr (push-only, no local binding) ─────────────────
        Console.WriteLine("--- 4. with expr ---");
        with new Locale("en-US");
        var result4 = Consumers.GetLocale();
        Console.WriteLine($"  GetLocale()={result4}");

        // ─── 5. with(expr) { ... } (scoped context block) ───────────────
        Console.WriteLine("--- 5. with(expr) { ... } ---");
        with("scoped-value")
        {
            var inner = Consumers.GetString();
            Console.WriteLine($"  inside block: GetString()={inner}");
        }
        // After block exits, original string context ("hello") is restored
        var afterBlock = Consumers.GetString();
        Console.WriteLine($"  after block: GetString()={afterBlock}");

        // ─── 6. Context propagation through call chain ────────────────────
        Console.WriteLine("--- 6. Propagation through call chain ---");
        var prop1 = Intermediary.CallGetString();
        Console.WriteLine($"  CallGetString()={prop1}");
        var prop2 = Intermediary.CallCallGetString();
        Console.WriteLine($"  CallCallGetString()={prop2}");

        // ─── 7. Shadowing and restoration ────────────────────────────────
        Console.WriteLine("--- 7. Shadowing and restoration ---");
        Console.WriteLine($"  before shadow: GetInt()={Consumers.GetInt()}");
        with(99)
        {
            Console.WriteLine($"  inside shadow: GetInt()={Consumers.GetInt()}");
        }
        Console.WriteLine($"  after restore: GetInt()={Consumers.GetInt()}");

        // ─── 8. Multiple with-clauses on a single method ────────────────
        Console.WriteLine("--- 8. Multiple with-clauses ---");
        var both = Consumers.GetBoth();
        Console.WriteLine($"  GetBoth()={both}");

        // ─── 9. Explicit type annotation for variance control ────────────
        Console.WriteLine("--- 9. Variance control ---");
        // Push a DetailedConfig but key it as Config (base type) using explicit annotation.
        // This demonstrates that the declared type controls the context key.
        Config asBase = new DetailedConfig("detailed", 5);
        with asBase;
        var variance = Consumers.GetConfig();
        Console.WriteLine($"  GetConfig() with DetailedConfig as Config={variance}");

        // ─── 10. Multiple same-type pushes in a single scope ─────────────
        Console.WriteLine("--- 10. Multiple same-type pushes ---");
        with(200)
        {
            Console.WriteLine($"  after first push: GetInt()={Consumers.GetInt()}");
            with(300)
            {
                Console.WriteLine($"  after second push: GetInt()={Consumers.GetInt()}");
            }
            Console.WriteLine($"  after inner pop: GetInt()={Consumers.GetInt()}");
        }

        // ─── 11. Generic types as independent context keys ───────────────
        Console.WriteLine("--- 11. Independent type keys ---");
        with var intHolder = new IntHolder(10);
        with var strHolder = new StringHolder("generic");
        var gi = Consumers.GetHolderInt();
        var gs = Consumers.GetHolderString();
        Console.WriteLine($"  GetHolderInt()={gi}");
        Console.WriteLine($"  GetHolderString()={gs}");
        with new Holder<int>(11);
        with new Holder<string>("closed-generic");
        Console.WriteLine($"  Holder<int>={Consumers.GetGeneric<int>()}");
        Console.WriteLine($"  Holder<string>={Consumers.GetGeneric<string>()}");

        // ─── 12. Constructor with-clause ─────────────────────────────────
        Console.WriteLine("--- 12. Constructor with-clause ---");
        with("world");
        var greeter = new Greeter();
        Console.WriteLine($"  Greeter.Greeting={greeter.Greeting}");

        // ─── 13. Class, struct, abstract type-implementing types as context values ─
        Console.WriteLine("--- 13. Various types as context values ---");
        // Class (Config) — already demonstrated above, consumed by GetConfig()
        Console.WriteLine($"  class (Config): GetConfig()={Consumers.GetConfig()}");
        // Struct (Locale) — already demonstrated above, consumed by GetLocale()
        Console.WriteLine($"  struct (Locale): GetLocale()={Consumers.GetLocale()}");
        // Abstract type-implementing type: CountReader implements ContextReader
        with var reader = new CountReader();
        var readerResult = Consumers.GetCountReader();
        Console.WriteLine($"  abstract type-implementing (CountReader): {readerResult}");
        // Abstract type-implementing type: ConsumerImpl implements IContextConsumer
        with var consumer = new ConsumerImpl();
        var consumerResult = Consumers.GetConsumerImpl();
        Console.WriteLine($"  abstract type-implementing (ConsumerImpl): {consumerResult}");

        // ─── 14. Type alias, union type, refinement type, dependent type as keys ─
        Console.WriteLine("--- 14. Advanced type keys ---");

        // Type alias: Name = string, shares key with string (alias resolves through)
        // Pushing via Name-typed variable satisfies string consumers
        Name aliasVal = "via-alias";
        with(aliasVal)
        {
            var aliasResult = Consumers.GetString();
            Console.WriteLine($"  type alias (Name=string): GetString()={aliasResult}");
        }

        // Union type: IntOrBool is a distinct key from int and bool
        // Pushing IntOrBool does NOT shadow the int context
        IntOrBool unionVal = 777;
        with(unionVal)
        {
            // int context is still 42 (from section 2), not 777
            var intResult = Consumers.GetInt();
            Console.WriteLine($"  union type (IntOrBool): GetInt()={intResult} (proves distinct key)");
        }

        // Refinement type: PositiveInt resolves to int for keying
        // Pushing PositiveInt DOES shadow the int context
        PositiveInt posVal = 5;
        with(posVal)
        {
            var posResult = Consumers.GetInt();
            Console.WriteLine($"  refinement type (PositiveInt=int>=1): GetInt()={posResult} (shares int key)");
        }
        // After pop, int context is restored
        Console.WriteLine($"  after refinement pop: GetInt()={Consumers.GetInt()}");

        // Dependent type: Sized<5> as context key
        with var sized = new Sized<5>();
        var sizedResult = Consumers.GetSized();
        Console.WriteLine($"  dependent type (Sized<5>): GetSized()={sizedResult}");

        // ─── 15. Abstract type method dispatch with with-clause ──────────────
        Console.WriteLine("--- 15. Abstract type dispatch with with-clause ---");
        IContextConsumer iface = new ConsumerImpl();
        var ifaceResult = iface.Consume();
        Console.WriteLine($"  IContextConsumer.Consume()={ifaceResult}");

        // ─── 16. Abstract type dispatch with with-clause ──────────────
        Console.WriteLine("--- 16. Abstract type dispatch with with-clause ---");
        with 7;
        ContextReader ctxReaderVar = new CountReader();
        var ctxReaderResult = ctxReaderVar.ReadContext();
        Console.WriteLine($"  ContextReader.ReadContext()={ctxReaderResult}");

        Console.WriteLine("--- 17. Optional and nested type keys ---");
        string? absent = void;
        with(absent)
        {
            Console.WriteLine($"  string under absent string?={Consumers.GetString()}");
            Console.WriteLine($"  string?={Consumers.GetOptionalString() ?? "absent"}");
            string? present = "optional-inner";
            with(present)
            {
                Console.WriteLine($"  shadowed string?={Consumers.GetOptionalString()}");
                Console.WriteLine($"  string stays={Consumers.GetString()}");
            }
            Console.WriteLine($"  restored string?={Consumers.GetOptionalString() ?? "absent"}");
        }
        Console.WriteLine($"  string after optional pop={Consumers.GetString()}");
        int? missingNumber = void;
        with(missingNumber)
        {
            Console.WriteLine($"  int under absent int?={Consumers.GetInt()}");
            Console.WriteLine($"  int? fallback={Consumers.GetOptionalInt() ?? -1}");
        }
        ((string, int), bool) tuple = (("tuple-outer", 1), true);
        with(tuple)
        {
            ((string?, int), bool) optionalTuple = ((absent, 2), false);
            with(optionalTuple)
            {
                Console.WriteLine($"  nested tuple={Consumers.GetNestedTuple()}");
                Console.WriteLine($"  optional nested tuple={Consumers.GetOptionalNestedTuple() ?? "absent"}");
            }
        }
        func<string> textFunction = () => "function-outer";
        with(textFunction)
        {
            func<string?> optionalFunction = () => void;
            with(optionalFunction)
            {
                Console.WriteLine($"  function={Consumers.GetFunction()}");
                Console.WriteLine($"  optional-result function={Consumers.GetOptionalFunction() ?? "absent"}");
            }
        }

        Console.WriteLine("--- 18. Extension and default body entry ---");
        Console.WriteLine($"  extension={"x".WithCount()}");
        var concreteDefault = new DefaultReaderImpl();
        DefaultReader abstractDefault = concreteDefault;
        Console.WriteLine($"  abstract default={abstractDefault.Read()}");
        Console.WriteLine($"  concrete default={concreteDefault.Read()}");

        Console.WriteLine("--- 19. Generic context keys ---");
        string? optionalKey = "generic-optional";
        with optionalKey;
        with "generic-required";
        Console.WriteLine($"  Get<string?>={Generics.Get<string?>()}");
        Console.WriteLine($"  Get<string>={Generics.Get<string>()}");
        Console.WriteLine($"  Outer<string?>={Generics.Outer<string?>()}");
        Console.WriteLine($"  Shadow<string?>={Generics.Shadow<string?>("generic-shadow")}");
        Console.WriteLine($"  restored Get<string?>={Generics.Get<string?>()}");
        Console.WriteLine($"  Keyed<string?>.Read()={new Keyed<string?>().Read()}");
        Console.WriteLine($"  Keyed<string>.Seeded={new Keyed<string>().Seeded}");
        Console.WriteLine($"  extension Ambient<string?>={new KeyHolder<string?>("holder").Ambient()}");
        func<string?> reference = Generics.Get<string?>;
        Console.WriteLine($"  reference={reference()}");
        KeyReader keyReader = new OpenKeyReader();
        Console.WriteLine($"  abstract Get<string?>={keyReader.Get<string?>()} Get<string>={keyReader.Get<string>()}");
        OptionalReader<string?> optionalReader = new ClosedOptionalReader();
        Console.WriteLine($"  closed answer Read()={optionalReader.Read()}");
        int? optionalNumber = 21;
        with optionalNumber;
        with 42;
        Console.WriteLine($"  Get<int?>={Generics.Get<int?>()} Get<int>={Generics.Get<int>()}");

        Console.WriteLine("=== Structured Context Done ===");
    }
}
