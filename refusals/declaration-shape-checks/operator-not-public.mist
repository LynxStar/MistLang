using Standard;

namespace Refusal;

public struct Meters
{
    public int Value;

    public Meters(int value)
    {
        Value = value;
    }

    // REFUSE: MIST_PA_OPERATOR_NOT_PUBLIC
    private static Meters operator +(Meters a, Meters b)
    {
        return new Meters(a.Value + b.Value);
    }
}

public class Probe
{
    public static void Main()
    {
        var m = new Meters(1);
        Console.WriteLine("unreachable");
    }
}
