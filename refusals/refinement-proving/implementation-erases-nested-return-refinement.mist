using Standard;

namespace Refusal;

type Positive = int > 0;
public class Box<T>
{
    public T Value { get; set; }
    public Box(T value) { Value = value; }
}
public abstract IFactory { Box<Positive> Make(); }
public class Factory : IFactory
{
    // REFUSE: MIST_PA_REFINEMENT_RETURN_UNPROVEN
    public Box<int> Make() { return new Box<int>(-1); }
}

public class Probe { public static void Main() { } }
