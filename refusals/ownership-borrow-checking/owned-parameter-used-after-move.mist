using Standard;

namespace Refusal;

public owned class Engine
{
    public int Rpm;

    public Engine(int rpm)
    {
        this.Rpm = rpm;
    }

    public void Rev(int by)
    {
        this.Rpm = this.Rpm + by;
    }

    public int Get()
    {
        return Rpm;
    }
}

public class Probe
{
    public static void Consume(owned Engine e)
    {
        Console.WriteLine(e.Get());
    }

    public static void Twice(owned Engine e)
    {
        Consume(e);
        // REFUSE: MIST_PA_USE_AFTER_MOVE
        Console.WriteLine(e.Get());
    }

    public static void Main()
    {
        Twice(new Engine(1));
        Console.WriteLine("unreachable");
    }
}
