// RazorComponents -- the razor-components fixture banked as a sample (Requirement 13.6): the C# backend
// translates Components/*.razor into Mist ComponentBase subclasses, and HtmlRenderer renders Counter,
// with Greeting nested under it, to the HTML a C# Blazor component of the same markup renders.
// V2-ONLY: written after classic was retired; its lines were captured from v2 and read against the
// components by hand.

using System;
using Standard;
using Microsoft.AspNetCore.Components.Web;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Logging;
using RazorComponents.Components;

namespace RazorComponents;

public class Program
{
    public static void RunDemo()
    {
        Console.WriteLine("=== Razor Components ===");

        var services = new ServiceCollection();
        services.AddLogging();
        var provider = services.BuildServiceProvider();
        var renderer = new HtmlRenderer(provider, provider.GetRequiredService<ILoggerFactory>());
        var html = await renderer.Dispatcher.InvokeAsync(async () =>
        {
            var output = await renderer.RenderComponentAsync<Counter>();
            return output.ToHtmlString();
        });
        Console.WriteLine(html);

        Console.WriteLine("=== Razor Components Done ===");
    }

    public static void Main(string[] args)
    {
        RunDemo();
    }
}
