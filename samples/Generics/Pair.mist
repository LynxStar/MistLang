// Pair<T, U> — Demonstrates a generic class with multiple type parameters.

using System;

namespace Generics;

public class Pair<T, U>
{
    private T first;
    private U second;

    public Pair(T first, U second)
    {
        this.first = first;
        this.second = second;
    }

    public T GetFirst()
    {
        return first;
    }

    public U GetSecond()
    {
        return second;
    }

    public string Describe()
    {
        return $"Pair({first}, {second})";
    }
}
