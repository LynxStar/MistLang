namespace Standard;

intrinsic public readonly owned struct UInt16 : IClonable<UInt16>
{
    // IClonable base case — value-type identity copy (Requirement 8.6)
    intrinsic public pure owned UInt16 Clone();

    // Binary arithmetic operators — Requirement 3.1
    intrinsic public pure static UInt16 operator +(UInt16 a, UInt16 b);
    intrinsic public pure static UInt16 operator -(UInt16 a, UInt16 b);
    intrinsic public pure static UInt16 operator *(UInt16 a, UInt16 b);
    intrinsic public pure static UInt16 operator /(UInt16 a, UInt16 b);
    intrinsic public pure static UInt16 operator %(UInt16 a, UInt16 b);

    // Comparison operators — Requirement 3.2
    intrinsic public pure static Boolean operator <(UInt16 a, UInt16 b);
    intrinsic public pure static Boolean operator >(UInt16 a, UInt16 b);
    intrinsic public pure static Boolean operator <=(UInt16 a, UInt16 b);
    intrinsic public pure static Boolean operator >=(UInt16 a, UInt16 b);
    intrinsic public pure static Boolean operator ==(UInt16 a, UInt16 b);
    intrinsic public pure static Boolean operator !=(UInt16 a, UInt16 b);

    // No unary '-' on unsigned types — Requirement 3.4.

    // Implicit widening conversions
    intrinsic public pure static implicit operator Int32(UInt16 value);
    intrinsic public pure static implicit operator UInt32(UInt16 value);
    intrinsic public pure static implicit operator Int64(UInt16 value);
    intrinsic public pure static implicit operator UInt64(UInt16 value);
    intrinsic public pure static implicit operator Single(UInt16 value);
    intrinsic public pure static implicit operator Double(UInt16 value);
    intrinsic public pure static implicit operator Decimal(UInt16 value);
}
